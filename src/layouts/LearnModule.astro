---
import Base from './Base.astro';
import { modules, moduleText, categoryText } from '../data/learn';
import { url, localized } from '../i18n/utils';
interface Props { slug: string; description: string; lang?: 'en' | 'es' }
const { slug, description, lang = 'en' } = Astro.props;
const es = lang === 'es';
const m0 = modules.find((x) => x.slug === slug)!;
const mt = moduleText(m0, lang);
const m = { ...m0, ...mt };
const cat = categoryText(m0.category, lang);
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: m.title,
  description,
  educationalLevel: 'Undergraduate / early graduate',
  learningResourceType: 'Interactive simulation',
  inLanguage: lang,
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: 'Mijail Littin' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
}];
---
<Base title={m.title} description={description} math jsonld={jsonld} ogType="article">
  <header class="page-head frame">
    <p class="eyebrow"><a href={localized('/learn/', lang)}>{es ? 'Aprender' : 'Learn'}</a> · {cat.title}</p>
    <h1 class="lm-title">{m.title}</h1>
    <p class="lede abstract">{m.question}</p>
    <p class="meta lm-meta">{es ? `Unos ${m.minutes} minutos · se ejecuta en el navegador · CC BY 4.0` : `About ${m.minutes} minutes · runs in the browser · CC BY 4.0`}</p>
  </header>
  <article class="frame lm">
    <slot />
    {m.related && m.related.length > 0 && (
      <aside class="lm-related">
        <p class="label">{es ? 'Material relacionado' : 'Connected material'}</p>
        <ul class="links">{m.related.map((r) => <li><a href={r.href.startsWith('/') ? localized(r.href, lang) : r.href}>{r.label}</a></li>)}</ul>
      </aside>
    )}
  </article>
</Base>

<style>
  .lm-title { max-width: 26ch; }
  .lm-meta { margin-top: var(--s-3); }
  .lm { padding-top: var(--s-6); }
  .lm :global(.prose) { margin-inline: 0; }
  .lm :global(.try) { margin-block: var(--s-5); max-width: var(--measure); }
  .lm :global(.try h3) { font-size: var(--step-1); font-weight: 700; }
  .lm :global(.try ol) { padding-left: 1.2em; margin-top: var(--s-2); }
  .lm :global(.try li + li) { margin-top: var(--s-2); }
  .lm :global(.plot-key) { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.15rem 1rem; margin-top: 0.2rem; font-size: var(--step--2); color: var(--ink-2); }
  .lm :global(.plot-key span) { display: inline-flex; align-items: center; gap: 0.35rem; white-space: nowrap; }
  .lm :global(.plot-key svg) { width: 18px; height: 10px; overflow: visible; }
  .lm-related { margin-top: var(--s-8); border-top: 1px solid var(--rule); padding-top: var(--s-4); }
</style>
