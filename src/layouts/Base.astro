---
import '../styles/global.css';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { t } from '../i18n/ui';
import { langFromPath, routeKey, hasTranslation, url } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Load KaTeX stylesheet (pages with mathematics). */
  math?: boolean;
  /** Absolute or site-relative image for OpenGraph. */
  image?: string;
  /** Extra JSON-LD objects. */
  jsonld?: Record<string, unknown>[];
  /** Hide header/footer (e.g. slide decks). */
  bare?: boolean;
  noindex?: boolean;
  ogType?: string;
}

const {
  title,
  description,
  math = false,
  image = '/og-default.png',
  jsonld = [],
  bare = false,
  noindex = false,
  ogType = 'website',
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · ${lang === 'es' ? 'Problemas inversos y aprendizaje automático científico' : 'Inverse problems and scientific machine learning'}`;
const desc = description ?? t(lang, 'site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const key = routeKey(Astro.url.pathname);
const translated = hasTranslation(key);
const enHref = new URL(url(key), Astro.site).href;
const esHref = new URL(url(`/es${key}`), Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mijail Littin',
  honorificSuffix: 'PhD',
  url: new URL(url('/'), Astro.site).href,
  sameAs: ['https://orcid.org/0000-0002-5577-5060'],
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: '0000-0002-5577-5060' },
  jobTitle: lang === 'es' ? 'Profesor de cátedra' : 'Adjunct Instructor',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Universidad Técnica Federico Santa María' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'INSA Rouen Normandie' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Técnica Federico Santa María' },
  ],
  knowsAbout: ['Inverse problems', 'Scientific machine learning', 'Physics-informed neural networks', 'Optical diagnostics', 'Thermal radiation'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {translated && <link rel="alternate" hreflang="en" href={enHref} />}
    {translated && <link rel="alternate" hreflang="es" href={esHref} />}
    {translated && <link rel="alternate" hreflang="x-default" href={enHref} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Mijail Littin" />
    <meta name="theme-color" content="#fefefe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Mijail Littin" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify([personLd, ...jsonld])} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Theme: respect OS preference; an explicit choice is stored per viewer.
      try {
        const s = localStorage.getItem('theme');
        if (s === 'dark' || s === 'light') document.documentElement.dataset.theme = s;
      } catch (e) {}
    </script>
  </head>
  <body>
    {!bare && <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>}
    {!bare && <Header lang={lang} routeKey={key} translated={translated} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
  </body>
</html>
