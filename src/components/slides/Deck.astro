---
/**
 * Presentation shell. Children are slide components (TitleSlide, FigureSlide, ...).
 * <Deck title="…" short="Footer title" backHref="/publications/carbon-2026/"> ... </Deck>
 */
import Base from '../../layouts/Base.astro';
import { url } from '../../i18n/utils';
interface Props { title: string; short: string; description?: string; backHref?: string; author?: string }
const { title, short, description, backHref = '/publications/', author = 'Mijail Littin' } = Astro.props;
---
<Base title={title} description={description} math bare>
  <div class="deck" data-deck style={`--deck-short: '${short.replace(/'/g, '’')}'; --deck-author: '${author}';`}>
    <div class="deck__stage">
      <slot />
    </div>
    <div class="deck__progress" aria-hidden="true"><span data-progress></span></div>
    <nav class="deck__ui no-print" aria-label="Presentation controls">
      <a class="deck__back" href={url(backHref)} title="Leave the presentation">← Exit</a>
      <span class="deck__counter" data-counter aria-hidden="true"></span>
      <button type="button" data-prev aria-label="Previous">‹</button>
      <button type="button" data-next aria-label="Next">›</button>
      <button type="button" data-over aria-label="Overview (O)" title="Overview (O)">▦</button>
      <button type="button" data-speaker aria-label="Speaker view (S)" title="Speaker view (S)">S</button>
      <button type="button" data-full aria-label="Fullscreen (F)" title="Fullscreen (F)">⤢</button>
      <button type="button" data-helpbtn aria-label="Keyboard help (?)" title="Help (?)">?</button>
    </nav>
    <p class="sr-only" aria-live="polite" data-live></p>
    <dialog class="deck__help" data-help>
      <h2>Keyboard</h2>
      <table>
        <tr><td><kbd>→</kbd> <kbd>Space</kbd></td><td>next step</td></tr>
        <tr><td><kbd>←</kbd></td><td>previous step</td></tr>
        <tr><td><kbd>Home</kbd> <kbd>End</kbd></td><td>first / last slide</td></tr>
        <tr><td>digits + <kbd>Enter</kbd></td><td>go to slide</td></tr>
        <tr><td><kbd>O</kbd></td><td>overview</td></tr>
        <tr><td><kbd>S</kbd></td><td>speaker view (notes, next slide, timer)</td></tr>
        <tr><td><kbd>F</kbd></td><td>fullscreen</td></tr>
        <tr><td><kbd>P</kbd></td><td>print / save as PDF</td></tr>
      </table>
      <form method="dialog"><button class="btn">Close</button></form>
    </dialog>
    <noscript>
      <p class="deck__nojs">JavaScript is off: slides are shown one after another.</p>
      <style>html:has(.deck){overflow:auto}.deck{position:static}.deck__stage{position:static;transform:none;width:auto;height:auto}.slide{position:relative;opacity:1;visibility:visible;width:100%;height:auto;aspect-ratio:16/9;font-size:clamp(12px,2vw,32px)}[data-fragment]{opacity:1;transform:none}.deck__ui{display:none}</style>
    </noscript>
  </div>
</Base>

<script>
  import { initDeck } from '../../lib/deck';
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach(initDeck);
</script>

<style is:global>
  html:has(.deck) { overflow: hidden; }
  html:has(.deck.is-print), html:has(.deck.is-overview) { overflow: auto; }
  .deck { position: fixed; inset: 0; background: var(--paper-3); overflow: hidden; }
  .deck__stage { position: absolute; left: 50%; top: 50%; width: 1600px; height: 900px; transform-origin: center center; }

  /* A slide: 1600 × 900 design canvas */
  .slide {
    position: absolute; inset: 0; padding: 72px 96px 84px;
    background: var(--paper); color: var(--ink);
    font-family: var(--font-serif); font-size: 32px; line-height: 1.45;
    display: flex; flex-direction: column;
    opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0.25s;
    overflow: hidden;
  }
  .slide.is-active { opacity: 1; visibility: visible; }
  .is-reduced .slide { transition: none; }
  .slide::after {
    content: var(--deck-short) '  ·  ' var(--deck-author);
    position: absolute; left: 96px; bottom: 32px; font-family: var(--font-caps); font-size: 19px; color: var(--ink-3); letter-spacing: 0.02em; text-transform: lowercase;
  }
  .slide::before {
    content: attr(data-num);
    position: absolute; right: 96px; bottom: 32px; font-family: var(--font-sans); font-size: 17px; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .slide--plain::after, .slide--plain::before { content: none; }
  .slide h2 { font-size: 54px; line-height: 1.15; font-weight: 400; max-width: 1300px; padding-bottom: 14px; border-bottom: 1px solid var(--ink-3); }
  .slide h3 { font-size: 36px; font-weight: 700; }
  .slide .kicker { font-family: var(--font-caps); font-size: 26px; font-weight: 400; letter-spacing: 0.03em; text-transform: lowercase; color: var(--ink-3); margin-bottom: 10px; }
  .slide p + p { margin-top: 0.6em; }
  .slide ul { padding-left: 1.1em; }
  .slide li + li { margin-top: 0.45em; }
  .slide .small { font-size: 24px; color: var(--ink-2); }
  .slide .sans { font-family: var(--font-sans); }
  .slide .body { flex: 1; min-height: 0; margin-top: 40px; display: flex; flex-direction: column; justify-content: center; }
  .slide .katex { font-size: 1.12em; }
  .slide figcaption, .slide .cap { font-family: var(--font-sans); font-size: 20px; color: var(--ink-2); margin-top: 14px; line-height: 1.4; }
  .slide .credit { font-size: 16px; }
  .slide .notes { display: none; }

  /* Fragments */
  [data-fragment] { opacity: 0; transform: translateY(8px); transition: opacity 0.3s ease, transform 0.3s ease; }
  [data-fragment].is-visible { opacity: 1; transform: none; }
  [data-fragment].dim-after.is-visible:not(.is-current) { opacity: 0.4; }
  .is-reduced [data-fragment] { transform: none; transition: none; }

  /* Progress + UI */
  .deck__progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: transparent; }
  .deck__progress span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); transition: transform 0.3s; }
  .deck__ui { position: absolute; right: 14px; top: 12px; display: flex; gap: 4px; align-items: center; font-family: var(--font-sans); font-size: 14px; }
  .deck__ui button, .deck__back { border: 1px solid var(--rule); background: var(--paper); color: var(--ink-2); min-width: 32px; height: 30px; padding: 0 8px; border-radius: 2px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .deck__counter { color: var(--ink-2); padding: 0 8px; font-variant-numeric: tabular-nums; }
  .deck__help { border: 1px solid var(--rule-strong); background: var(--paper); color: var(--ink); padding: 24px 28px; font-family: var(--font-sans); max-width: 30rem; }
  .deck__help h2 { font-size: 1.2rem; font-family: var(--font-sans); margin-bottom: 0.6rem; }
  .deck__help form { margin-top: 1rem; }
  .deck__help::backdrop { background: rgb(0 0 0 / 0.3); }
  .deck__nojs { position: fixed; top: 0; left: 0; right: 0; background: var(--ink); color: var(--paper); padding: 8px; font-family: var(--font-sans); z-index: 5; }

  /* Overview grid */
  .deck.is-overview { overflow: auto; }
  .deck.is-overview .deck__stage { position: static; transform: none !important; width: auto; height: auto; display: grid; grid-template-columns: repeat(auto-fill, 320px); gap: 24px; padding: 32px; justify-content: center; }
  .deck.is-overview .slide { position: relative; opacity: 1; visibility: visible; width: 1600px; height: 900px; zoom: 0.2; cursor: pointer; outline: 1px solid var(--rule-strong); }
  .deck.is-overview .slide [data-fragment] { opacity: 1; transform: none; }
  .deck.is-overview .slide.is-active { outline: 8px solid var(--accent); }

  /* Print / PDF: one slide per page */
  .deck.is-print, html:has(.deck.is-print) body { position: static; overflow: visible; background: #fff; }
  .deck.is-print .deck__stage { position: static; transform: none !important; width: auto; height: auto; }
  .deck.is-print .slide { position: relative; opacity: 1; visibility: visible; width: 1600px; height: 900px; break-after: page; page-break-after: always; }
  .deck.is-print .deck__ui, .deck.is-print .deck__progress { display: none; }
  .deck.is-print .slide:last-child { break-after: auto; page-break-after: auto; }
  @media print {
    @page { size: 1600px 900px; margin: 0; }
    .deck { position: static; }
    .deck__stage { position: static !important; transform: none !important; width: auto !important; height: auto !important; }
    .slide { position: relative !important; opacity: 1 !important; visibility: visible !important; break-after: page; }
    .slide:last-child { break-after: auto; }
    [data-fragment] { opacity: 1 !important; transform: none !important; }
    .deck__ui, .deck__progress { display: none !important; }
  }

  /* Speaker view */
  .speaker-mode .deck { right: 36%; }
  .speaker { position: fixed; top: 0; right: 0; bottom: 0; width: 36%; background: var(--paper); border-left: 1px solid var(--rule-strong); display: grid; grid-template-rows: auto 1fr auto; gap: 16px; padding: 20px; font-family: var(--font-sans); overflow: hidden; }
  .speaker__nextbox { position: relative; aspect-ratio: 16 / 9; background: var(--paper-3); overflow: hidden; container-type: inline-size; }
  .speaker__scale { position: absolute; left: 0; top: 0; width: 1600px; height: 900px; transform-origin: 0 0; }
  .speaker__scale .slide { opacity: 1; visibility: visible; }
  .speaker__text { font-size: 1.05rem; line-height: 1.55; overflow: auto; max-height: 100%; }
  .speaker__notes { overflow: auto; min-height: 0; }
  .speaker__meta { display: flex; gap: 16px; align-items: center; font-size: 1.4rem; font-variant-numeric: tabular-nums; }
  .speaker__timer { font-weight: 600; }
</style>
