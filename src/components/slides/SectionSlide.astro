---
interface Props { number?: string; title: string; lead?: string }
const { number, title, lead } = Astro.props;
---
<section class="slide slide--section" data-title={title}>
  <div class="s">
    {number && <p class="n">{number}</p>}
    <h2>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <aside class="notes"><slot name="notes" /></aside>
</section>
<style>
  .slide--section { justify-content: center; }
  .s { border-left: 2px solid var(--ink); padding-left: 48px; }
  .n { font-size: 30px; color: var(--ink-3); margin-bottom: 12px; }
  .slide--section h2 { font-size: 68px; border-bottom: 0; }
  .lead { margin-top: 28px; font-size: 34px; color: var(--ink-2); max-width: 1100px; }
</style>
