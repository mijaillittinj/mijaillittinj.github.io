---
import type { Publication } from '../../data/publications';
import { statusLabel } from '../../data/publications';
import { url } from '../../i18n/utils';
interface Props { pub: Publication; compact?: boolean; headingLevel?: 'h3' | 'h4' }
const { pub: p, compact = false, headingLevel = 'h3' } = Astro.props;
void headingLevel;
const authorsHtml = p.authors
  .map((a) => (a === 'M. Littin' ? '<strong>M. Littin</strong>' : a))
  .join(', ');
const loc = [p.volume, p.article].filter(Boolean).join(', ');
const internal = (h: string) => (h.startsWith('/') ? url(h) : h);
---
<article class="pub" data-year={p.year} data-themes={p.themes.join(' ')} data-ml={p.ml ? '1' : '0'} data-first={p.firstAuthor ? '1' : '0'}>
  <p class="pub__ref">
    <span class="pub__authors" set:html={authorsHtml + '.'} />{' '}
    <cite class="pub__title">{p.page ? <a href={url(p.page)}>{p.title}</a> : p.title}.</cite>{' '}
    <em>{p.journal}</em>{p.volume && <> <strong>{p.volume}</strong></>}{p.article && `, ${p.article}`} ({p.year}).{' '}
    {p.status !== 'published' && <span class="pub__status">{statusLabel[p.status]}.</span>}
  </p>
  {!compact && p.summary && <p class="pub__summary">{p.summary}</p>}
  <ul class="links">
    {p.page && <li><a href={url(p.page)}>explainer</a></li>}
    {p.doi && <li><a href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a></li>}
    {p.access.kind === 'open' && p.access.pdf && <li><a href={p.access.pdf}>open access ({p.access.license})</a></li>}
    {p.slides && <li><a href={url(p.slides)}>slides</a></li>}
    {p.links?.map((l) => <li><a href={internal(l.href)}>{l.label}</a></li>)}
    {!compact && <li><a href={url(`/publications/bibtex/${p.id}.bib`)} download>bibtex</a></li>}
  </ul>
</article>

<style>
  /* Bibliography entry with a running number [n] and a hanging indent */
  .pub { position: relative; padding-left: 2.6em; margin-top: var(--s-3); counter-increment: bib; }
  .pub::before { content: '[' counter(bib) ']'; position: absolute; left: 0; top: 0; color: var(--ink); }
  .pub__ref { text-align: left; hyphens: manual; }
  .pub__title { display: inline; font-style: normal; }
  .pub__title a { color: var(--ink); }
  .pub__title a:hover { color: var(--accent); }
  .pub__authors :global(strong) { font-weight: 400; font-variant: small-caps; font-family: var(--font-caps); text-transform: lowercase; font-size: 1.05em; }
  .pub__status { font-style: italic; color: var(--ink-3); }
  .pub__summary { margin-top: 0.2rem; font-size: var(--step--1); color: var(--ink-2); text-align: justify; }
  .links { margin-top: 0.15rem; font-size: var(--step--2); }
  /* keep each separator with the link before it, so a wrapped line never starts with a dot */
  .links li + li::before { content: none; }
  .links li:not(:last-child)::after { content: '·'; color: var(--ink-3); padding: 0 0.5em; }
</style>
