---
import { t, type Lang } from '../../i18n/ui';
import { person, profiles, lastUpdated } from '../../data/site';
import { url } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="frame grid">
    <div>
      <p class="name">Mijail Littin, PhD</p>
      <p class="meta">{person.affiliation[lang]}</p>
    </div>
    <div>
      <p class="label">{t(lang, 'footer.contact')}</p>
      <p class="meta"><a href={`mailto:${person.email}`}>{person.email}</a></p>
      <p class="meta"><a href={url('/cv/Mijail_Littin_CV.pdf')}>{t(lang, 'nav.cv')} (PDF)</a></p>
    </div>
    <div>
      <p class="label">{t(lang, 'footer.profiles')}</p>
      <ul class="plist">
        {profiles.map((p) => <li class="meta"><a href={p.href} rel="me noopener">{p.label}</a></li>)}
      </ul>
    </div>
    <p class="colophon meta">
      {t(lang, 'footer.colophon')} {t(lang, 'footer.updated')}: <time datetime={lastUpdated}>{lastUpdated}</time>.
      <a href="https://creativecommons.org/licenses/by/4.0/">{t(lang, 'footer.license')}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--s-9); padding-block: var(--s-5) var(--s-6); text-align: center; font-size: var(--step--1); }
  .grid { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3) var(--s-7); border-top: 0.5px solid var(--ink-3); padding-top: var(--s-5); }
  .grid > div { max-width: 20rem; }
  .name { font-family: var(--font-caps); font-size: var(--step-0); }
  .label { display: block; margin-bottom: var(--s-1); }
  .plist { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 var(--s-3); }
  .colophon { flex-basis: 100%; max-width: 40rem !important; margin: var(--s-3) auto 0; font-size: var(--step--2); color: var(--ink-3); }
</style>
