---
import { t, type Lang } from '../../i18n/ui';
import { localized, url } from '../../i18n/utils';

interface Props { lang: Lang; routeKey: string; translated: boolean }
const { lang, routeKey, translated } = Astro.props;

const items = [
  { key: '/', label: t(lang, 'nav.home') },
  { key: '/research/', label: t(lang, 'nav.research') },
  { key: '/publications/', label: t(lang, 'nav.publications') },
  { key: '/teaching/', label: t(lang, 'nav.teaching') },
  { key: '/learn/', label: t(lang, 'nav.learn') },
  { key: '/software/', label: t(lang, 'nav.software') },
  { key: '/cv/', label: t(lang, 'nav.cv'), href: url('/cv/Mijail_Littin_CV.pdf'), title: lang === 'es' ? 'CV (PDF, en inglés)' : 'CV (PDF)' },
];
const isActive = (k: string) => (k === '/' ? routeKey === '/' : routeKey === k || routeKey.startsWith(k));
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const switchHref = otherLang === 'es'
  ? (translated ? url(`/es${routeKey}`) : url('/es/'))
  : url(routeKey);
---

<header class="site-header">
  <div class="frame bar">
    <a class="brand" href={localized('/', lang)} aria-label={lang === 'es' ? 'Mijail Littin, inicio' : 'Mijail Littin, home'}>
      <span class="brand__name">Mijail Littin</span>
    </a>
    <nav aria-label={t(lang, 'nav.primary')} class="nav">
      <button class="nav__toggle" aria-expanded="false" aria-controls="nav-list">
        <span>{t(lang, 'nav.menu')}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5h12M2 11h12" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
      <ul id="nav-list" class="nav__list">
        {items.map((it) => (
          <li>
            <a href={it.href ?? localized(it.key, lang)} title={it.title} aria-current={isActive(it.key) ? 'page' : undefined}>{it.label}</a>
          </li>
        ))}
        <li class="nav__lang">
          <a href={switchHref} hreflang={otherLang} lang={otherLang} title={t(lang, 'lang.switchLabel')}>
            {otherLang.toUpperCase()}
          </a>
        </li>
        <li class="nav__theme">
          <button class="theme-toggle" type="button" aria-label={lang === 'es' ? 'Cambiar a modo oscuro o claro' : 'Toggle dark mode'} title={lang === 'es' ? 'Cambiar a modo oscuro o claro' : 'Toggle dark mode'}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const list = document.getElementById('nav-list');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    list?.classList.toggle('is-open', !open);
  });
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme
      ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>

<style>
  /* Running head: small capitals, a hairline, nothing else */
  .site-header { border-bottom: 0.5px solid var(--ink-3); background: var(--paper); }
  .bar { display: flex; align-items: baseline; justify-content: space-between; min-height: 3.2rem; gap: var(--s-4); padding-top: 0.9rem; padding-bottom: 0.5rem; max-width: calc(var(--wide-block) + 2 * var(--gutter)); }
  .brand { text-decoration: none; color: var(--ink); }
  .brand__name { font-family: var(--font-caps); font-size: 1.12rem; letter-spacing: 0.03em; }
  .brand:hover { text-decoration: none; }
  .nav { font-family: var(--font-caps); font-size: 1rem; }
  .nav__list { list-style: none; display: flex; align-items: baseline; gap: 0 1.05em; padding: 0; flex-wrap: wrap; justify-content: flex-end; }
  .nav__list a { color: var(--ink-2); text-decoration: none; text-transform: lowercase; letter-spacing: 0.02em; }
  .nav__list a:hover { color: var(--accent); }
  .nav__list a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.25em; }
  .nav__lang { margin-left: 0.4em; padding-left: 1em; border-left: 0.5px solid var(--rule-strong); }
  .theme-toggle { border: 0; background: none; line-height: 0; padding: 0 0 0 0.2em; color: var(--ink-3); position: relative; top: 2px; }
  .theme-toggle:hover { color: var(--ink); }
  .nav__toggle { display: none; align-items: center; gap: 0.4rem; border: 0; background: none; padding: 0; font-family: var(--font-caps); text-transform: lowercase; color: var(--ink-2); }

  @media (max-width: 58rem) {
    .nav__toggle { display: inline-flex; }
    .nav__list {
      display: none; position: absolute; left: 0; right: 0; top: 100%; z-index: 30;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 0.5px solid var(--ink-3);
      padding: var(--s-2) var(--gutter) var(--s-4);
    }
    .nav__list.is-open { display: flex; }
    .nav__list a { display: block; padding: 0.55rem 0; border-bottom: 0.5px solid var(--rule); font-size: 1.08rem; }
    .nav__lang, .nav__theme { margin: 0; padding: 0; border: 0; }
    .nav__theme { padding-top: var(--s-3); }
    .site-header { position: relative; }
  }
</style>
