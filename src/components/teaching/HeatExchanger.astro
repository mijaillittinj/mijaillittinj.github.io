---
/** ILN223: heat-exchanger effectiveness with the ε–NTU method. */
import ParameterSlider from '../viz/ParameterSlider.astro';
import Equation from '../viz/Equation.astro';
interface Props { lang: 'en' | 'es'; n: string }
const { lang, n } = Astro.props;
const es = lang === 'es';
const S = es
  ? {
      NTU: 'Número de unidades de transferencia NTU', Cr: 'Razón de capacidades Cr = Cmin/Cmax',
      Th: 'Entrada caliente Th,in', Tc: 'Entrada fría Tc,in', Cmin: 'Cmin',
      plot: 'Efectividad en función de NTU', xn: 'NTU = UA/Cmin', ye: 'ε',
      lcf: 'contraflujo', lpf: 'flujo paralelo', lcur: 'diseño actual (contraflujo)', lcurp: 'diseño actual (paralelo)',
      read: ['ε contraflujo', 'ε paralelo', 'Calor transferido (contraflujo)', 'salidas en contraflujo', 'salidas en paralelo', 'caliente', 'fría'],
      assume: 'Se supone que el fluido caliente es el de menor capacidad térmica, Ch = Cmin.',
      cap: 'Método ε–NTU para dimensionar intercambiadores de calor. La efectividad ε es el calor transferido dividido por el máximo posible, Cmin(Th,in − Tc,in). Aumentar el área (más NTU) tiene rendimientos decrecientes, y el contraflujo siempre supera al flujo paralelo, que nunca pasa de 1/(1 + Cr). Este es el tipo de relación que se usa al optimizar el área de un intercambiador frente a su costo.',
    }
  : {
      NTU: 'Number of transfer units NTU', Cr: 'Capacity ratio Cr = Cmin/Cmax',
      Th: 'Hot inlet Th,in', Tc: 'Cold inlet Tc,in', Cmin: 'Cmin',
      plot: 'Effectiveness against NTU', xn: 'NTU = UA/Cmin', ye: 'ε',
      lcf: 'counterflow', lpf: 'parallel flow', lcur: 'current design (counterflow)', lcurp: 'current design (parallel)',
      read: ['ε counterflow', 'ε parallel', 'Heat duty (counterflow)', 'outlets in counterflow', 'outlets in parallel flow', 'hot', 'cold'],
      assume: 'The hot stream is assumed to have the smaller heat capacity rate, Ch = Cmin.',
      cap: 'The ε–NTU method for sizing heat exchangers. The effectiveness ε is the heat transferred divided by the largest possible, Cmin(Th,in − Tc,in). Adding area (more NTU) gives diminishing returns, and counterflow always beats parallel flow, which never exceeds 1/(1 + Cr). This is the kind of relation used when an exchanger’s area is optimised against its cost.',
    };
---
<figure class="lab" data-t-hx data-s={JSON.stringify(S)}>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="ntu" label={S.NTU} min={0.05} max={5} step={0.05} value={1.5} />
      <ParameterSlider name="cr" label={S.Cr} min={0} max={1} step={0.01} value={0.5} />
      <ParameterSlider name="th" label={S.Th} min={60} max={300} step={5} value={150} unit=" °C" format="int" />
      <ParameterSlider name="tc" label={S.Tc} min={0} max={50} step={1} value={20} unit=" °C" format="int" />
      <ParameterSlider name="cmin" label={S.Cmin} min={0.1} max={10} step={0.1} value={2} unit=" kW/K" />
      <p class="lab__readout" data-t-read aria-live="polite"></p>
    </div>
    <div><p class="panel-title">{S.plot}</p><div class="t-plot" data-t-eps></div><p class="meta">{S.assume}</p></div>
  </div>
  <Equation tex={String.raw`\varepsilon_{\mathrm{cf}}=\frac{1-e^{-\mathrm{NTU}(1-C_r)}}{1-C_r\,e^{-\mathrm{NTU}(1-C_r)}},\qquad \varepsilon_{\mathrm{pf}}=\frac{1-e^{-\mathrm{NTU}(1+C_r)}}{1+C_r},\qquad q=\varepsilon\,C_{\min}\,(T_{h,\mathrm{in}}-T_{c,\mathrm{in}})`} />
  <figcaption><span class="fig-num">{es ? 'Figura' : 'Figure'} {n}.</span>{S.cap}</figcaption>
</figure>

<script>
  import { LinePlot, fmt } from '../../lib/plot';
  import { effCounter, effParallel } from '../../lib/teaching';

  document.querySelectorAll<HTMLElement>('[data-t-hx]').forEach((root) => {
    const S = JSON.parse(root.dataset.s!);
    const val = (k: string) => +root.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value;
    const plot = new LinePlot(root.querySelector('[data-t-eps]')!, { width: 760, height: 300, xlabel: S.xn, ylabel: S.ye, title: S.plot });
    const read = root.querySelector<HTMLElement>('[data-t-read]')!;
    const N = Array.from({ length: 121 }, (_, i) => (i * 5) / 120);

    const update = () => {
      const ntu = val('ntu'), Cr = val('cr'), Th = val('th'), Tc = Math.min(val('tc'), Th - 1), Cmin = val('cmin');
      const ec = effCounter(ntu, Cr), ep = effParallel(ntu, Cr);
      plot.render([
        { kind: 'line', x: N, y: N.map((x) => effCounter(x, Cr)), cls: 's-physics', label: S.lcf },
        { kind: 'line', x: N, y: N.map((x) => effParallel(x, Cr)), cls: 's-learned', label: S.lpf },
        { kind: 'points', x: [ntu], y: [ec], cls: 's-data', label: S.lcur },
        { kind: 'points', x: [ntu], y: [ep], cls: 's-data' },
      ], { xlim: [0, 5], ylim: [0, 1.02] });
      const dT = Th - Tc;
      const out = (e: number) => `${S.read[5]} <strong>${(Th - e * dT).toFixed(1)}</strong> °C, ${S.read[6]} <strong>${(Tc + e * Cr * dT).toFixed(1)}</strong> °C`;
      read.innerHTML = `${S.read[0]} = <strong>${ec.toFixed(3)}</strong>, ${S.read[1]} = <strong>${ep.toFixed(3)}</strong>.<br>${S.read[2]}: <strong>${fmt(ec * Cmin * dT)}</strong> kW.<br>${S.read[3]}: ${out(ec)}.<br>${S.read[4]}: ${out(ep)}.`;
    };
    root.querySelectorAll('input[type=range]').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>
