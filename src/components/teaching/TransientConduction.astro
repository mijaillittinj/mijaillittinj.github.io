---
/** ILN222: transient conduction in a plane wall, finite differences vs lumped capacitance. */
import ParameterSlider from '../viz/ParameterSlider.astro';
import Equation from '../viz/Equation.astro';
interface Props { lang: 'en' | 'es'; n: string }
const { lang, n } = Astro.props;
const es = lang === 'es';
const S = es
  ? {
      Bi: 'Número de Biot, log₁₀ Bi', Fo: 'Tiempo final, número de Fourier Fo',
      prof: 'Perfil de temperatura a través de la pared', hist: 'Temperatura en el tiempo',
      xx: 'posición ξ = x/L (0 = centro, 1 = superficie)', yt: 'θ', xf: 'Fo', lc: 'centro', ls: 'superficie', lm: 'media', ll: 'modelo concentrado',
      at: 'Fo =',
      ok: 'Bi < 0,1: la temperatura es casi uniforme y el modelo concentrado basta.',
      mid: '0,1 ≤ Bi < 1: aparece un gradiente interno; el modelo concentrado empieza a fallar.',
      bad: 'Bi ≥ 1: domina la resistencia interna; hay que resolver el perfil completo.',
      read: ['Bi', 'θ centro', 'θ superficie', 'θ concentrado'],
      cap: 'Enfriamiento de una pared plana de semiespesor L, inicialmente a temperatura uniforme, con convección en ambas caras. θ es la temperatura adimensional (1 al inicio, 0 cuando la pared alcanza la temperatura del fluido) y el número de Fourier Fo mide el tiempo en unidades del tiempo de difusión L²/α. Las curvas de color son la solución numérica (diferencias finitas implícitas); las líneas discontinuas son el modelo de capacitancia concentrada, θ = exp(−Bi·Fo), que supone la misma temperatura en todo el sólido. El número de Biot compara la resistencia a la conducción dentro de la pared con la resistencia a la convección fuera de ella: con Bi pequeño ambos modelos coinciden; con Bi grande el centro queda mucho más caliente que la superficie.',
    }
  : {
      Bi: 'Biot number, log₁₀ Bi', Fo: 'Final time, Fourier number Fo',
      prof: 'Temperature profile across the wall', hist: 'Temperature over time',
      xx: 'position ξ = x/L (0 = centre, 1 = surface)', yt: 'θ', xf: 'Fo', lc: 'centre', ls: 'surface', lm: 'mean', ll: 'lumped model',
      at: 'Fo =',
      ok: 'Bi < 0.1: the temperature is nearly uniform and the lumped model is enough.',
      mid: '0.1 ≤ Bi < 1: an internal gradient appears; the lumped model starts to fail.',
      bad: 'Bi ≥ 1: internal resistance dominates; the full profile must be solved.',
      read: ['Bi', 'θ centre', 'θ surface', 'θ lumped'],
      cap: 'Cooling of a plane wall of half-thickness L, initially at uniform temperature, with convection on both faces. θ is the dimensionless temperature (1 at the start, 0 when the wall reaches the fluid temperature), and the Fourier number Fo measures time in units of the diffusion time L²/α. The coloured curves are the numerical solution (implicit finite differences); the dashed lines are the lumped-capacitance model, θ = exp(−Bi·Fo), which assumes the same temperature throughout the solid. The Biot number compares the resistance to conduction inside the wall with the resistance to convection outside it: for small Bi the two models agree; for large Bi the centre stays much hotter than the surface.',
    };
---
<figure class="lab" data-t-wall data-s={JSON.stringify(S)}>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="lbi" label={S.Bi} min={-2} max={1.5} step={0.05} value={-0.5} />
      <ParameterSlider name="fo" label={S.Fo} min={0.05} max={5} step={0.05} value={2} />
      <p class="lab__readout" data-t-read aria-live="polite"></p>
    </div>
    <div class="lab__plots">
      <div><p class="panel-title">{S.prof}</p><div class="t-plot" data-t-prof></div><div class="t-key" data-t-kprof></div></div>
      <div><p class="panel-title">{S.hist}</p><div class="t-plot" data-t-hist></div><div class="t-key" data-t-khist></div></div>
    </div>
  </div>
  <Equation tex={String.raw`\frac{\partial\theta}{\partial\,\mathrm{Fo}}=\frac{\partial^2\theta}{\partial\xi^2},\qquad \left.\frac{\partial\theta}{\partial\xi}\right|_{0}=0,\qquad -\left.\frac{\partial\theta}{\partial\xi}\right|_{1}=\mathrm{Bi}\,\theta(1),\qquad \mathrm{Bi}=\frac{hL}{k},\ \ \mathrm{Fo}=\frac{\alpha t}{L^2}`} />
  <figcaption><span class="fig-num">{es ? 'Figura' : 'Figure'} {n}.</span><Fragment set:html={S.cap} /></figcaption>
</figure>

<script>
  import { LinePlot, type Series } from '../../lib/plot';
  import { wallTransient, profileMean, lumped } from '../../lib/teaching';
  import { renderKey } from '../../lib/legendkey';

  document.querySelectorAll<HTMLElement>('[data-t-wall]').forEach((root) => {
    const S = JSON.parse(root.dataset.s!);
    const val = (k: string) => +root.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value;
    const pProf = new LinePlot(root.querySelector('[data-t-prof]')!, { width: 420, height: 280, xlabel: S.xx, ylabel: S.yt, title: S.prof, legend: false });
    const pHist = new LinePlot(root.querySelector('[data-t-hist]')!, { width: 420, height: 280, xlabel: S.xf, ylabel: S.yt, title: S.hist, legend: false });
    renderKey(root.querySelector('[data-t-khist]')!, [{ label: S.lc, cls: 's-physics' }, { label: S.ls, cls: 's-data' }, { label: S.lm, cls: 's-learned' }, { label: S.ll, cls: 's-muted', kind: 'dash' }]);
    const read = root.querySelector<HTMLElement>('[data-t-read]')!;
    const nodes = 41;
    const xi = Array.from({ length: nodes }, (_, i) => i / (nodes - 1));
    const classes = ['s-truth', 's-physics', 's-learned', 's-data'];

    const update = () => {
      const Bi = 10 ** val('lbi'), Fo = val('fo');
      const nh = 60;
      const times = Array.from({ length: nh + 1 }, (_, i) => (i * Fo) / nh);
      const sol = wallTransient(Bi, times, nodes, Math.min(2e-3, Fo / 200));
      const snaps = [0.1, 0.25, 0.5, 1].map((q) => Math.round(q * nh));
      const series: Series[] = snaps.map((k, j) => ({ kind: 'line', x: xi, y: Array.from(sol[k]), cls: classes[j], label: `${S.at} ${times[k].toFixed(2)}` }));
      for (const k of snaps) series.push({ kind: 'line', x: [0, 1], y: [lumped(Bi, times[k]), lumped(Bi, times[k])], cls: 's-muted', dash: true });
      pProf.render(series, { xlim: [0, 1], ylim: [0, 1.05] });
      renderKey(root.querySelector('[data-t-kprof]')!, [...snaps.map((k, j) => ({ label: `${S.at} ${times[k].toFixed(2)}`, cls: classes[j] })), { label: S.ll, cls: 's-muted', kind: 'dash' as const }]);
      pHist.render([
        { kind: 'line', x: times, y: sol.map((p) => p[0]), cls: 's-physics', label: S.lc },
        { kind: 'line', x: times, y: sol.map((p) => p[nodes - 1]), cls: 's-data', label: S.ls },
        { kind: 'line', x: times, y: sol.map(profileMean), cls: 's-learned', label: S.lm },
        { kind: 'line', x: times, y: times.map((t) => lumped(Bi, t)), cls: 's-muted', dash: true, label: S.ll },
      ], { xlim: [0, Fo], ylim: [0, 1.05] });
      const last = sol[nh];
      const verdict = Bi < 0.1 ? S.ok : Bi < 1 ? S.mid : S.bad;
      const f2 = (v: number) => v.toFixed(3);
      read.innerHTML = `${S.read[0]} = <strong>${Bi < 1 ? Bi.toFixed(3) : Bi.toFixed(2)}</strong> · ${S.at} ${Fo.toFixed(2)}<br>${S.read[1]} <strong>${f2(last[0])}</strong> · ${S.read[2]} <strong>${f2(last[nodes - 1])}</strong> · ${S.read[3]} <strong>${f2(lumped(Bi, Fo))}</strong><br>${verdict}`;
    };
    root.querySelectorAll('input[type=range]').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>
