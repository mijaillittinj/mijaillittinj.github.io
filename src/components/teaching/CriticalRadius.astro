---
/** ILN222: critical radius of insulation on a pipe or wire. */
import ParameterSlider from '../viz/ParameterSlider.astro';
import Equation from '../viz/Equation.astro';
interface Props { lang: 'en' | 'es'; n: string }
const { lang, n } = Astro.props;
const es = lang === 'es';
const S = es
  ? {
      k: 'Conductividad del aislante k', h: 'Convección h', ri: 'Radio del tubo rᵢ', dT: 'Diferencia de temperatura ΔT',
      plot: 'Pérdida de calor por metro de tubo', xr: 'radio exterior del aislante r (mm)', yq: "q' (W/m)",
      lq: "pérdida q'(r)", lbare: 'tubo sin aislante', lrc: 'radio crítico rc',
      read: ['radio crítico r<sub>c</sub> = k/h', 'sin aislante', 'máximo', 'espesor que reduce la pérdida a la mitad'],
      below: 'rᵢ < rc: una capa delgada de aislante aumenta la pérdida de calor.',
      above: 'rᵢ ≥ rc: cualquier espesor de aislante reduce la pérdida.',
      never: 'fuera del rango',
      cap: 'Pérdida de calor de un tubo (o cable) cubierto con aislante, en función del radio exterior del aislante; se desprecia la resistencia de la pared del tubo. Al engrosar el aislante ocurren dos cosas opuestas: aumenta la resistencia a la conducción a través del aislante, ln(r/rᵢ)/(2πk), pero también crece la superficie exterior que entrega calor al aire, y la resistencia a la convección, 1/(2πrh), disminuye. La suma es mínima, y la pérdida máxima, en el radio crítico r<sub>c</sub> = k/h. Para tuberías grandes rᵢ ya supera a r<sub>c</sub> y aislar siempre ayuda; para cables delgados, una capa de aislante puede incluso mejorar su enfriamiento.',
    }
  : {
      k: 'Insulation conductivity k', h: 'Convection h', ri: 'Pipe radius rᵢ', dT: 'Temperature difference ΔT',
      plot: 'Heat loss per metre of pipe', xr: 'insulation outer radius r (mm)', yq: "q' (W/m)",
      lq: "loss q'(r)", lbare: 'bare pipe', lrc: 'critical radius rc',
      read: ['critical radius r<sub>c</sub> = k/h', 'bare pipe', 'maximum', 'thickness that halves the loss'],
      below: 'rᵢ < rc: a thin layer of insulation increases the heat loss.',
      above: 'rᵢ ≥ rc: any thickness of insulation reduces the loss.',
      never: 'out of range',
      cap: 'Heat loss of an insulated pipe (or wire) as a function of the outer radius of the insulation; the resistance of the pipe wall is neglected. Thickening the insulation has two opposite effects: the resistance to conduction through the insulation, ln(r/rᵢ)/(2πk), increases, but the outer surface that gives heat to the air also grows, so the resistance to convection, 1/(2πrh), decreases. Their sum is smallest, and the loss largest, at the critical radius r<sub>c</sub> = k/h. For large pipes rᵢ already exceeds r<sub>c</sub> and insulation always helps; for thin wires a layer of insulation can even improve cooling.',
    };
---
<figure class="lab" data-t-crit data-s={JSON.stringify(S)}>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="k" label={S.k} min={0.02} max={0.5} step={0.005} value={0.1} unit=" W/(m·K)" format="fixed3" />
      <ParameterSlider name="h" label={S.h} min={2} max={50} step={0.5} value={10} unit=" W/(m²·K)" />
      <ParameterSlider name="ri" label={S.ri} min={1} max={50} step={0.5} value={4} unit=" mm" />
      <ParameterSlider name="dT" label={S.dT} min={10} max={200} step={5} value={60} unit=" K" format="int" />
      <p class="lab__readout" data-t-read aria-live="polite"></p>
    </div>
    <div><p class="panel-title">{S.plot}</p><div class="t-plot" data-t-q></div><div class="t-key" data-t-kq></div></div>
  </div>
  <Equation tex={String.raw`q'=\frac{2\pi\,\Delta T}{\dfrac{\ln(r/r_i)}{k}+\dfrac{1}{h\,r}},\qquad \frac{dq'}{dr}=0\ \Longrightarrow\ r_c=\frac{k}{h}`} />
  <figcaption><span class="fig-num">{es ? 'Figura' : 'Figure'} {n}.</span><Fragment set:html={S.cap} /></figcaption>
</figure>

<script>
  import { LinePlot, fmt } from '../../lib/plot';
  import { heatLossPerLength, criticalRadius } from '../../lib/teaching';
  import { renderKey } from '../../lib/legendkey';

  document.querySelectorAll<HTMLElement>('[data-t-crit]').forEach((root) => {
    const S = JSON.parse(root.dataset.s!);
    const val = (k: string) => +root.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value;
    const plot = new LinePlot(root.querySelector('[data-t-q]')!, { width: 760, height: 300, xlabel: S.xr, ylabel: S.yq, title: S.plot, legend: false });
    renderKey(root.querySelector('[data-t-kq]')!, [{ label: S.lq, cls: 's-physics' }, { label: S.lbare, cls: 's-muted', kind: 'dash' }, { label: S.lrc, cls: 's-data', kind: 'dash' }]);
    const read = root.querySelector<HTMLElement>('[data-t-read]')!;

    const update = () => {
      const k = val('k'), h = val('h'), ri = val('ri') / 1000, dT = val('dT');
      const rc = criticalRadius(k, h);
      const rmax = Math.max(4 * rc, 4 * ri);
      const rs = Array.from({ length: 200 }, (_, i) => ri + ((rmax - ri) * i) / 199);
      const q = rs.map((r) => heatLossPerLength(r, ri, k, h, dT));
      const qBare = 2 * Math.PI * ri * h * dT;
      const qMax = rc > ri ? heatLossPerLength(rc, ri, k, h, dT) : qBare;
      // radius where q' = qBare / 2 (q' decreases monotonically beyond max(ri, rc))
      let rHalf = NaN;
      for (let r = Math.max(ri, rc); r < 50; r *= 1.002) if (heatLossPerLength(r, ri, k, h, dT) <= qBare / 2) { rHalf = r; break; }
      const mm = (r: number) => r * 1000;
      const top = Math.max(...q, qBare) * 1.1;
      plot.render([
        { kind: 'line', x: rs.map(mm), y: rs.map(() => qBare), cls: 's-muted', dash: true, label: S.lbare },
        { kind: 'line', x: rs.map(mm), y: q, cls: 's-physics', label: S.lq },
        { kind: 'line', x: [mm(rc), mm(rc)], y: [0, top], cls: 's-data', dash: true, label: S.lrc },
      ], { xlim: [mm(ri), mm(rmax)], ylim: [0, top] });
      read.innerHTML = `${S.read[0]} = <strong>${mm(rc).toFixed(1)}</strong> mm<br>${S.read[1]} <strong>${fmt(qBare)}</strong> W/m · ${S.read[2]} <strong>${fmt(qMax)}</strong> W/m<br>${S.read[3]}: <strong>${Number.isFinite(rHalf) ? mm(rHalf - ri).toFixed(1) + ' mm' : S.never}</strong><br>${ri < rc ? S.below : S.above}`;
    };
    root.querySelectorAll('input[type=range]').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>
