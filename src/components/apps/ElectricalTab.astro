---
/**
 * Electrical engineering tab: soiling and degradation of a utility-scale PV plant in the
 * desert. Forward: irradiation, temperature, dust and ageing → daily energy. Inverse:
 * from monitoring data (energy, irradiation, temperature) and the cleaning log, recover the
 * soiling rate and the degradation rate (least squares, or a PINN with the soiling ODE in
 * its loss), then choose a cleaning interval. Maths in src/lib/eng/pv.ts and
 * src/lib/eng/pinn-pv.ts. Synthetic 100 MWp plant.
 */
import Equation from '../viz/Equation.astro';
interface Props { lang?: 'en' | 'es'; hidden?: boolean }
const { lang = 'en', hidden = false } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      fwd: 'Directo', fwdText: 'calcular la energía diaria de una planta fotovoltaica de 100 MWp en el desierto a partir de la radiación solar, la temperatura, el polvo que se deposita sobre los módulos (ensuciamiento) y la lenta pérdida de eficiencia que traen los años (degradación).',
      inv: 'Inverso', invText: 'a partir de los datos de monitoreo de la planta y de su registro de limpiezas, estimar la tasa de ensuciamiento y la tasa de degradación, que no se pueden medir directamente en toda la planta.',
      mFwd: 'directo: simular la planta', mInv: 'inverso: diagnosticar la planta',
      rate: 'Tasa de ensuciamiento', interval: 'Intervalo entre limpiezas', none: 'Sin limpiezas durante dos años', deg: 'Degradación', noise: 'Ruido de medición',
      method: 'Método', classic: 'mínimos cuadrados', newD: 'nuevos datos', train: 'entrenar la PINN', stop: 'detener',
      cost: 'Costo por limpieza', price: 'Precio de la energía',
      pE: '(a) Energía diaria', pSR: '(b) Índice de desempeño y razón de ensuciamiento', pPI: '(a) Índice de desempeño: datos y modelo ajustado', pSRe: '(b) Razón de ensuciamiento: estimada y verdadera',
      pPinn: '(a) Índice de desempeño: datos y PINN', pHist: '(b) Parámetros durante el entrenamiento', pDec: '(c) Frecuencia de limpieza: costo anual',
      day: 'día', mwh: 'MWh/día', pi: 'índice', it: 'iteración', val: 'valor', days: 'intervalo entre limpiezas (días)', kusd: 'miles de USD/año',
      leg: { clean: 'planta limpia (modelo)', meas: 'energía medida', sr: 'razón de ensuciamiento', pi: 'índice de desempeño (datos)', fit: 'modelo ajustado', est: 'estimada', truth: 'verdadera', pinn: 'PINN', r: 'r (%/día)', d: 'degradación (%/año)', total: 'costo total', opt: 'óptimo', cur: 'intervalo actual' },
      unitDay: '%/día', unitYr: '%/año', dUnit: 'días', kU: 'mil USD',
      rd: {
        fwd: 'Energía en dos años', lost: 'pérdida por ensuciamiento', cleans: 'limpiezas',
        r: 'Tasa de ensuciamiento', d: 'degradación', truth: 'verdadero', lostE: 'energía perdida por ensuciamiento', jumps: 'limpiezas visibles como saltos en los datos', of: 'de',
        conf: 'sin limpiezas: caída total', confEnd: 'el ensuciamiento y la degradación no se pueden separar',
        pinnIdle: 'Pulse «entrenar la PINN». Valores iniciales: r = 0,10 %/día, degradación 0,30 %/año.', data: 'pérdida de datos', ode: 'residuo de la EDO', srErr: 'error de la razón de ensuciamiento (RMS)',
        pinnConf: 'Sin limpiezas, la PINN solo fija la caída total; el reparto entre ensuciamiento y degradación depende del punto de partida.',
        opt: 'Con la tasa estimada conviene limpiar cada', costs: 'costo anual', current: 'el intervalo actual de', more: 'cuesta', perYr: 'mil USD/año más', best: 'es prácticamente óptimo', needR: 'Primero hay que estimar la tasa de ensuciamiento: sin limpiezas no se puede separar de la degradación.',
      },
      lossLabel: 'La PINN minimiza',
      cap: 'Arriba: en modo directo, la energía diaria y la razón de ensuciamiento (la fracción de la luz que atraviesa el polvo y llega a las celdas) para los valores elegidos; en modo inverso, el índice de desempeño (energía medida dividida por la energía de una planta limpia) con el modelo ajustado. Cada limpieza devuelve el índice cerca de 1; la pendiente entre limpiezas da la tasa de ensuciamiento, y la tendencia de los valores justo después de cada limpieza, la degradación. Sin limpiezas ambos efectos bajan el índice de la misma manera y no se pueden distinguir. Abajo (modo inverso): la tasa de ensuciamiento estimada fija el intervalo de limpieza que minimiza el costo de limpiar más la venta de energía perdida. Planta sintética de 100 MWp, dos años de datos diarios.',
      pinnCap: 'Opción PINN: una red neuronal describe la historia del ensuciamiento, que se reinicia en cada limpieza del registro; la pérdida incluye la ecuación del ensuciamiento dSR/dt = −r·SR, y r y la tasa de degradación se entrenan junto con la red. A la red no se le dice que el ensuciamiento decae de forma exponencial; lo impone la ecuación.',
    }
  : {
      fwd: 'Forward', fwdText: 'compute the daily energy of a 100 MWp photovoltaic plant in the desert from the solar irradiation, the temperature, the dust that settles on the modules (soiling) and their slow loss of efficiency with age (degradation).',
      inv: 'Inverse', invText: 'from the plant’s monitoring data and its cleaning log, estimate the soiling rate and the degradation rate, which cannot be measured directly across a whole plant.',
      mFwd: 'forward: simulate the plant', mInv: 'inverse: diagnose the plant',
      rate: 'Soiling rate', interval: 'Cleaning interval', none: 'No cleanings for two years', deg: 'Degradation', noise: 'Measurement noise',
      method: 'Method', classic: 'least squares', newD: 'new data', train: 'train the PINN', stop: 'stop',
      cost: 'Cost per cleaning', price: 'Energy price',
      pE: '(a) Daily energy', pSR: '(b) Performance index and soiling ratio', pPI: '(a) Performance index: data and fitted model', pSRe: '(b) Soiling ratio: estimated and true',
      pPinn: '(a) Performance index: data and PINN', pHist: '(b) Parameters during training', pDec: '(c) Cleaning frequency: annual cost',
      day: 'day', mwh: 'MWh/day', pi: 'index', it: 'iteration', val: 'value', days: 'days between cleanings', kusd: 'thousand USD/year',
      leg: { clean: 'clean plant (model)', meas: 'measured energy', sr: 'soiling ratio', pi: 'performance index (data)', fit: 'fitted model', est: 'estimated', truth: 'true', pinn: 'PINN', r: 'r (%/day)', d: 'degradation (%/yr)', total: 'total cost', opt: 'optimum', cur: 'current interval' },
      unitDay: '%/day', unitYr: '%/yr', dUnit: 'days', kU: 'kUSD',
      rd: {
        fwd: 'Energy in two years', lost: 'lost to soiling', cleans: 'cleanings',
        r: 'Soiling rate', d: 'degradation', truth: 'true', lostE: 'energy lost to soiling', jumps: 'cleanings visible as jumps in the data', of: 'of',
        conf: 'no cleanings: total decline', confEnd: 'soiling and degradation cannot be separated',
        pinnIdle: 'Press “train the PINN”. Starting values: r = 0.10 %/day, degradation 0.30 %/yr.', data: 'data loss', ode: 'ODE residual', srErr: 'soiling-ratio error (RMS)',
        pinnConf: 'Without cleanings the PINN fixes only the total decline; how it splits it between soiling and degradation depends on where it starts.',
        opt: 'With the estimated rate, clean every', costs: 'annual cost', current: 'the current interval of', more: 'costs', perYr: 'kUSD/yr more', best: 'is practically optimal', needR: 'Estimate the soiling rate first: without cleanings it cannot be separated from degradation.',
      },
      lossLabel: 'The PINN minimises',
      cap: 'Top: in forward mode, the daily energy and the soiling ratio (the fraction of light that passes through the dust to the cells) for the chosen settings; in inverse mode, the performance index (measured energy divided by the energy of a clean plant) with the fitted model. Each cleaning brings the index back close to 1; the slope between cleanings gives the soiling rate, and the trend of the values right after each cleaning gives the degradation. Without cleanings both effects lower the index in the same way, so they cannot be told apart. Bottom (inverse mode): the estimated soiling rate sets the cleaning interval that minimises the cost of cleaning plus the lost energy sales. Synthetic 100 MWp plant, two years of daily data.',
      pinnCap: 'PINN option: a neural network describes the soiling history, restarting at every cleaning in the log; the loss includes the soiling equation dSR/dt = −r·SR, and r and the degradation rate are trained with the network. The network is not told that soiling decays exponentially; the equation imposes it.',
    };
---
<div class="eng-tab pvt" data-eng-tab="electrical" data-pv-text={JSON.stringify(T)} hidden={hidden}>
  <p class="eng-fi"><em>{T.fwd}</em>: {T.fwdText} <em>{T.inv}</em>: {T.invText}</p>

  <div class="eng-switches">
    <div class="eng-switch"><span>{es ? 'Modo' : 'Mode'}:</span>
      <div class="seg" role="group" aria-label={es ? 'Modo' : 'Mode'}>
        <button type="button" data-pv-mode="fwd" aria-pressed="true">{T.mFwd}</button>
        <button type="button" data-pv-mode="inv" aria-pressed="false">{T.mInv}</button>
      </div>
    </div>
    <div class="eng-switch" data-pv-invui hidden><span>{T.method}:</span>
      <div class="seg" role="group" aria-label={T.method}><button type="button" data-pv-m="classic" aria-pressed="true">{T.classic}</button><button type="button" data-pv-m="pinn" aria-pressed="false">PINN</button></div>
    </div>
  </div>

  <div class="pvt__grid">
    <div class="pvt__cell">
      <p class="panel-title" data-pv-t1>{T.pE}</p>
      <div class="pvt__plot" data-pv-p1></div>
      <p class="pvt__key" data-pv-k1></p>
    </div>
    <div class="pvt__cell">
      <p class="panel-title" data-pv-t2>{T.pSR}</p>
      <div class="pvt__plot" data-pv-p2></div>
      <p class="pvt__key" data-pv-k2></p>
    </div>
  </div>

  <div class="eng-controls">
    <div class="control"><div class="control__head"><label for={`pv-r-${lang}`}>{T.rate}</label><output data-pv-or>—</output></div><input id={`pv-r-${lang}`} data-pv-rate type="range" min="0.05" max="0.5" step="0.01" value="0.2" /></div>
    <div class="control"><div class="control__head"><label for={`pv-n-${lang}`}>{T.interval}</label><output data-pv-on>—</output></div><input id={`pv-n-${lang}`} data-pv-int type="range" min="7" max="180" step="1" value="30" /></div>
    <div class="control"><div class="control__head"><label for={`pv-d-${lang}`}>{T.deg}</label><output data-pv-od>—</output></div><input id={`pv-d-${lang}`} data-pv-deg type="range" min="0" max="2" step="0.05" value="0.7" /></div>
    <div class="control"><div class="control__head"><label for={`pv-e-${lang}`}>{T.noise}</label><output data-pv-oe>—</output></div><input id={`pv-e-${lang}`} data-pv-noise type="range" min="0" max="2" step="0.1" value="0.7" /></div>
  </div>
  <div class="eng-checks"><label><input type="checkbox" data-pv-none /> {T.none}</label></div>
  <p class="eng-actions"><button type="button" class="btn" data-pv-train hidden>{T.train}</button><button type="button" class="btn" data-pv-new>{T.newD}</button></p>

  <Equation tex={es
    ? String.raw`\begin{gathered} E(t) = E_{\text{limpia}}(t)\; \mathrm{SR}(t)\,\big(1 - R_d\, t\big) \\ \frac{\mathrm{d}\,\mathrm{SR}}{\mathrm{d}t} = -r\,\mathrm{SR}\ \ \text{entre limpiezas} \\ \mathrm{SR} = 1\ \text{al limpiar} \end{gathered}`
    : String.raw`\begin{gathered} E(t) = E_{\text{clean}}(t)\; \mathrm{SR}(t)\,\big(1 - R_d\, t\big) \\ \frac{\mathrm{d}\,\mathrm{SR}}{\mathrm{d}t} = -r\,\mathrm{SR}\ \ \text{between cleanings} \\ \mathrm{SR} = 1\ \text{after a cleaning} \end{gathered}`} />
  <p class="eng-loss" data-pv-pinnui hidden>{T.lossLabel} <Equation display={false} tex={String.raw`\mathcal{L}(\theta, r, R_d) = \overline{\big(\mathrm{SR}_\theta (1 - R_d t) - \mathrm{PI}\big)^2} + \lambda\, \overline{\Big(\tfrac{\mathrm{d}\ln \mathrm{SR}_\theta}{\mathrm{d}t} + r\Big)^2}`} /></p>
  <p class="lab__readout" data-pv-read aria-live="polite"></p>

  <div class="pvt__decision" data-pv-dec hidden>
    <p class="panel-title">{T.pDec}</p>
    <div class="pvt__decgrid">
      <div class="pvt__plot pvt__plot--dec" data-pv-p3></div>
      <div class="pvt__deccontrols">
        <div class="control"><div class="control__head"><label for={`pv-c-${lang}`}>{T.cost}</label><output data-pv-oc>—</output></div><input id={`pv-c-${lang}`} data-pv-cost type="range" min="10" max="150" step="5" value="40" /></div>
        <div class="control"><div class="control__head"><label for={`pv-p-${lang}`}>{T.price}</label><output data-pv-op>—</output></div><input id={`pv-p-${lang}`} data-pv-price type="range" min="20" max="100" step="1" value="45" /></div>
        <p class="pvt__key" data-pv-k3></p>
      </div>
    </div>
    <p class="lab__readout" data-pv-dread aria-live="polite"></p>
  </div>

  <p class="eng-cap">{T.cap} {T.pinnCap}</p>
</div>

<script>
  import { LinePlot, type Series } from '../../lib/plot';
  import { simulate, fitSoiling, detectCleanings, soilingSeries, soilingLoss, annualCost, optimalInterval, DAYS, type PlantData, type ClassicFit } from '../../lib/eng/pv';
  import { initPvPinn, pvLossGrad, pvAdam, rateOf, degradationOf, pinnSoiling, type PvPinn } from '../../lib/eng/pinn-pv';

  const P_H = 16, P_STEPS = 2500, P_LR = 0.02, FRAME_MS = 7;

  function init(root: HTMLElement) {
    const T = JSON.parse(root.dataset.pvText!);
    const es = T.mFwd.startsWith('directo');
    const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const fmt = (v: number, d = 2) => (es ? v.toFixed(d).replace('.', ',') : v.toFixed(d));
    const rIn = q<HTMLInputElement>('[data-pv-rate]'), nIn = q<HTMLInputElement>('[data-pv-int]'), dIn = q<HTMLInputElement>('[data-pv-deg]');
    const eIn = q<HTMLInputElement>('[data-pv-noise]'), noneBox = q<HTMLInputElement>('[data-pv-none]');
    const cIn = q<HTMLInputElement>('[data-pv-cost]'), pIn = q<HTMLInputElement>('[data-pv-price]');
    const trainBtn = q<HTMLButtonElement>('[data-pv-train]'), newBtn = q<HTMLButtonElement>('[data-pv-new]');
    const read = q<HTMLElement>('[data-pv-read]'), dread = q<HTMLElement>('[data-pv-dread]');
    const p1 = new LinePlot(q<HTMLElement>('[data-pv-p1]'), { width: 420, height: 280, xlabel: T.day, ylabel: T.mwh, title: T.pE, legend: false });
    const p2 = new LinePlot(q<HTMLElement>('[data-pv-p2]'), { width: 420, height: 280, xlabel: T.day, ylabel: T.pi, title: T.pSR, legend: false });
    const p3 = new LinePlot(q<HTMLElement>('[data-pv-p3]'), { width: 420, height: 240, xlabel: T.days, ylabel: T.kusd, title: T.pDec, legend: false });
    const key = (el: HTMLElement, ss: Series[]) => {
      el.replaceChildren(...ss.filter((x) => x.label).map((x) => {
        const sp = document.createElement('span'), mk = document.createElement('span');
        mk.className = x.kind === 'points' ? `pvt__dot ${x.cls.replace('s-', 'c-')}` : `key pvt__line ${x.cls.replace('s-', 'key--')}${x.dash ? ' pvt__dash' : ''}`;
        if (x.kind === 'points') mk.textContent = '●';
        sp.append(mk, document.createTextNode(x.label!));
        return sp;
      }));
    };
    const setText = (sel: string, t: string) => { q<HTMLElement>(sel).textContent = t; };
    const show = (sel: string, on: boolean) => root.querySelectorAll<HTMLElement>(sel).forEach((e) => (e.hidden = !on));

    let mode: 'fwd' | 'inv' = 'fwd', method: 'classic' | 'pinn' = 'classic';
    let seed = 3, data: PlantData, fit: ClassicFit, jumps = 0;
    let pinn: PvPinn | null = null, pIter = 0, praf = 0, pLd = NaN, pLp = NaN, hist: [number, number, number][] = [];
    const days = Array.from({ length: DAYS }, (_, t) => t);
    const every = (arr: ArrayLike<number>, k: number) => { const x: number[] = [], y: number[] = []; for (let t = 0; t < DAYS; t += k) { x.push(t); y.push(arr[t]); } return { x, y }; };
    const truth = () => ({ r: +rIn.value / 100, interval: noneBox.checked ? Infinity : +nIn.value, Rd: +dIn.value / 100, noise: +eIn.value / 100 });
    const annualMWh = () => { let s = 0; for (let t = 0; t < 365; t++) s += data.Eclean[t] * data.D[t]; return s; };

    const outputs = () => {
      setText('[data-pv-or]', `${fmt(+rIn.value)} ${T.unitDay}`);
      setText('[data-pv-on]', noneBox.checked ? '—' : `${nIn.value} ${T.dUnit}`);
      setText('[data-pv-od]', `${fmt(+dIn.value)} ${T.unitYr}`);
      setText('[data-pv-oe]', `${fmt(+eIn.value, 1)} %`);
      setText('[data-pv-oc]', `${cIn.value} ${T.kU}`);
      setText('[data-pv-op]', `${pIn.value} USD/MWh`);
      nIn.disabled = noneBox.checked;
    };

    const newData = () => {
      stopP(); pinn = null; hist = [];
      data = simulate(truth(), seed);
      fit = fitSoiling(data.PI, data.cleanings);
      jumps = detectCleanings(data.PI).length;
    };

    // ---- forward
    const drawForward = () => {
      const m = every(data.E, 2), c = every(data.Eclean, 1);
      const s1: Series[] = [
        { kind: 'points', x: m.x, y: m.y, cls: 's-data', label: T.leg.meas },
        { kind: 'line', x: c.x, y: c.y, cls: 's-physics', label: T.leg.clean },
      ];
      p1.setLabels(T.day, T.mwh);
      p1.render(s1, { xlim: [0, DAYS], ylim: [0, 1000] });
      key(q('[data-pv-k1]'), s1);
      const pi = every(data.PI, 2);
      const s2: Series[] = [
        { kind: 'points', x: pi.x, y: pi.y, cls: 's-data', label: T.leg.pi },
        { kind: 'line', x: days, y: data.SR, cls: 's-truth', label: T.leg.sr },
      ];
      p2.setLabels(T.day, T.pi);
      p2.render(s2, { xlim: [0, DAYS], ylim: [Math.max(0, Math.min(...data.PI) - 0.03), 1.05] });
      key(q('[data-pv-k2]'), s2);
      let tot = 0; for (let t = 0; t < DAYS; t++) tot += data.E[t];
      const L = soilingLoss(data.Eclean, data.D, data.SR);
      read.textContent = `${T.rd.fwd}: ${fmt(tot / 1000, 0)} GWh · ${T.rd.lost}: ${fmt(L.lost / 1000, 1)} GWh (${fmt(L.frac * 100, 1)} %) · ${T.rd.cleans}: ${data.cleanings.length - 1}`;
    };

    // ---- inverse, classical
    const drawClassic = () => {
      const tr = truth();
      const pi = every(data.PI, 2);
      const s1: Series[] = [{ kind: 'points', x: pi.x, y: pi.y, cls: 's-data', label: T.leg.pi }];
      const s2: Series[] = [{ kind: 'line', x: days, y: data.SR, cls: 's-truth', label: T.leg.truth }];
      let txt: string;
      if (fit.confounded) {
        const m = days.map((t) => Math.exp(fit.c0 - fit.sum * t));
        s1.push({ kind: 'line', x: days, y: m, cls: 's-learned', label: T.leg.fit });
        txt = `${T.rd.conf} ${fmt(fit.sum * 100, 3)} ${T.unitDay} · ${T.rd.confEnd} (${T.rd.truth}: ${fmt(tr.r * 100, 2)} ${T.unitDay} + ${fmt(tr.Rd * 100, 2)} ${T.unitYr}).`;
      } else {
        const sr = soilingSeries(fit.r, data.cleanings);
        s1.push({ kind: 'line', x: days, y: days.map((t) => Math.exp(fit.c0) * sr[t] * (1 - (fit.Rd * t) / 365)), cls: 's-learned', label: T.leg.fit });
        s2.push({ kind: 'line', x: days, y: sr, cls: 's-learned', dash: true, label: T.leg.est });
        const Le = soilingLoss(data.Eclean, data.D, sr), Lt = soilingLoss(data.Eclean, data.D, data.SR);
        txt = `${T.rd.r} ${fmt(fit.r * 100, 3)} ± ${fmt(fit.seR * 100, 3)} ${T.unitDay} (${T.rd.truth} ${fmt(tr.r * 100, 3)}) · ${T.rd.d} ${fmt(fit.Rd * 100, 2)} ± ${fmt(fit.seRd * 100, 2)} ${T.unitYr} (${T.rd.truth} ${fmt(tr.Rd * 100, 2)}) · ${T.rd.lostE} ${fmt(Le.lost / 1000, 1)} GWh (${fmt(Le.frac * 100, 1)} %; ${T.rd.truth} ${fmt(Lt.lost / 1000, 1)}) · ${T.rd.jumps}: ${Math.max(0, jumps - 1)} ${T.rd.of} ${data.cleanings.length - 1}`;
      }
      p1.setLabels(T.day, T.pi);
      p1.render(s1, { xlim: [0, DAYS], ylim: [Math.max(0, Math.min(...data.PI) - 0.03), 1.05] });
      key(q('[data-pv-k1]'), s1);
      p2.setLabels(T.day, T.pi);
      p2.render(s2, { xlim: [0, DAYS], ylim: [Math.max(0, Math.min(...data.SR) - 0.03), 1.03] });
      key(q('[data-pv-k2]'), s2);
      read.textContent = txt;
      drawDecision(fit.confounded ? NaN : fit.r);
    };

    // ---- inverse, PINN
    const drawPinn = () => {
      const tr = truth();
      const pi = every(data.PI, 2);
      const s1: Series[] = [
        { kind: 'points', x: pi.x, y: pi.y, cls: 's-data', label: T.leg.pi },
        { kind: 'line', x: days, y: data.SR, cls: 's-truth', dash: true, label: `${T.leg.sr} (${T.leg.truth})` },
      ];
      let txt = T.rd.pinnIdle, rEst = NaN;
      if (pinn) {
        const sr = pinnSoiling(pinn, data.cleanings), d = degradationOf(pinn);
        s1.push({ kind: 'line', x: days, y: days.map((t) => sr[t] * (1 - (d * t) / 36500)), cls: 's-learned', label: T.leg.pinn });
        let e = 0; for (let t = 0; t < DAYS; t++) e += (sr[t] - data.SR[t]) ** 2;
        rEst = rateOf(pinn) / 100;
        txt = `PINN: ${T.it} ${pIter} · r = ${fmt(rateOf(pinn), 3)} ${T.unitDay} (${T.rd.truth} ${fmt(tr.r * 100, 3)}) · ${T.rd.d} ${fmt(d, 2)} ${T.unitYr} (${T.rd.truth} ${fmt(tr.Rd * 100, 2)}) · ${T.rd.data} ${pLd.toFixed(2)} · ${T.rd.ode} ${pLp.toExponential(1)} · ${T.rd.srErr} ${fmt(Math.sqrt(e / DAYS), 4)}`;
        if (data.cleanings.length <= 1) { txt += `. ${T.rd.pinnConf}`; rEst = NaN; }
      }
      p1.setLabels(T.day, T.pi);
      p1.render(s1, { xlim: [0, DAYS], ylim: [Math.max(0, Math.min(...data.PI) - 0.03), 1.05] });
      key(q('[data-pv-k1]'), s1);
      const h: Series[] = [
        { kind: 'line', x: [0, P_STEPS], y: [tr.r * 100, tr.r * 100], cls: 's-truth', dash: true, label: `r (${T.leg.truth})` },
        { kind: 'line', x: [0, P_STEPS], y: [tr.Rd * 100, tr.Rd * 100], cls: 's-muted', dash: true, label: `${T.leg.d} (${T.leg.truth})` },
      ];
      if (hist.length) {
        h.push({ kind: 'line', x: hist.map((z) => z[0]), y: hist.map((z) => z[1]), cls: 's-learned', label: T.leg.r });
        h.push({ kind: 'line', x: hist.map((z) => z[0]), y: hist.map((z) => z[2]), cls: 's-physics', label: T.leg.d });
      }
      p2.setLabels(T.it, T.val);
      p2.render(h, { xlim: [0, P_STEPS], ylim: [0, Math.max(1, tr.Rd * 100 * 1.4, tr.r * 100 * 1.4, ...hist.map((z) => Math.max(z[1], z[2]) * 1.05))] });
      key(q('[data-pv-k2]'), h);
      read.textContent = txt;
      drawDecision(pinn ? rEst : fit.confounded ? NaN : fit.r);
    };

    // ---- decision: cleaning interval
    const drawDecision = (r: number) => {
      const C = +cIn.value * 1000, price = +pIn.value, E = annualMWh();
      const Ns = Array.from({ length: 180 }, (_, i) => i + 5);
      const s: Series[] = [];
      if (Number.isFinite(r) && r > 0) {
        const cost = Ns.map((N) => annualCost(N, r, C, price, E) / 1000);
        const Nopt = optimalInterval(r, C, price, E), cOpt = annualCost(Nopt, r, C, price, E) / 1000;
        s.push({ kind: 'line', x: Ns, y: cost, cls: 's-learned', label: T.leg.total });
        s.push({ kind: 'points', x: [Nopt], y: [cOpt], cls: 's-truth', label: `${T.leg.opt}: ${Nopt} ${T.dUnit}` });
        if (!noneBox.checked) {
          const Nc = +nIn.value, cC = annualCost(Nc, r, C, price, E) / 1000;
          s.push({ kind: 'points', x: [Nc], y: [cC], cls: 's-data', label: `${T.leg.cur}: ${Nc} ${T.dUnit}` });
          const extra = cC - cOpt;
          dread.textContent = `${T.rd.opt} ${Nopt} ${T.dUnit} (${T.rd.costs} ${fmt(cOpt, 0)} ${T.kU}); ${T.rd.current} ${Nc} ${T.dUnit} ` + (extra < 0.02 * cOpt ? `${T.rd.best}.` : `${T.rd.more} ${fmt(extra, 0)} ${T.rd.perYr}.`);
        } else dread.textContent = `${T.rd.opt} ${Nopt} ${T.dUnit} (${T.rd.costs} ${fmt(cOpt, 0)} ${T.kU}).`;
        const top = Math.min(Math.max(...cost), cOpt * 3);
        p3.render(s, { xlim: [0, 185], ylim: [0, top * 1.05] });
      } else {
        dread.textContent = T.rd.needR;
        p3.render([{ kind: 'line', x: [5, 185], y: [0, 0], cls: 's-muted', dash: true }], { xlim: [0, 185], ylim: [0, 1] });
      }
      key(q('[data-pv-k3]'), s);
    };

    // ---- PINN training
    function stopP() { cancelAnimationFrame(praf); praf = 0; trainBtn.textContent = T.train; }
    const loopP = () => {
      if (!pinn) return;
      if (root.hidden) { stopP(); return; }
      const t0 = performance.now();
      while (pIter < P_STEPS && performance.now() - t0 < FRAME_MS) {
        const res = pvLossGrad(pinn, data.PI, data.cleanings);
        pLd = res.Ld; pLp = res.Lp;
        pvAdam(pinn, res.grad, P_LR * (0.1 + 0.45 * (1 + Math.cos((Math.PI * pIter) / P_STEPS))));
        pIter++;
        if (pIter % 25 === 0) hist.push([pIter, rateOf(pinn), degradationOf(pinn)]);
      }
      drawPinn();
      if (pIter >= P_STEPS) { stopP(); return; }
      praf = requestAnimationFrame(loopP);
    };
    const trainP = () => {
      if (praf) { stopP(); return; }
      pinn = initPvPinn(P_H, 5); pIter = 0; pLd = NaN; pLp = NaN; hist = [[0, rateOf(pinn), degradationOf(pinn)]];
      trainBtn.textContent = T.stop;
      praf = requestAnimationFrame(loopP);
    };

    const layout = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-pv-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pvMode === mode)));
      root.querySelectorAll<HTMLButtonElement>('[data-pv-m]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pvM === method)));
      const inv = mode === 'inv', pn = inv && method === 'pinn';
      show('[data-pv-invui]', inv); show('[data-pv-dec]', inv); show('[data-pv-pinnui]', pn);
      trainBtn.hidden = !pn;
      setText('[data-pv-t1]', !inv ? T.pE : pn ? T.pPinn : T.pPI);
      setText('[data-pv-t2]', !inv ? T.pSR : pn ? T.pHist : T.pSRe);
    };
    const redraw = () => { outputs(); layout(); if (mode === 'fwd') drawForward(); else if (method === 'pinn') drawPinn(); else drawClassic(); };

    [rIn, nIn, dIn, eIn].forEach((el) => el.addEventListener('input', () => { newData(); redraw(); }));
    noneBox.addEventListener('change', () => { newData(); redraw(); });
    [cIn, pIn].forEach((el) => el.addEventListener('input', () => { outputs(); if (method === 'pinn') drawPinn(); else drawClassic(); }));
    newBtn.addEventListener('click', () => { seed++; newData(); redraw(); });
    trainBtn.addEventListener('click', trainP);
    root.querySelectorAll<HTMLButtonElement>('[data-pv-mode]').forEach((b) => b.addEventListener('click', () => { stopP(); mode = b.dataset.pvMode as 'fwd' | 'inv'; redraw(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-pv-m]').forEach((b) => b.addEventListener('click', () => { stopP(); method = b.dataset.pvM as 'classic' | 'pinn'; redraw(); }));
    window.addEventListener('themechange', redraw);

    newData(); redraw();
  }

  document.querySelectorAll<HTMLElement>('[data-eng-tab="electrical"]').forEach((root) => {
    let done = false;
    const go = () => { if (!done) { done = true; init(root); } };
    root.addEventListener('eng:show', go);
    if (!root.hidden) go();
  });
</script>

