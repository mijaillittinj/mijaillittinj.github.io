---
/**
 * Fire safety tab: a forest fire against firefighters.
 * Forward ("play"): simulate the spread of a fire over a synthetic landscape; the visitor
 * builds firebreaks while it burns. Game ("minimax"): the fire picks the worst ignition
 * point and wind direction, the firefighters place a fixed length of firebreak to minimise
 * the worst-case damage; solved by alternating best responses with a learned surrogate
 * (src/lib/eng/fire.ts). Synthetic landscape, simple spread rules.
 */
import Equation from '../viz/Equation.astro';
interface Props { lang?: 'en' | 'es'; hidden?: boolean }
const { lang = 'en', hidden = false } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      fwd: 'Problema directo.', game: 'Juego.',
      fi: [' A partir del combustible, el viento y el punto de inicio, simular cómo avanza un incendio. ', ' El fuego elige el peor punto de inicio y la peor dirección del viento. Los brigadistas eligen dónde construir una longitud limitada de cortafuegos para que ese peor caso sea lo más pequeño posible.'],
      mode: 'Modo', mPlay: 'jugar como jefe de brigada', mGame: 'juego minimax',
      speed: 'Velocidad del viento', dir: 'Viento desde', budget: 'Cortafuegos disponibles',
      start: 'encender el fuego', pause: 'pausa', resume: 'continuar', newFire: 'nuevo incendio', clear: 'quitar cortafuegos',
      next: 'siguiente ronda', all: 'jugar hasta el final', stop: 'detener', replay: 'ver ese incendio', restart: 'empezar de nuevo',
      map: 'Mapa de 4,8 km × 4,8 km con bosque, pastizal, río, lago, camino y pueblo',
      hintPlay: 'Haga clic o arrastre sobre el mapa para construir cortafuegos por delante del fuego.',
      hintGame: 'Las letras A a F marcan dónde puede partir el fuego. La estrella y la flecha muestran la respuesta del fuego al plan del mapa.',
      status: 'Estado del incendio', tNow: 'tiempo', burned: 'superficie quemada', houses: 'casas perdidas', left: 'cortafuegos restantes',
      gameH: 'Tabla del juego', plan: 'Plan', worstCol: 'peor', ring: 'Anillo', roundRow: 'Ronda',
      gameLegend: 'Cada fila es un plan de los brigadistas y cada columna un lugar donde puede partir el fuego, con su peor viento. El fuego elige la peor celda de cada fila (recuadrada en rojo). Los brigadistas se quedan con la fila cuyo peor caso es menor (en negrita y enmarcada). Haga clic en una fila para verla en el mapa.',
      plot: 'Peor caso por ronda', xRound: 'ronda', yDmg: 'daño (ha eq.)',
      kBest: 'mejor plan hasta ahora', kTrial: 'plan probado en la ronda', kNaive: 'anillo alrededor del pueblo',
      cmpH: 'Comparación entre los 48 escenarios', table: ['', 'Peor caso', 'Casas perdidas', 'Promedio'], rNaive: 'Anillo alrededor del pueblo', rRobust: 'Plan minimax',
      legend: [['forest', 'bosque'], ['grass', 'pastizal'], ['water', 'agua'], ['bare', 'camino'], ['house', 'casa'], ['burning', 'frente de fuego'], ['burned', 'quemado'], ['break', 'cortafuegos']],
      of: 'de',
      rdIdle: 'Pulse «encender el fuego» y construya cortafuegos por delante del frente.',
      storyIdle: 'Pulse «siguiente ronda» para empezar. La tabla del juego suma una fila por ronda.',
      winds: ['norte', 'noreste', 'este', 'sureste', 'sur', 'suroeste', 'oeste', 'noroeste'],
      searchH: 'Cómo buscan los brigadistas.',
      search: 'En cada ronda un modelo estadístico rápido, una regresión ridge entrenada con 60 distribuciones de cortafuegos al azar y los incendios que producen, ordena las posiciones posibles. Cada plan que sugiere se comprueba después con el simulador completo.',
      cap: 'El mapa representa 4,8 km × 4,8 km de bosque y pastizal, con un río que termina en un lago, un camino y un pueblo de doce casas. El fuego avanza más rápido en el pastizal y a favor del viento. En el modo de juego libre usted enciende el fuego y dibuja cortafuegos, franjas sin combustible, por delante del frente. En el juego minimax pulse «siguiente ronda» para ver cómo se turnan los dos bandos. El fuego elige entre 48 escenarios, seis puntos de inicio y ocho direcciones del viento. Los brigadistas disponen de cinco segmentos de cortafuegos de 500 m. El daño suma las hectáreas quemadas en 4 horas y 40 ha por cada casa perdida. Un anillo alrededor del pueblo lo protege bien de algunos incendios y mal de otros. El plan minimax baja el peor caso, y aquí también el promedio. Entrenar un modelo contra su oponente más fuerte es también la idea del entrenamiento adversarial en aprendizaje automático. Los incendios forestales son un problema recurrente en Chile, pero este es un paisaje sintético con reglas de propagación simples y no una herramienta operacional.',
    }
  : {
      fwd: 'Forward problem.', game: 'Game.',
      fi: [' From the fuel, the wind and the point where it starts, simulate how a fire spreads. ', ' The fire picks the worst starting point and wind direction. The firefighters pick where to build a limited length of firebreak so that this worst case is as small as possible.'],
      mode: 'Mode', mPlay: 'play as fire chief', mGame: 'minimax game',
      speed: 'Wind speed', dir: 'Wind from', budget: 'Firebreak available',
      start: 'light the fire', pause: 'pause', resume: 'resume', newFire: 'new fire', clear: 'remove firebreaks',
      next: 'next round', all: 'play to the end', stop: 'stop', replay: 'show that fire', restart: 'start again',
      map: 'Map of 4.8 km × 4.8 km with forest, grassland, river, lake, road and village',
      hintPlay: 'Click or drag on the map to build firebreaks ahead of the fire.',
      hintGame: 'Letters A to F mark where the fire can start. The star and arrow show the fire’s reply to the plan on the map.',
      status: 'Fire status', tNow: 'time', burned: 'area burned', houses: 'houses lost', left: 'firebreak left',
      gameH: 'Game table', plan: 'Plan', worstCol: 'worst', ring: 'Ring', roundRow: 'Round',
      gameLegend: 'Each row is a firefighter plan and each column a place where the fire can start, with its worst wind. The fire picks the worst cell of each row (outlined in red). The firefighters keep the row whose worst case is smallest (bold and framed). Click a row to see it on the map.',
      plot: 'Worst case per round', xRound: 'round', yDmg: 'damage (ha eq.)',
      kBest: 'best plan so far', kTrial: 'plan tried in the round', kNaive: 'ring around the village',
      cmpH: 'Comparison over all 48 scenarios', table: ['', 'Worst case', 'Houses lost', 'Average'], rNaive: 'Ring around the village', rRobust: 'Minimax plan',
      legend: [['forest', 'forest'], ['grass', 'grassland'], ['water', 'water'], ['bare', 'road'], ['house', 'house'], ['burning', 'fire front'], ['burned', 'burned'], ['break', 'firebreak']],
      of: 'of',
      rdIdle: 'Press “light the fire” and build firebreaks ahead of the front.',
      storyIdle: 'Press “next round” to start. The game table gains one row per round.',
      winds: ['north', 'north-east', 'east', 'south-east', 'south', 'south-west', 'west', 'north-west'],
      searchH: 'How the firefighters search.',
      search: 'In each round a fast statistical model, a ridge regression trained on 60 random firebreak layouts and the fires they lead to, ranks the possible positions. Every plan it suggests is then checked with the full fire simulator.',
      cap: 'The map shows 4.8 km × 4.8 km of forest and grassland, with a river that ends in a lake, a road and a village of twelve houses. The fire runs faster through grassland and with the wind. In play mode you light the fire and draw firebreaks, strips cleared of fuel, ahead of the front. In the minimax game press “next round” to watch the two sides take turns. The fire chooses among 48 scenarios, six starting points and eight wind directions. The firefighters have five firebreak segments of 500 m. Damage counts the hectares burned in 4 hours plus 40 ha for each house lost. A ring around the village protects it well against some fires and badly against others. The minimax plan lowers the worst case, and here it also lowers the average. Training a model against its strongest opponent is also the idea behind adversarial training in machine learning. Wildfires are a recurring problem in Chile, but this is a synthetic landscape with simple spread rules and not an operational tool.',
    };
const client = { lang, T };
---
<div class="eng-tab fr" data-eng-tab="fire" hidden={hidden} data-fr-text={JSON.stringify(client)}>
  <p class="eng-fi"><em>{T.fwd}</em>{T.fi[0]}<em>{T.game}</em>{T.fi[1]}</p>

  <div class="eng-switches">
    <div class="eng-switch"><span>{T.mode}</span>
      <div class="seg" role="group" aria-label={T.mode}>
        <button type="button" data-fr-mode="play" aria-pressed="true">{T.mPlay}</button>
        <button type="button" data-fr-mode="game" aria-pressed="false">{T.mGame}</button>
      </div>
    </div>
  </div>

  <p class="fr__story" data-fr-only="game" data-fr-story aria-live="polite" hidden>{T.storyIdle}</p>

  <div class="fr__grid" data-fr-grid>
    <div class="fr__mapwrap">
      <canvas class="fr__canvas" data-fr-canvas role="img" aria-label={T.map}></canvas>
      <p class="fr__hint meta" data-fr-hint>{T.hintPlay}</p>
      <ul class="fr__legend" aria-hidden="true">
        {T.legend.map(([k, label]) => <li><i class={`fr__sw fr__sw--${k}`}></i>{label}</li>)}
      </ul>
    </div>
    <div class="fr__side">
      <div data-fr-only="play">
        <p class="fr__h">{T.status}</p>
        <dl class="fr__status">
          <dt>{T.tNow}</dt><dd data-fr-st="t">0 h</dd>
          <dt>{T.burned}</dt><dd data-fr-st="b">0 ha</dd>
          <dt>{T.houses}</dt><dd data-fr-st="h">0</dd>
          <dt>{T.left}</dt><dd data-fr-st="l">25</dd>
        </dl>
      </div>
      <div data-fr-only="game" hidden>
        <p class="fr__h">{T.gameH}</p>
        <div class="fr__gamebox">
          <table class="fr__game">
            <thead><tr><th scope="col">{T.plan}</th>{['A', 'B', 'C', 'D', 'E', 'F'].map((l) => <th scope="col">{l}</th>)}<th scope="col">{T.worstCol}</th></tr></thead>
            <tbody data-fr-gbody></tbody>
          </table>
        </div>
        <p class="fr__glegend">{T.gameLegend}</p>
      </div>
    </div>
  </div>

  <div class="fr__below" data-fr-only="game" hidden>
    <div>
      <p class="fr__h">{T.plot}</p>
      <div class="fr__plot" data-fr-plot></div>
    </div>
    <div>
      <p class="fr__h">{T.cmpH}</p>
      <table class="fr__table">
        <thead><tr>{T.table.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">{T.rNaive}</th><td data-fr-tb="nw">–</td><td data-fr-tb="nh">–</td><td data-fr-tb="nm">–</td></tr>
          <tr><th scope="row">{T.rRobust}</th><td data-fr-tb="rw">–</td><td data-fr-tb="rh">–</td><td data-fr-tb="rm">–</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="eng-controls">
    <div class="control">
      <div class="control__head"><label for={`fr-v-${lang}`}>{T.speed}</label><output data-fr-vout>8 m/s</output></div>
      <input id={`fr-v-${lang}`} data-fr-v type="range" min="0" max="14" step="1" value="8" />
    </div>
    <div class="control" data-fr-only="play">
      <div class="control__head"><label for={`fr-d-${lang}`}>{T.dir}</label><output data-fr-dout>W</output></div>
      <input id={`fr-d-${lang}`} data-fr-d type="range" min="0" max="315" step="45" value="270" />
    </div>
    <div class="control" data-fr-only="game" hidden>
      <div class="control__head"><label for={`fr-b-${lang}`}>{T.budget}</label><output data-fr-bout>5 × 500 m</output></div>
      <input id={`fr-b-${lang}`} data-fr-b type="range" min="3" max="8" step="1" value="5" />
    </div>
  </div>
  <p class="eng-actions">
    <button type="button" class="btn" data-fr-start data-fr-only="play">{T.start}</button>
    <button type="button" class="btn" data-fr-new data-fr-only="play">{T.newFire}</button>
    <button type="button" class="btn" data-fr-clear data-fr-only="play">{T.clear}</button>
    <button type="button" class="btn" data-fr-next data-fr-only="game" hidden>{T.next}</button>
    <button type="button" class="btn" data-fr-all data-fr-only="game" hidden>{T.all}</button>
    <button type="button" class="btn" data-fr-replay data-fr-only="game" hidden>{T.replay}</button>
    <button type="button" class="btn" data-fr-restart data-fr-only="game" hidden>{T.restart}</button>
  </p>

  <div class="eng-eqs">
    <Equation tex={String.raw`\min_{b \in \mathcal{B}}\; \max_{s \in \mathcal{S}}\; D(b, s), \qquad D = A_{\mathrm{burned}} + w_h\, N_{\mathrm{houses}}`} />
    <Equation tex={String.raw`R_{ij} = R_0(f_j)\, e^{c_1 V}\, e^{c_2 V (\cos\theta_{ij} - 1)}`} />
  </div>
  <p class="eng-loss" data-fr-only="game" hidden><em>{T.searchH}</em> {T.search}</p>
  <p class="lab__readout" data-fr-read aria-live="polite"></p>
  <p class="eng-cap">{T.cap}</p>
</div>

<script>
  import { N, Fuel, makeLandscape, arrivalTimes, damage, allScenarios, worstCase, naivePlan, planMask, minimaxGame, minimaxTable, windVector, type Scenario, type Segment, type GameRound, type Damage, HOUSE_WEIGHT } from '../../lib/eng/fire';
  import { LinePlot, cssVar, type Series } from '../../lib/plot';
  import { keyed } from '../../lib/legendkey';

  const H = 4;                 // suppression horizon (hours)
  const BURN = 0.35;           // hours a cell stays "burning" before it is ash
  const PLAY_SECONDS = 16;     // real seconds for the 4 h of a fire in play mode
  const BUDGET_CELLS = 25;     // play mode: 5 segments of 5 cells, as in the game
  const COMPASS_EN = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
  const COMPASS_ES = ['N', 'NE', 'E', 'SE', 'S', 'SO', 'O', 'NO'];

  function init(root: HTMLElement) {
    const { lang, T } = JSON.parse(root.dataset.frText!);
    const es = lang === 'es';
    const compass = es ? COMPASS_ES : COMPASS_EN;
    const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const canvas = q<HTMLCanvasElement>('[data-fr-canvas]');
    const ctx = canvas.getContext('2d')!;
    const read = q<HTMLElement>('[data-fr-read]');
    const hint = q<HTMLElement>('[data-fr-hint]');
    const vIn = q<HTMLInputElement>('[data-fr-v]'), dIn = q<HTMLInputElement>('[data-fr-d]'), bIn = q<HTMLInputElement>('[data-fr-b]');
    const startBtn = q<HTMLButtonElement>('[data-fr-start]');
    const nextBtn = q<HTMLButtonElement>('[data-fr-next]'), allBtn = q<HTMLButtonElement>('[data-fr-all]');
    const story = q<HTMLElement>('[data-fr-story]'), gbody = q<HTMLElement>('[data-fr-gbody]');
    const L = makeLandscape(7);
    const S = allScenarios(L);
    const nHouses = L.houses.length;
    const num = (v: number, d = 1) => (es ? v.toFixed(d).replace('.', ',') : v.toFixed(d));

    let mode: 'play' | 'game' = 'play';
    let W = 300;
    // play state
    let ign = L.ignitions[5]; // south-west of the village: threatens it with a west wind
    let blocked = new Uint8Array(N * N), used = 0;
    let t: Float64Array | null = null, now = 0, running = false, finished = false, raf = 0, lastTs = 0;
    let base0 = { burned: 0, houses: 0 };
    // game state: one table row per distinct plan the firefighters propose
    interface Row { label: string; plan: Segment[]; row: number[]; scen: Scenario; dmg: Damage }
    let gen: Generator<GameRound | null> | null = null, grun = false, graf = 0, autoplay = false, finishing = false, gameOver = false;
    const rounds: GameRound[] = [];
    const rows: Row[] = [];
    let selected = -1;
    let naive = { plan: [] as Segment[], wc: null as ReturnType<typeof worstCase> | null };
    let robust: { plan: Segment[]; wc: ReturnType<typeof worstCase> } | null = null;
    let shown: { mask: Uint8Array; scen: Scenario; t: Float64Array } | null = null;
    let replayNow = Infinity, rraf = 0;

    const visible = () => !root.hidden && root.offsetParent !== null;
    const params = () => ({ windSpeed: +vIn.value, horizon: H });

    /* ------------------------------------------------ drawing */
    const dark = () => document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const palette = () => {
      const d = dark();
      return {
        forest: d ? '#2f4833' : '#7fa276', grass: d ? '#565b33' : '#d3d9a4', bare: d ? '#3a3935' : '#e4e0d6',
        water: d ? '#27466f' : '#9db7dc', house: d ? '#e8e4dc' : '#2a2a2a', burned: d ? '#141210' : '#4a423c',
        burning: cssVar('--c-data') || '#b4531a', brk: cssVar('--c-learned') || '#6a4a9c', warn: cssVar('--c-warn') || '#a3261f',
        ink: cssVar('--ink'), paper: cssVar('--paper'), ink3: cssVar('--ink-3'),
      };
    };
    const resize = () => {
      const w = Math.round(canvas.clientWidth);
      if (!w) return false;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = w;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    };
    const cellAt = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      const x = Math.floor(((e.clientX - r.left) / r.width) * N), y = Math.floor(((e.clientY - r.top) / r.height) * N);
      return x >= 0 && y >= 0 && x < N && y < N ? y * N + x : -1;
    };

    const draw = () => {
      if (!W) return;
      const P = palette();
      const c = W / N;
      ctx.clearRect(0, 0, W, W);
      const mask = mode === 'play' ? blocked : shown?.mask ?? null;
      const tt = mode === 'play' ? t : shown?.t ?? null;
      const tn = mode === 'play' ? now : Math.min(replayNow, H);
      for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
        const k = y * N + x, f = L.fuel[k];
        let col = f === Fuel.Water ? P.water : f === Fuel.Bare ? P.bare : f === Fuel.Grass || f === Fuel.House ? P.grass : P.forest;
        const tk = tt ? tt[k] : Infinity;
        if (tt && tk <= tn) col = tk > tn - BURN && (mode === 'play' ? running || !finished : replayNow < H) ? P.burning : P.burned;
        if (mask && mask[k]) col = P.brk;
        ctx.fillStyle = col;
        ctx.fillRect(x * c, y * c, c + 0.5, c + 0.5);
        if (f === Fuel.House) {
          const burnt = tt && tk <= tn;
          ctx.fillStyle = burnt ? P.burning : P.house;
          const s = c * 0.86, ox = x * c + (c - s) / 2, oy = y * c + (c - s) / 2 + s * 0.12;
          ctx.fillRect(ox, oy + s * 0.25, s, s * 0.55);
          ctx.beginPath(); ctx.moveTo(ox - s * 0.1, oy + s * 0.28); ctx.lineTo(ox + s / 2, oy - s * 0.2); ctx.lineTo(ox + s * 1.1, oy + s * 0.28); ctx.closePath(); ctx.fill();
        }
      }
      // ignition marks
      const mark = (i: number, big: boolean, colr: string) => {
        const cx = ((i % N) + 0.5) * c, cy = (((i / N) | 0) + 0.5) * c, r = big ? c * 1.3 : c * 0.8;
        ctx.strokeStyle = colr; ctx.lineWidth = big ? 2 : 1.4;
        if (big) {
          ctx.beginPath();
          for (let k = 0; k < 10; k++) { const a = -Math.PI / 2 + (k * Math.PI) / 5, rr = k % 2 ? r * 0.45 : r; ctx.lineTo(cx + rr * Math.cos(a), cy + rr * Math.sin(a)); }
          ctx.closePath(); ctx.fillStyle = colr; ctx.fill();
        } else { ctx.beginPath(); ctx.arc(cx, cy, r, 0, 2 * Math.PI); ctx.stroke(); }
      };
      if (mode === 'game') {
        ctx.font = `600 ${Math.max(11, c * 1.5)}px ${cssVar('--font-serif') || 'serif'}`;
        ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
        L.ignitions.forEach((i, j) => {
          mark(i, false, P.warn);
          const lx = ((i % N) + 1.6) * c, ly = (((i / N) | 0) + 0.5) * c;
          ctx.fillStyle = P.paper; ctx.globalAlpha = 0.85; ctx.fillRect(lx - c * 0.25, ly - c * 0.9, c * 1.6, c * 1.8); ctx.globalAlpha = 1;
          ctx.fillStyle = P.warn; ctx.fillText('ABCDEF'[j] ?? '', lx, ly);
        });
        ctx.textBaseline = 'alphabetic';
        if (shown) mark(shown.scen.ignition, true, P.warn);
      } else mark(ign, true, P.warn);
      // wind arrow (top-right)
      const from = mode === 'play' ? +dIn.value : shown?.scen.windFrom ?? 270;
      const [wx, wy] = windVector(from);
      const ax = W - c * 5.2, ay = c * 4.2, len = c * 3.2;
      ctx.fillStyle = P.paper; ctx.globalAlpha = 0.82; ctx.fillRect(ax - c * 4, ay - c * 3.4, c * 8, c * 7.4); ctx.globalAlpha = 1;
      ctx.strokeStyle = P.ink; ctx.fillStyle = P.ink; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(ax - wx * len, ay - wy * len); ctx.lineTo(ax + wx * len, ay + wy * len); ctx.stroke();
      const hx = ax + wx * len, hy = ay + wy * len, a = Math.atan2(wy, wx);
      ctx.beginPath(); ctx.moveTo(hx, hy); ctx.lineTo(hx - 7 * Math.cos(a - 0.45), hy - 7 * Math.sin(a - 0.45)); ctx.lineTo(hx - 7 * Math.cos(a + 0.45), hy - 7 * Math.sin(a + 0.45)); ctx.closePath(); ctx.fill();
      ctx.font = `${Math.max(10, c * 1.25)}px ${cssVar('--font-serif') || 'serif'}`; ctx.textAlign = 'center';
      ctx.fillText(`${vIn.value} m/s`, ax, ay + len + c * 1.9);
      // scale bar (1 km = 10 cells)
      ctx.fillStyle = P.paper; ctx.globalAlpha = 0.82; ctx.fillRect(c * 0.8, W - c * 3.4, c * 12, c * 2.8); ctx.globalAlpha = 1;
      ctx.strokeStyle = P.ink; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(c * 1.5, W - c * 1.4); ctx.lineTo(c * 11.5, W - c * 1.4); ctx.stroke();
      ctx.fillStyle = P.ink; ctx.textAlign = 'left'; ctx.fillText('1 km', c * 1.5, W - c * 1.9);
    };

    /* ------------------------------------------------ play mode */
    const status = () => {
      if (!t) { read.textContent = T.rdIdle; return; }
      const d = damage(L, t, Math.min(now, H));
      const set = (k: string, v: string) => { q<HTMLElement>(`[data-fr-st="${k}"]`).textContent = v; };
      set('t', `${num(Math.min(now, H))} h`); set('b', `${d.burned} ha`); set('h', `${d.houses} ${T.of} ${nHouses}`); set('l', `${BUDGET_CELLS - used} ${T.of} ${BUDGET_CELLS}`);
      if (finished) read.textContent = es
        ? `incendio controlado a las ${H} h · ${d.burned} ha quemadas · ${d.houses} casas perdidas · sin cortafuegos ${base0.burned} ha y ${base0.houses} casas`
        : `fire controlled at ${H} h · ${d.burned} ha burned · ${d.houses} houses lost · without firebreaks ${base0.burned} ha and ${base0.houses} houses`;
      else read.textContent = es
        ? `t = ${num(Math.min(now, H))} h de ${H} h · quemado ${d.burned} ha · casas perdidas ${d.houses} de ${nHouses} · cortafuegos restantes ${BUDGET_CELLS - used} de ${BUDGET_CELLS} celdas`
        : `t = ${num(Math.min(now, H))} h of ${H} h · burned ${d.burned} ha · houses lost ${d.houses} of ${nHouses} · firebreak left ${BUDGET_CELLS - used} of ${BUDGET_CELLS} cells`;
    };
    const recompute = () => {
      const V = +vIn.value, from = +dIn.value;
      if (!t) return;
      const sources: { i: number; t: number }[] = [];
      for (let k = 0; k < t.length; k++) if (t[k] <= now && !blocked[k]) sources.push({ i: k, t: t[k] });
      t = arrivalTimes(L, blocked, sources, V, from, H + 1);
    };
    const light = () => {
      stopPlay();
      t = arrivalTimes(L, blocked, [{ i: ign, t: 0 }], +vIn.value, +dIn.value, H + 1);
      const t0 = arrivalTimes(L, null, [{ i: ign, t: 0 }], +vIn.value, +dIn.value, H + 1);
      const d0 = damage(L, t0, H);
      base0 = { burned: d0.burned, houses: d0.houses };
      now = 0; finished = false; running = true; lastTs = 0;
      startBtn.textContent = T.pause;
      raf = requestAnimationFrame(tick);
    };
    const stopPlay = () => { running = false; cancelAnimationFrame(raf); };
    const tick = (ts: number) => {
      if (!running) return;
      if (!visible()) { running = false; startBtn.textContent = T.resume; return; }
      if (lastTs) now += ((ts - lastTs) / 1000) * (H / PLAY_SECONDS);
      lastTs = ts;
      let pending = false;
      if (t) for (let k = 0; k < t.length; k++) if (t[k] > now && t[k] <= H) { pending = true; break; }
      if (now >= H || !pending) { now = Math.min(Math.max(now, 0), H); if (now >= H || !pending) { finished = true; running = false; startBtn.textContent = T.start; } }
      draw(); status();
      if (running) raf = requestAnimationFrame(tick);
    };
    const addBreak = (k: number) => {
      if (k < 0 || used >= BUDGET_CELLS || blocked[k]) return false;
      const f = L.fuel[k];
      if (f === Fuel.Water || f === Fuel.House || f === Fuel.Bare) return false;
      if (t && t[k] <= now) return false;
      blocked[k] = 1; used++;
      return true;
    };
    let painting = false, lastCell = -1;
    // cells on the straight line between two cells (so fast drags leave no gaps)
    const lineCells = (a: number, b: number) => {
      const out: number[] = [];
      let x0 = a % N, y0 = (a / N) | 0;
      const x1 = b % N, y1 = (b / N) | 0, dx = Math.abs(x1 - x0), dy = -Math.abs(y1 - y0), sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
      let err = dx + dy;
      for (;;) {
        out.push(y0 * N + x0);
        if (x0 === x1 && y0 === y1) break;
        const e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
      }
      return out;
    };
    const paintTo = (k: number) => {
      if (k < 0) return;
      let changed = false;
      for (const c of lastCell >= 0 ? lineCells(lastCell, k) : [k]) changed = addBreak(c) || changed;
      lastCell = k;
      if (changed) { recompute(); draw(); status(); }
    };
    canvas.addEventListener('pointerdown', (e) => {
      if (mode !== 'play') return;
      painting = true; lastCell = -1; canvas.setPointerCapture(e.pointerId);
      paintTo(cellAt(e));
    });
    canvas.addEventListener('pointermove', (e) => {
      if (mode !== 'play' || !painting) return;
      paintTo(cellAt(e));
    });
    const endPaint = () => { painting = false; lastCell = -1; };
    canvas.addEventListener('pointerup', endPaint); canvas.addEventListener('pointercancel', endPaint);

    startBtn.addEventListener('click', () => {
      if (running) { stopPlay(); startBtn.textContent = T.resume; return; }
      if (t && !finished && now > 0) { running = true; lastTs = 0; startBtn.textContent = T.pause; raf = requestAnimationFrame(tick); return; }
      light();
    });
    q<HTMLButtonElement>('[data-fr-new]').addEventListener('click', () => {
      const i = L.ignitions.indexOf(ign);
      ign = L.ignitions[(i + 1) % L.ignitions.length];
      blocked = new Uint8Array(N * N); used = 0;
      light();
    });
    q<HTMLButtonElement>('[data-fr-clear]').addEventListener('click', () => {
      blocked = new Uint8Array(N * N); used = 0;
      if (t) { if (finished) light(); else recompute(); }
      draw(); status();
    });

    /* ------------------------------------------------ game mode */
    const plot = new LinePlot(q<HTMLElement>('[data-fr-plot]'), { width: 360, height: 220, xlabel: T.xRound, ylabel: T.yDmg, title: T.plot, legend: false });
    const renderPlot = keyed(plot, q<HTMLElement>('[data-fr-plot]'));
    const nSeg = () => +bIn.value;
    const letter = (sc: Scenario) => 'ABCDEF'[L.ignitions.indexOf(sc.ignition)] ?? '?';
    const windName = (sc: Scenario) => T.winds[Math.round(sc.windFrom / 45) % 8];
    const houses = (h: number) => es ? (h === 0 ? 'ninguna casa' : h === 1 ? '1 casa' : `${h} casas`) : (h === 0 ? 'no houses' : h === 1 ? '1 house' : `${h} houses`);
    const showPlan = (plan: Segment[], scen: Scenario) => {
      const mask = planMask(L, plan);
      shown = { mask, scen, t: arrivalTimes(L, mask, [{ i: scen.ignition, t: 0 }], +vIn.value, scen.windFrom, H + 1) };
      replayNow = Infinity;
    };
    const fillTable = () => {
      const set = (k: string, v: string) => { q<HTMLElement>(`[data-fr-tb="${k}"]`).textContent = v; };
      if (naive.wc) { set('nw', String(naive.wc.damage.value)); set('nh', String(naive.wc.damage.houses)); set('nm', num(naive.wc.mean, 0)); }
      if (robust && gameOver) { set('rw', String(robust.wc.damage.value)); set('rh', String(robust.wc.damage.houses)); set('rm', num(robust.wc.mean, 0)); }
      else { set('rw', '–'); set('rh', '–'); set('rm', '–'); }
    };
    // the game table: outline each row's worst cell, bold the row with the smallest worst case
    const renderGame = () => {
      const tb = minimaxTable(rows.map((r) => r.row));
      const top = Math.max(1, ...rows.flatMap((r) => r.row));
      gbody.replaceChildren(...rows.map((r, i) => {
        const tr = document.createElement('tr');
        if (i === tb.best) tr.classList.add('is-best');
        if (i === selected) tr.classList.add('is-sel');
        tr.tabIndex = 0;
        tr.addEventListener('click', () => selectRow(i));
        tr.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectRow(i); } });
        const th = document.createElement('th'); th.scope = 'row'; th.textContent = r.label; tr.append(th);
        r.row.forEach((v, j) => {
          const td = document.createElement('td');
          td.textContent = String(v);
          td.style.background = `color-mix(in srgb, var(--c-data) ${Math.round(8 + 50 * (v / top))}%, transparent)`;
          if (j === tb.argmax[i]) td.classList.add('is-max');
          tr.append(td);
        });
        const w = document.createElement('td'); w.className = 'fr__wc'; w.textContent = String(tb.rowMax[i]); tr.append(w);
        return tr;
      }));
    };
    const selectRow = (i: number) => {
      if (!rows[i]) return;
      selected = i;
      showPlan(rows[i].plan, rows[i].scen);
      renderGame(); draw();
    };
    const plotRounds = () => {
      const xs = rounds.map((r) => r.round);
      const series: Series[] = [];
      const xmax = Math.max(4, (xs[xs.length - 1] ?? 0) + 1);
      if (naive.wc) series.push({ kind: 'line', x: [0, xmax], y: [naive.wc.damage.value, naive.wc.damage.value], cls: 's-muted', dash: true, label: T.kNaive });
      const tried = rounds.filter((r) => r.round > 0);
      if (tried.length) series.push({ kind: 'points', x: tried.map((r) => r.round), y: tried.map((r) => r.trialDamage.value), cls: 's-physics', label: T.kTrial });
      if (rounds.length) {
        series.push({ kind: 'step', x: xs, y: rounds.map((r) => r.worstDamage.value), cls: 's-learned', label: T.kBest });
        series.push({ kind: 'points', x: xs, y: rounds.map((r) => r.worstDamage.value), cls: 's-learned' });
      }
      const top = Math.max(100, ...series.flatMap((sr) => Array.from(sr.y as number[]))) * 1.12;
      renderPlot(series, { xlim: [0, xmax], ylim: [0, top] });
    };
    const readout = (v: GameRound) => {
      read.textContent = es
        ? `ronda ${v.round} · peor caso del mejor plan ${v.worstDamage.value} ha eq. · casas perdidas ${v.worstDamage.houses} · escenarios encontrados por el fuego ${v.known.length} de ${S.length}`
        : `round ${v.round} · worst case of the best plan ${v.worstDamage.value} ha eq. · houses lost ${v.worstDamage.houses} · scenarios found by the fire ${v.known.length} of ${S.length}`;
    };
    const narrate = (v: GameRound) => {
      const d = v.trialDamage, sc = v.trialScenario;
      if (v.round === 0) {
        story.textContent = es
          ? `Inicio. Los brigadistas parten con un anillo de cortafuegos alrededor del pueblo. La mejor respuesta del fuego es partir en ${letter(sc)} con viento del ${windName(sc)}, que quema ${d.value} ha eq. y ${houses(d.houses)}.`
          : `Start. The firefighters begin with a ring of firebreaks around the village. The fire’s best reply is to start at ${letter(sc)} with wind from the ${windName(sc)}, which costs ${d.value} ha eq. and ${houses(d.houses)}.`;
      } else if (v.improved) {
        const prev = rows.length > 1 ? rows[rows.length - 2].scen : null;
        const same = !!prev && prev.ignition === sc.ignition && prev.windFrom === sc.windFrom;
        const move = v.round === 1
          ? (es ? 'Los brigadistas mueven sus cortafuegos para cortar el paso a ese incendio.' : 'The firefighters move their firebreaks to cut off that fire.')
          : (es ? 'Los brigadistas ajustan el plan frente a todos los inicios y vientos que el fuego ha probado.' : 'The firefighters adjust the plan against every start and wind the fire has tried so far.');
        const reply = same
          ? (es ? `La mejor respuesta del fuego sigue siendo ${letter(sc)} con viento del ${windName(sc)}, pero ahora quema menos, y el peor caso baja a ${d.value} ha eq.` : `The fire’s best reply is still ${letter(sc)} with wind from the ${windName(sc)}, but it now burns less, and the worst case falls to ${d.value} ha eq.`)
          : (es ? `El fuego encuentra una nueva peor respuesta, ${letter(sc)} con viento del ${windName(sc)}, y el peor caso baja a ${d.value} ha eq.` : `The fire finds a new best reply, ${letter(sc)} with wind from the ${windName(sc)}, and the worst case falls to ${d.value} ha eq.`);
        story.textContent = `${es ? 'Ronda' : 'Round'} ${v.round}. ${move} ${reply}`
          + (d.houses > 0 ? (es ? ` Todavía se pierden ${houses(d.houses)}.` : ` It still reaches ${houses(d.houses)}.`) : '');
      }
    };
    const narrateEnd = (v: GameRound) => {
      story.textContent = es
        ? `Ronda ${v.round}. Ninguna nueva distribución baja el peor caso de ${v.worstDamage.value} ha eq. El juego se estabilizó, y la fila enmarcada es el plan robusto.`
        : `Round ${v.round}. No new layout lowers the worst case below ${v.worstDamage.value} ha eq. The game has settled, and the framed row is the robust plan.`;
    };
    const setButtons = () => {
      nextBtn.disabled = gameOver || grun;
      allBtn.textContent = grun && autoplay ? T.stop : T.all;
      allBtn.disabled = gameOver;
    };
    const gameReset = () => {
      stopGame();
      rounds.length = 0; rows.length = 0; selected = -1; robust = null; gameOver = false; finishing = false;
      gen = minimaxGame(L, params(), nSeg(), 1, 6);
      naive = { plan: naivePlan(nSeg()), wc: null };
      naive.wc = worstCase(L, naive.plan, S, params());
      showPlan(naive.plan, naive.wc.worst);
      story.textContent = T.storyIdle;
      read.textContent = es
        ? `anillo alrededor del pueblo · peor caso ${naive.wc.damage.value} ha eq. · casas perdidas ${naive.wc.damage.houses}`
        : `ring around the village · worst case ${naive.wc.damage.value} ha eq. · houses lost ${naive.wc.damage.houses}`;
      renderGame(); fillTable(); plotRounds(); setButtons(); draw();
    };
    const stopGame = () => { grun = false; autoplay = false; cancelAnimationFrame(graf); setButtons(); };
    // accept one round from the solver; returns true when the step shown to the reader is complete
    const accept = (v: GameRound): boolean => {
      rounds.push(v);
      robust = { plan: v.plan, wc: worstCase(L, v.plan, S, params()) };
      if (v.improved) {
        rows.push({ label: v.round === 0 ? T.ring : `${T.roundRow} ${v.round}`, plan: v.trialPlan, row: v.trialRow, scen: v.trialScenario, dmg: v.trialDamage });
        selected = rows.length - 1;
        showPlan(v.trialPlan, v.trialScenario);
        narrate(v);
      } else finishing = true; // no improvement: finish silently, then report once
      readout(v);
      if (v.done) {
        gameOver = true; finishing = false;
        selected = minimaxTable(rows.map((r) => r.row)).best;
        showPlan(rows[selected].plan, rows[selected].scen);
        narrateEnd(v);
      }
      renderGame(); fillTable(); plotRounds(); draw();
      return !finishing;
    };
    const gtick = () => {
      if (!grun || !gen) return;
      if (!visible()) { stopGame(); return; }
      const t0 = performance.now();
      let stepDone = false;
      while (performance.now() - t0 < 7) {
        const r = gen.next();
        if (r.done) { gameOver = true; stepDone = true; break; }
        if (!r.value) continue;
        stepDone = accept(r.value) || gameOver;
        break;
      }
      if (gameOver || (stepDone && !autoplay)) { stopGame(); return; }
      setButtons();
      graf = requestAnimationFrame(gtick);
    };
    const runSteps = (auto: boolean) => {
      if (gameOver) return;
      if (!gen) gameReset();
      autoplay = auto; grun = true; setButtons();
      graf = requestAnimationFrame(gtick);
    };
    nextBtn.addEventListener('click', () => runSteps(false));
    allBtn.addEventListener('click', () => { if (grun && autoplay) stopGame(); else runSteps(true); });
    q<HTMLButtonElement>('[data-fr-restart]').addEventListener('click', () => { naive.wc = null; gameReset(); });
    const replay = () => {
      if (!shown) return;
      cancelAnimationFrame(rraf);
      replayNow = 0; let last = 0;
      const step = (ts: number) => {
        if (!visible()) { replayNow = Infinity; draw(); return; }
        if (last) replayNow += ((ts - last) / 1000) * (H / 8);
        last = ts;
        draw();
        if (replayNow < H) rraf = requestAnimationFrame(step); else { replayNow = Infinity; draw(); }
      };
      rraf = requestAnimationFrame(step);
    };
    q<HTMLButtonElement>('[data-fr-replay]').addEventListener('click', replay);

    /* ------------------------------------------------ mode and controls */
    const setMode = (m: 'play' | 'game') => {
      mode = m;
      root.querySelectorAll<HTMLButtonElement>('[data-fr-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.frMode === m)));
      root.querySelectorAll<HTMLElement>('[data-fr-only]').forEach((el) => (el.hidden = el.dataset.frOnly !== m));
      hint.textContent = m === 'play' ? T.hintPlay : T.hintGame;
      canvas.style.cursor = m === 'play' ? 'crosshair' : 'default';
      if (m === 'play') { stopGame(); cancelAnimationFrame(rraf); replayNow = Infinity; status(); }
      else { stopPlay(); startBtn.textContent = T.start; if (!naive.wc) gameReset(); else { plotRounds(); fillTable(); renderGame(); setButtons(); } }
      draw();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-fr-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.frMode as 'play' | 'game')));
    const outputs = () => {
      q<HTMLOutputElement>('[data-fr-vout]').textContent = `${vIn.value} m/s`;
      q<HTMLOutputElement>('[data-fr-dout]').textContent = `${compass[Math.round(+dIn.value / 45) % 8]}`;
      q<HTMLOutputElement>('[data-fr-bout]').textContent = `${bIn.value} × 500 m`;
    };
    vIn.addEventListener('input', () => {
      outputs();
      if (mode === 'play') { if (t && !finished) recompute(); draw(); status(); }
      else { naive.wc = null; gameReset(); }
    });
    dIn.addEventListener('input', () => { outputs(); if (t && !finished) recompute(); draw(); status(); });
    bIn.addEventListener('input', () => { outputs(); naive.wc = null; gameReset(); });

    window.addEventListener('themechange', () => { draw(); plotRounds(); renderGame(); });
    new ResizeObserver(() => { if (resize()) draw(); }).observe(canvas);
    root.addEventListener('eng:show', () => { if (resize()) draw(); });

    outputs(); resize(); setMode('play'); status(); draw();
    void HOUSE_WEIGHT;
  }

  document.querySelectorAll<HTMLElement>('[data-eng-tab="fire"]').forEach((root) => {
    let done = false;
    const start = () => { if (done) return; done = true; init(root); };
    root.addEventListener('eng:show', start, { once: true });
    if (!root.hidden) start();
  });
</script>

<style>
