  :global(:root[data-theme='dark']) .fr__sw--water { background: #27466f; }
  :global(:root[data-theme='dark']) .fr__sw--bare { background: #3a3935; }
  :global(:root[data-theme='dark']) .fr__sw--house { background: #e8e4dc; }
  :global(:root[data-theme='dark']) .fr__sw--burned { background: #141210; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .fr__sw--forest { background: #2f4833; }
    :global(:root:not([data-theme='light'])) .fr__sw--grass { background: #565b33; }
    :global(:root:not([data-theme='light'])) .fr__sw--water { background: #27466f; }
    :global(:root:not([data-theme='light'])) .fr__sw--bare { background: #3a3935; }
    :global(:root:not([data-theme='light'])) .fr__sw--house { background: #e8e4dc; }
    :global(:root:not([data-theme='light'])) .fr__sw--burned { background: #141210; }
  }
  .fr__h { font-size: var(--step--1); font-style: italic; margin-bottom: var(--s-2); text-align: center; }
  .fr__status { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 0.8rem; font-size: var(--step--1); margin: 0; }
  .fr__status dt { color: var(--ink-2); }
  .fr__status dd { margin: 0; text-align: right; font-family: var(--font-mono); font-size: 0.92em; }
  .fr__plot { min-width: 0; }
  .fr :global(.plot-key) { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.15rem 0.9rem; margin-top: 0.2rem; font-size: var(--step--2); color: var(--ink-2); line-height: 1.3; }
  .fr :global(.plot-key span) { display: inline-flex; align-items: center; gap: 0.35rem; }
  .fr :global(.plot-key svg) { width: 18px; height: 10px; flex: none; overflow: visible; }
  .fr__table { margin-top: var(--s-3); font-size: var(--step--2); }
  .fr__table th, .fr__table td { padding: 0.2em 0.4em 0.2em 0; }
  .fr__table td { text-align: right; font-family: var(--font-mono); }
  @media (max-width: 40rem) {
    .fr__grid { grid-template-columns: 1fr; }
  }
