  .fr__canvas { width: 100%; aspect-ratio: 1; display: block; touch-action: none; outline: 0.5px solid var(--ink-3); }
  .fr__hint { margin-top: var(--s-1); font-style: italic; font-size: var(--step--2); text-align: center; }
  .fr__legend { list-style: none; padding: 0; margin: 0.3rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.1rem 0.8rem; font-size: var(--step--2); color: var(--ink-2); }
  .fr__legend li { display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap; }
  .fr__sw { display: inline-block; width: 0.8em; height: 0.8em; outline: 0.5px solid var(--ink-3); }
  .fr__sw--forest { background: #7fa276; } .fr__sw--grass { background: #d3d9a4; } .fr__sw--water { background: #9db7dc; }
  .fr__sw--bare { background: #e4e0d6; } .fr__sw--house { background: #2a2a2a; } .fr__sw--burned { background: #4a423c; }
  .fr__sw--burning { background: var(--c-data); } .fr__sw--break { background: var(--c-learned); }
  :global(:root[data-theme='dark']) .fr__sw--forest { background: #2f4833; }
  :global(:root[data-theme='dark']) .fr__sw--grass { background: #565b33; }
