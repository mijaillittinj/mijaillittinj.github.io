---
/**
 * Mechanical and energy engineering tab of the homepage figure: flame emission tomography.
 * Forward: a camera records the soot emission integrated along each line of sight; part of
 * the light is reabsorbed by the soot on its way out (signal trapping).
 * Inverse: the spline-based Abel transform (SAT, Littin et al., Fuel 2024; pysat-abel)
 * recovers the local emission of one section, with or without the trapping correction.
 * Field: CoFlame simulation of the Gülder ethylene flame (Eaves et al., CPC 2016),
 * exported by scripts/export_coflame.py.
 */
import Equation from '../viz/Equation.astro';
import { url } from '../../i18n/utils';
interface Props { lang?: 'en' | 'es'; hidden?: boolean }
const { lang = 'en', hidden = false } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      fi: ['calcular lo que ve una cámara que mira a través de una llama axisimétrica: en cada píxel, la luz emitida por el hollín a lo largo de la línea de visión, parte de la cual se reabsorbe antes de salir de la llama (atrapamiento de señal).', 'recuperar, a partir de esa imagen, la emisión local en cada radio, una sección horizontal a la vez.'],
      obs: 'Imagen de la cámara', lat: 'Emisión local J', obsSub: 'señal integrada en la línea de visión', latSub: 'simulación CoFlame, radio ampliado ×2,5', op: 'integral de línea con absorción',
      section: 'Altura de la sección', noise: 'Ruido de medición', tau: 'Espesor óptico en el eje', lam: 'Suavizado, log₁₀ λ', knots: 'Tramos del spline',
      ign: 'Mostrar SAT sin corrección del atrapamiento', direct: 'Mostrar la inversión directa (pelado de cebolla)',
      leg: { obs: 'señal medida', truth: 'emisión verdadera J', sat: 'SAT con corrección', ign: 'SAT sin corrección', direct: 'inversión directa', pinn: 'PINN' }, x: 'r (mm)', y: 'normalizado',
      rd: { sat: 'SAT con corrección', ign: 'sin corrección', err: 'error cuadrático medio', ofPeak: 'del máximo', depth: 'espesor óptico en el eje', it: 'iteración', mis: 'desajuste', pinn: 'PINN', idle: 'Pulse «entrenar la PINN».' },
      method: 'Método', train: 'entrenar la PINN', stop: 'detener', lossLabel: 'La PINN minimiza',
      cap: [
        'La llama es una llama laminar de etileno (quemador de Gülder) calculada con',
        '; la emisión local se obtiene de su fracción volumétrica de hollín y su temperatura con la ley de Planck a 660 nm. Mueva la línea de sección o los controles: el gráfico compara el perfil verdadero con las reconstrucciones. La inversión directa amplifica el ruido, por eso la transformada de Abel basada en splines (SAT; Littin et al., Fuel 2024, publicada como',
        ') ajusta un spline suave e incluye la absorción en el modelo. Sin la corrección del atrapamiento, la emisión cerca del eje se subestima, y el error crece con el espesor óptico (alrededor de 0,2 en esta llama a 660 nm). La opción PINN corresponde al enfoque ANNAbel',
        ', que también considera el atrapamiento: una pequeña red neuronal describe J(r) y se entrena solo a través de la señal medida y del modelo de línea de visión con absorción.',
      ],
    }
  : {
      fi: ['compute what a camera sees when it looks through an axisymmetric flame: at each pixel, the light emitted by soot along the line of sight, part of which is reabsorbed before it leaves the flame (signal trapping).', 'recover the local emission at each radius from that image, one horizontal section at a time.'],
      obs: 'Camera image', lat: 'Local emission J', obsSub: 'line-of-sight signal', latSub: 'CoFlame simulation, radius stretched ×2.5', op: 'line-of-sight integral with absorption',
      section: 'Section height', noise: 'Measurement noise', tau: 'Optical depth on the axis', lam: 'Smoothing, log₁₀ λ', knots: 'Spline segments',
      ign: 'Show SAT without the trapping correction', direct: 'Show the direct inversion (onion peeling)',
      leg: { obs: 'measured signal', truth: 'true emission J', sat: 'SAT, corrected', ign: 'SAT, uncorrected', direct: 'direct inversion', pinn: 'PINN' }, x: 'r (mm)', y: 'normalised',
      rd: { sat: 'SAT, corrected', ign: 'uncorrected', err: 'RMS error', ofPeak: 'of peak', depth: 'optical depth on axis', it: 'iteration', mis: 'misfit', pinn: 'PINN', idle: 'Press “train the PINN”.' },
      method: 'Method', train: 'train the PINN', stop: 'stop', lossLabel: 'The PINN minimises',
      cap: [
        'The flame is a laminar ethylene flame (Gülder burner) computed with',
        '; its local emission follows from the simulated soot volume fraction and temperature through Planck’s law at 660 nm. Move the section line or the sliders: the plot compares the true profile with the reconstructions. Direct inversion amplifies noise, so the spline-based Abel transform (SAT; Littin et al., Fuel 2024, released as',
        ') fits a smooth spline and includes absorption in the model. Without the trapping correction, the emission near the axis is underestimated, and the error grows with optical depth (about 0.2 for this flame at 660 nm). The PINN option is the ANNAbel approach',
        ', which also accounts for trapping: a small neural network describes J(r) and is trained only through the measured signal and the absorbing line-of-sight model.',
      ],
    };
const client = { T };
---
<div class="eng-tab" data-eng-tab="mechanical" hidden={hidden} data-base={url('/data/coflame-gulder/')} data-text={JSON.stringify(client)}>
  <p class="eng-fi"><em>{es ? 'Directo' : 'Forward'}</em>: {T.fi[0]} <em>{es ? 'Inverso' : 'Inverse'}</em>: {T.fi[1]}</p>

  <div class="eng-switches">
    <div class="eng-switch"><span>{T.method}:</span>
      <div class="seg" role="group" aria-label={T.method}><button type="button" data-mt-m="sat" aria-pressed="true">SAT</button><button type="button" data-mt-m="pinn" aria-pressed="false">PINN</button></div>
    </div>
  </div>

  <div class="mt__panels">
    <div>
      <p class="panel-title">(a) {T.obs}</p>
      <div class="mt__frame" data-mt-frame><canvas data-mt-obs aria-hidden="true"></canvas><div class="mt__line" data-mt-line></div></div>
      <p class="mt__sub">{T.obsSub}</p>
    </div>
    <div class="mt__op" aria-hidden="true">
      <svg viewBox="0 0 64 24" width="64" height="24"><path d="M58 12H4m7-6-7 6 7 6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <span>{T.op}</span>
    </div>
    <div>
      <p class="panel-title">(b) {T.lat}</p>
      <div class="mt__frame" data-mt-frame><canvas data-mt-lat aria-hidden="true"></canvas><div class="mt__line" data-mt-line></div></div>
      <p class="mt__sub">{T.latSub}</p>
    </div>
  </div>
  <div class="mt__plot" data-mt-plot></div>

  <div class="eng-controls">
    <div class="control"><div class="control__head"><label for={`mt-z-${lang}`}>{T.section}</label><output data-mt-zout>—</output></div><input id={`mt-z-${lang}`} data-mt-z type="range" min="0" max="1" step="0.005" value="0.35" /></div>
    <div class="control"><div class="control__head"><label for={`mt-t-${lang}`}>{T.tau}</label><output data-mt-tout>—</output></div><input id={`mt-t-${lang}`} data-mt-tau type="range" min="0" max="2" step="0.05" value="0.8" /></div>
    <div class="control"><div class="control__head"><label for={`mt-n-${lang}`}>{T.noise}</label><output data-mt-nout>—</output></div><input id={`mt-n-${lang}`} data-mt-noise type="range" min="0" max="5" step="0.25" value="1" /></div>
    <div class="control"><div class="control__head"><label for={`mt-l-${lang}`}>{T.lam}</label><output data-mt-lout>—</output></div><input id={`mt-l-${lang}`} data-mt-lam type="range" min="-7" max="0" step="0.25" value="-4" /></div>
    <div class="control"><div class="control__head"><label for={`mt-k-${lang}`}>{T.knots}</label><output data-mt-kout>—</output></div><input id={`mt-k-${lang}`} data-mt-knots type="range" min="4" max="24" step="1" value="12" /></div>
  </div>
  <div class="eng-checks">
    <label><input type="checkbox" data-mt-ign checked /> {T.ign}</label>
    <label><input type="checkbox" data-mt-direct /> {T.direct}</label>
  </div>
  <p class="eng-actions" data-mt-pinnui hidden><button type="button" class="btn" data-mt-train>{T.train}</button></p>

  <Equation tex={String.raw`S(y) = \int_{-\ell(y)}^{\ell(y)} J(s)\, \exp\!\Big(-\int_{s}^{\ell(y)} \kappa\,\mathrm{d}s'\Big)\,\mathrm{d}s`} />
  <p class="eng-loss" data-mt-pinnui hidden>{T.lossLabel} <Equation display={false} tex={String.raw`\mathcal{L}(\theta) = \lVert T_\kappa J_\theta - S \rVert^2 / \lVert S \rVert^2`} /></p>
  <p class="lab__readout" data-mt-read aria-live="polite">&nbsp;</p>

  <p class="eng-cap">{T.cap[0]} <a href="https://doi.org/10.1016/j.cpc.2016.06.016">CoFlame (Eaves et al., 2016)</a>{T.cap[1]} <a href={url('/software/pysat-abel/')}><code>pysat-abel</code></a>{T.cap[2]} <a href="https://doi.org/10.1016/j.proci.2024.105493">(Escudero et al., 2024)</a>{T.cap[3]}</p>
</div>

<script>
  import { drawField, loadU8Field, viridis, LinePlot, type RGB, type Series } from '../../lib/plot';
  import { trappingMatrix, splineBasis, satSolve, sootEmission } from '../../lib/sat';
  import { chordMatrix } from '../../lib/abel';
  import { matvec, solveUpper, rng, type Mat } from '../../lib/linalg';
  import { initFlameNet, flameLossGrad, flameAdam, evalFlameNet, type FlameNet } from '../../lib/eng/pinn-flame';

  const STRETCH = 2.5; // radial display stretch (tall, thin flame)
  const P_HIDDEN = 32, P_STEPS = 6000, P_LR = 0.02, FRAME_MS = 7;

  const ink = (t: number): RGB => {
    const dark = document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const a: RGB = dark ? [18, 20, 23] : [251, 250, 247];
    const b: RGB = dark ? [235, 233, 228] : [21, 23, 28];
    t = Math.max(0, Math.min(1, t)) ** 0.85;
    return a.map((v, i) => Math.round(v + (b[i] - v) * t)) as RGB;
  };

  async function init(root: HTMLElement) {
    const { T } = JSON.parse(root.dataset.text!);
    const base = root.dataset.base!;
    const meta = await (await fetch(base + 'meta.json')).json();
    const { nz, nr } = meta;
    const fs = await loadU8Field(base + 'fs.u8', meta.fields.fs.min, meta.fields.fs.max);
    const Tk = await loadU8Field(base + 'T.u8', meta.fields.T.min, meta.fields.T.max);

    // local emission J (normalised) and absorption shape (∝ f_s)
    const J = new Float64Array(nz * nr);
    let jmax = 0;
    for (let k = 0; k < J.length; k++) { J[k] = sootEmission(fs[k], Tk[k]); jmax = Math.max(jmax, J[k]); }
    for (let k = 0; k < J.length; k++) J[k] /= jmax;
    const L = chordMatrix(nr, 1);
    // optical depth along the axis ray per unit absorption scale: Σ_k f_s,k L_0k
    let depthMax = 0;
    const depthRow = new Float64Array(nz);
    for (let j = 0; j < nz; j++) {
      let s = 0;
      for (let k = 0; k < nr; k++) s += fs[j * nr + k] * L.a[k];
      depthRow[j] = s; depthMax = Math.max(depthMax, s);
    }

    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const cObs = $<HTMLCanvasElement>('[data-mt-obs]'), cLat = $<HTMLCanvasElement>('[data-mt-lat]');
    const aspect = (STRETCH * 2 * meta.r_mm[1]) / (meta.z_mm[1] - meta.z_mm[0]);
    [cObs, cLat].forEach((c) => c.style.setProperty('--ar', String(aspect)));
    const lines = root.querySelectorAll<HTMLElement>('[data-mt-line]');
    const zIn = $<HTMLInputElement>('[data-mt-z]'), tauIn = $<HTMLInputElement>('[data-mt-tau]'), nIn = $<HTMLInputElement>('[data-mt-noise]');
    const lamIn = $<HTMLInputElement>('[data-mt-lam]'), kIn = $<HTMLInputElement>('[data-mt-knots]');
    const ignBox = $<HTMLInputElement>('[data-mt-ign]'), dirBox = $<HTMLInputElement>('[data-mt-direct]');
    const read = $<HTMLElement>('[data-mt-read]');
    const plot = new LinePlot($<HTMLElement>('[data-mt-plot]'), { width: 560, height: 250, xlabel: T.x, ylabel: T.y, title: 'Section' });
    const xmm = Array.from({ length: nr }, (_, i) => ((i + 0.5) / nr) * meta.r_mm[1]);

    let obs = new Float64Array(nz * nr), omax = 1, row = 0;
    const Trow: Mat[] = [];
    const kappaOf = (j: number) => {
      const s = +tauIn.value / (depthMax || 1);
      return Float64Array.from(fs.subarray(j * nr, (j + 1) * nr), (f) => s * f);
    };
    const forward = () => {
      const R = rng(11), noise = +nIn.value / 100;
      obs = new Float64Array(nz * nr);
      for (let j = 0; j < nz; j++) {
        Trow[j] = trappingMatrix(nr, kappaOf(j));
        const g = matvec(Trow[j], J.subarray(j * nr, (j + 1) * nr));
        obs.set(g, j * nr);
      }
      omax = 0;
      for (const v of obs) omax = Math.max(omax, v);
      for (let k = 0; k < obs.length; k++) obs[k] += noise * omax * R.normal();
    };
    const paint = () => {
      drawField(cLat, J, { nx: nr, ny: nz, mirror: true, cmap: viridis, vmin: 0, vmax: 1 });
      drawField(cObs, obs, { nx: nr, ny: nz, mirror: true, cmap: ink, vmin: 0, vmax: omax * 1.02 });
    };
    const rms = (a: ArrayLike<number>, b: ArrayLike<number>, scale: number) => {
      let e = 0;
      for (let i = 0; i < nr; i++) e += (a[i] - b[i]) ** 2;
      return (Math.sqrt(e / nr) / scale) * 100;
    };
    // PINN state
    const rr = Float64Array.from({ length: nr }, (_, i) => (i + 0.5) / nr);
    let method: 'sat' | 'pinn' = 'sat';
    let net: FlameNet | null = null, iter = 0, pLoss = NaN, running = false, trainedOnce = false, praf = 0;
    const trainBtn = $<HTMLButtonElement>('[data-mt-train]');
    const solve = () => {
      const f = J.subarray(row * nr, (row + 1) * nr), g = obs.subarray(row * nr, (row + 1) * nr);
      const fm = Math.max(...f, 0.2), gm = Math.max(...g, 0.2 * omax);
      const B = splineBasis(nr, +kIn.value), lam = 10 ** +lamIn.value;
      const sat = satSolve(Trow[row], g, B, lam);
      const px: number[] = [], py: number[] = [];
      for (let i = 0; i < nr; i += 2) { px.push(xmm[i]); py.push(g[i] / gm); }
      const series: Series[] = [
        { kind: 'points', x: px, y: py, cls: 's-data', label: T.leg.obs },
        { kind: 'line', x: xmm, y: Array.from(f, (v) => v / fm), cls: 's-truth', label: T.leg.truth },
      ];
      let msg = `${T.rd.sat}: ${T.rd.err} ${rms(sat, f, fm).toFixed(1)} % ${T.rd.ofPeak}`;
      if (ignBox.checked) {
        const ign = satSolve(L, g, B, lam);
        series.push({ kind: 'line', x: xmm, y: Array.from(ign, (v) => v / fm), cls: 's-muted', dash: true, label: T.leg.ign });
        msg += ` · ${T.rd.ign}: ${rms(ign, f, fm).toFixed(1)} %`;
      }
      if (dirBox.checked) {
        const d = solveUpper(L, g);
        series.push({ kind: 'line', x: xmm, y: Array.from(d, (v) => Math.max(-0.5, Math.min(1.7, v / fm))), cls: 's-warn', dash: true, label: T.leg.direct });
      }
      const tauAxis = (+tauIn.value * depthRow[row]) / (depthMax || 1);
      if (method === 'pinn') {
        series.push({ kind: 'line', x: xmm, y: Array.from(sat, (v) => v / fm), cls: 's-physics', label: T.leg.sat });
        if (net) {
          const pf = evalFlameNet(net, rr);
          series.push({ kind: 'line', x: xmm, y: Array.from(pf, (v) => v / fm), cls: 's-learned', label: T.leg.pinn });
          read.textContent = `${T.rd.pinn}: ${T.rd.it} ${iter} · ${T.rd.mis} ${pLoss.toExponential(1)} · ${T.rd.err} ${rms(pf, f, fm).toFixed(1)} % ${T.rd.ofPeak} · SAT ${rms(sat, f, fm).toFixed(1)} %`;
        } else read.textContent = T.rd.idle;
      } else {
        series.push({ kind: 'line', x: xmm, y: Array.from(sat, (v) => v / fm), cls: 's-learned', label: T.leg.sat });
        read.textContent = `${msg} · ${T.rd.depth}: ${tauAxis.toFixed(2)}`;
      }
      plot.render(series, { ylim: [-0.15, 1.3], xlim: [0, meta.r_mm[1]] });
    };
    const outputs = () => {
      $<HTMLOutputElement>('[data-mt-tout]').textContent = (+tauIn.value).toFixed(2);
      $<HTMLOutputElement>('[data-mt-nout]').textContent = `${nIn.value} %`;
      $<HTMLOutputElement>('[data-mt-lout]').textContent = (+lamIn.value).toFixed(2);
      $<HTMLOutputElement>('[data-mt-kout]').textContent = kIn.value;
    };
    const setRow = (t: number) => {
      row = Math.max(0, Math.min(nz - 1, Math.round(t * (nz - 1))));
      lines.forEach((l) => (l.style.bottom = `${(row / (nz - 1)) * 100}%`));
      $<HTMLOutputElement>('[data-mt-zout]').textContent = `z = ${(meta.z_mm[0] + ((meta.z_mm[1] - meta.z_mm[0]) * row) / (nz - 1)).toFixed(1)} mm`;
    };
    const stopP = () => { running = false; cancelAnimationFrame(praf); trainBtn.textContent = T.train; };
    const loop = () => {
      if (!running || !net) return;
      if (root.hidden) { stopP(); return; }
      const g = obs.subarray(row * nr, (row + 1) * nr);
      const t0 = performance.now();
      while (iter < P_STEPS && performance.now() - t0 < FRAME_MS) {
        const r = flameLossGrad(net, Trow[row], rr, g);
        pLoss = r.loss; flameAdam(net, r.grad, P_LR); iter++;
      }
      solve();
      if (iter >= P_STEPS) { stopP(); return; }
      praf = requestAnimationFrame(loop);
    };
    const train = () => {
      stopP();
      net = initFlameNet(P_HIDDEN, 5); iter = 0; pLoss = NaN;
      running = true; trainedOnce = true; trainBtn.textContent = T.stop;
      praf = requestAnimationFrame(loop);
    };
    let retrain = 0;
    const resetP = () => {
      stopP(); net = null;
      if (method === 'pinn' && trainedOnce) { clearTimeout(retrain); retrain = window.setTimeout(train, 250); }
    };
    let pending = 0;
    const schedule = (full: boolean, affectsData = true) => {
      if (affectsData) resetP();
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(() => { outputs(); if (full) { forward(); paint(); } solve(); });
    };

    zIn.addEventListener('input', () => { setRow(+zIn.value); schedule(false); });
    [tauIn, nIn].forEach((el) => el.addEventListener('input', () => schedule(true)));
    [lamIn, kIn].forEach((el) => el.addEventListener('input', () => schedule(false, false)));
    [ignBox, dirBox].forEach((el) => el.addEventListener('change', () => schedule(false, false)));
    trainBtn.addEventListener('click', () => (running ? stopP() : train()));
    root.querySelectorAll<HTMLButtonElement>('[data-mt-m]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.mtM as 'sat' | 'pinn';
      root.querySelectorAll<HTMLButtonElement>('[data-mt-m]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      root.querySelectorAll<HTMLElement>('[data-mt-pinnui]').forEach((e) => (e.hidden = method !== 'pinn'));
      if (method === 'sat') stopP();
      solve();
    }));
    root.querySelectorAll<HTMLElement>('[data-mt-frame]').forEach((fr) => fr.addEventListener('pointermove', (e) => {
      const b = fr.getBoundingClientRect();
      zIn.value = String(Math.max(0, Math.min(1, 1 - (e.clientY - b.top) / b.height)));
      setRow(+zIn.value); schedule(false);
    }));
    window.addEventListener('themechange', paint);

    outputs(); forward(); paint(); setRow(+zIn.value); solve();
    lines.forEach((l) => (l.style.opacity = '0.7'));
  }

  document.querySelectorAll<HTMLElement>('[data-eng-tab="mechanical"]').forEach((root) => {
    let done = false;
    const go = () => { if (done) return; done = true; init(root).catch((e) => console.warn('mechanical tab', e)); };
    root.addEventListener('eng:show', go);
    if (!root.hidden) go();
  });
</script>

<style>
  .mt__panels { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: var(--s-3); max-width: 30rem; margin-inline: auto; }
  .mt__frame { position: relative; aspect-ratio: 2 / 3; overflow: hidden; }
  .mt__frame canvas { position: absolute; top: 0; left: 50%; height: 100%; width: auto; aspect-ratio: var(--ar, 0.4); transform: translateX(-50%); outline: 0.5px solid var(--ink-3); background: var(--paper); }
  .mt__line { position: absolute; left: 0; right: 0; height: 0; border-top: 1px dashed var(--ink); opacity: 0; pointer-events: none; }
  .mt__sub { margin-top: 0.3rem; font-size: var(--step--2); text-align: center; font-style: italic; color: var(--ink-3); }
  .mt__op { align-self: center; display: grid; justify-items: center; gap: 0.25rem; color: var(--ink-2); font-style: italic; font-size: var(--step--1); text-align: center; max-width: 7rem; line-height: 1.25; }
  .mt__plot { min-width: 0; min-height: 14rem; margin-top: var(--s-4); }
  @media (max-width: 34rem) {
    .mt__op span { display: none; }
    .mt__op svg { width: 28px; }
    .mt__sub { display: none; }
    .mt__panels .panel-title { min-height: 2.6em; }
  }
</style>
