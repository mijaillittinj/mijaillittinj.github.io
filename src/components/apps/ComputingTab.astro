---
/**
 * Computing tab, two examples behind an "Example" switch.
 * 1. Image deblurring (computational imaging). Forward: a sharp image is blurred by a
 *    known point-spread function and noise is added. Inverse: Fourier deconvolution
 *    (inverse filter, Tikhonov/Wiener), Richardson–Lucy, or a physics-informed neural
 *    field (src/lib/eng/deblur.ts, pinn-image.ts). The test image (the letters "UC" and a
 *    football) is drawn in the browser.
 * 2. Trustworthy AI: deep ensembles and split conformal prediction on a damped oscillator
 *    observed with a gap, plain vs physics-informed ensembles (src/lib/eng/trust.ts).
 *    Lazily initialised on first selection.
 */
import Equation from '../viz/Equation.astro';
interface Props { lang?: 'en' | 'es'; hidden?: boolean }
const { lang = 'en', hidden = false } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      fwd: 'Directo', inv: 'Inverso',
      fi: [': una imagen nítida se desenfoca por el movimiento de la cámara, descrito por una función de dispersión de punto conocida, y se le agrega ruido. ', ': recuperar la imagen nítida a partir de la foto borrosa.'],
      pObs: '(a) Foto borrosa', pRec: '(b) Reconstrucción', pTrue: '(c) Original', hidden: 'oculta',
      pPsf: 'núcleo h', pSpec: '|H| (escala log)',
      len: 'Movimiento', ang: 'Ángulo', noise: 'Ruido', method: 'Método',
      mInv: 'filtro inverso', mTik: 'Tikhonov (Wiener)', mRl: 'Richardson–Lucy', mPinn: 'PINN',
      train: 'entrenar la PINN', stop: 'detener', lossLabel: 'La PINN minimiza',
      rdPinn: 'la red ve la foto solo a través del modelo de desenfoque', rdPinnIdle: 'Pulse «entrenar la PINN».', rdTikRef: 'Tikhonov con el λ actual',
      pinnCap: ' Versión PINN: una red neuronal representa la imagen nítida como una función suave de las coordenadas del píxel (construida con filtros sinusoidales y con valores entre 0 y 1), y se entrena solo comparando su versión desenfocada, h ∗ f, con la foto. Nunca ve la original. En este ejemplo suele superar a Tikhonov en PSNR porque su salida favorece imágenes casi en blanco y negro, como esta; con otras escenas esa ventaja puede desaparecer.',
      lam: 'log₁₀ λ (Tikhonov)', run: 'iterar', reveal: 'revelar la original', hide: 'ocultar la original',
      rdBlur: 'foto borrosa', rdRec: 'reconstrucción', rdIt: 'iteración',
      rdInv: 'el ruido estalla donde |H| ≈ 0 (franjas oscuras del espectro)',
      rdTik: 'λ mayor: más estable, menos nítida',
      rdRl: 'demasiadas iteraciones devuelven el ruido',
      exLabel: 'Ejemplo', exDeblur: 'restauración de imágenes', exTrust: 'IA confiable',
      credit: ' Imagen de prueba: las letras UC y un balón de fútbol, dibujados en el navegador.',
      tr: {
        fi: [': una red neuronal entrenada predice y a partir de x. ', ': a partir de pocas mediciones con ruido, aprender el modelo y hasta dónde se puede confiar en cada predicción.'],
        method: 'Método', mNn: 'red neuronal', mPinn: 'PINN', coverage: 'Cobertura objetivo', noise: 'Ruido de medición', members: 'Mostrar los cinco miembros',
        train: 'entrenar el conjunto', stop: 'detener', newData: 'nuevos datos',
        x: 'x (tiempo)', y: 'y (desplazamiento)', plot: 'Predicción y bandas de incertidumbre',
        leg: { train: 'datos de entrenamiento', calib: 'calibración', truth: 'proceso verdadero', mean: 'media del conjunto', band: 'banda conforme', ood: 'los modelos discrepan' },
        idle: 'Pulse «entrenar el conjunto». No hay datos en el hueco (x = 3,0–6,4) ni más allá de x = 7,4.',
        it: 'iteración', band: 'banda conforme ±', target: 'objetivo', cov: 'cobertura', covData: 'zona con datos', covGap: 'hueco', covExtra: 'más allá de los datos', ood: 'los modelos discrepan en', ofAxis: 'del eje', gapErr: 'error RMS en el hueco',
        lessonNn: 'sombreado rojo: los miembros discrepan; en el hueco coinciden en una curva equivocada, así que el acuerdo no es una prueba',
        lessonPinn: 'los miembros coinciden en la curva correcta en todo el eje',
        lossLabel: 'Cada miembro minimiza',
        cap: 'El gráfico muestra mediciones con ruido de una oscilación amortiguada, con un hueco en el medio y sin datos más allá de x = 7,4. Cinco redes neuronales pequeñas (un conjunto o ensemble) se entrenan con los mismos datos desde puntos de partida aleatorios distintos; la curva violeta es su media. Donde discrepan mucho (sombreado rojo), la predicción es incierta: son entradas alejadas de los datos de entrenamiento, fuera de distribución. La banda proviene de la predicción conforme por partición: una parte de los datos se reserva para calibrar, y la banda se ensancha hasta contener la fracción elegida de esos puntos (la cobertura). Esa garantía vale solo para datos nuevos parecidos a los de calibración: en el hueco y más allá de los datos la cobertura se desploma. En la versión PINN, la ecuación del oscilador forma parte de la función de pérdida de cada red; los miembros coinciden entonces en la curva correcta donde no hay datos, y la banda conserva su cobertura. En este sentido, una IA confiable cuantifica su incertidumbre, comprueba la cobertura y reconoce las entradas que nunca ha visto. Ejemplo sintético.',
      },
      cap: 'El panel (a) es una foto desenfocada por el movimiento de la cámara, con ruido; (b) es la reconstrucción; (c), oculta hasta que la revele, es la original. Los recuadros pequeños muestran el núcleo de desenfoque h (la función de dispersión de punto: la imagen de un único punto brillante) y la magnitud de su transformada de Fourier |H|. Desenfocar es una convolución: cada píxel de la foto mezcla muchos píxeles de la escena. En el dominio de Fourier la convolución se vuelve un producto, G = H F, de modo que deshacerla parece una simple división por H; pero H es casi cero en algunas frecuencias (las franjas oscuras) y dividir por ella amplifica el ruido, como muestra el filtro inverso. El filtro de Tikhonov (Wiener) suma λ al denominador, y el método de Richardson–Lucy mejora la imagen iterativamente y se detiene a tiempo; ambos cambian nitidez por estabilidad. La PSNR (relación señal-ruido de pico, en decibelios) mide cuánto se parece la reconstrucción a la original: más es mejor.',
    }
  : {
      fwd: 'Forward', inv: 'Inverse',
      fi: [': a sharp image is blurred by camera motion, described by a known point-spread function, and noise is added. ', ': recover the sharp image from the blurred photo.'],
      pObs: '(a) Blurred photo', pRec: '(b) Reconstruction', pTrue: '(c) Original', hidden: 'hidden',
      pPsf: 'kernel h', pSpec: '|H| (log scale)',
      len: 'Motion length', ang: 'Angle', noise: 'Noise', method: 'Method',
      mInv: 'inverse filter', mTik: 'Tikhonov (Wiener)', mRl: 'Richardson–Lucy', mPinn: 'PINN',
      train: 'train the PINN', stop: 'stop', lossLabel: 'The PINN minimises',
      rdPinn: 'the network sees the photo only through the blur model', rdPinnIdle: 'Press “train the PINN”.', rdTikRef: 'Tikhonov at the current λ',
      pinnCap: ' PINN version: a neural network represents the sharp image as a smooth function of the pixel coordinates (built from sinusoidal filters, with values between 0 and 1), and it is trained only by comparing its blurred version, h ∗ f, with the photo. It never sees the original. In this example it usually beats Tikhonov in PSNR because its output favours nearly black-and-white images such as this one; with other scenes that advantage can disappear.',
      lam: 'log₁₀ λ (Tikhonov)', run: 'iterate', reveal: 'reveal the original', hide: 'hide the original',
      rdBlur: 'blurred photo', rdRec: 'reconstruction', rdIt: 'iteration',
      rdInv: 'the noise explodes where |H| ≈ 0 (dark bands of the spectrum)',
      rdTik: 'larger λ: more stable, less sharp',
      rdRl: 'too many iterations bring the noise back',
      exLabel: 'Example', exDeblur: 'image deblurring', exTrust: 'trustworthy AI',
      credit: ' Test image: the letters UC and a football, drawn in the browser.',
      tr: {
        fi: [': a trained neural network predicts y from x. ', ': from a few noisy measurements, learn the model and how far each prediction can be trusted.'],
        method: 'Method', mNn: 'neural network', mPinn: 'PINN', coverage: 'Target coverage', noise: 'Measurement noise', members: 'Show the five members',
        train: 'train the ensemble', stop: 'stop', newData: 'new data',
        x: 'x (time)', y: 'y (displacement)', plot: 'Prediction and uncertainty bands',
        leg: { train: 'training data', calib: 'calibration', truth: 'true process', mean: 'ensemble mean', band: 'conformal band', ood: 'models disagree' },
        idle: 'Press “train the ensemble”. There are no data in the gap (x = 3.0–6.4) or beyond x = 7.4.',
        it: 'iteration', band: 'conformal band ±', target: 'target', cov: 'coverage', covData: 'observed region', covGap: 'gap', covExtra: 'beyond the data', ood: 'models disagree on', ofAxis: 'of the axis', gapErr: 'RMS error in the gap',
        lessonNn: 'red shading: the members disagree; in the gap they agree on a wrong curve, so agreement is not proof',
        lessonPinn: 'the members agree on the correct curve along the whole axis',
        lossLabel: 'Each member minimises',
        cap: 'The plot shows noisy measurements of a damped oscillation, with a gap in the middle and no data beyond x = 7.4. Five small neural networks (an ensemble) are trained on the same data from different random starting points; the violet curve is their mean. Where they disagree strongly (red shading), the prediction is uncertain: these inputs are far from the training data, or out of distribution. The band comes from split conformal prediction: part of the data is set aside for calibration, and the band is widened until it contains the chosen fraction of those points (the coverage). That guarantee holds only for new data that resemble the calibration set: in the gap and beyond the data the coverage collapses. In the PINN version the oscillator equation is part of each network’s loss; the members then agree on the correct curve where there are no data, and the band keeps its coverage. In this sense, trustworthy AI quantifies its uncertainty, checks its coverage and recognises inputs it has never seen. Synthetic example.',
      },
      cap: 'Panel (a) is a photo blurred by camera motion, with noise; (b) is the reconstruction; (c), hidden until you reveal it, is the original. The small insets show the blur kernel h (the point-spread function: the image of a single bright point) and the magnitude of its Fourier transform |H|. Blurring is a convolution: every pixel of the photo mixes many pixels of the scene. In the Fourier domain a convolution becomes a product, G = H F, so undoing it looks like a simple division by H; but H is nearly zero at some frequencies (the dark bands), and dividing by it amplifies the noise, as the inverse filter shows. The Tikhonov (Wiener) filter adds λ to the denominator, and the Richardson–Lucy method improves the image iteratively and is stopped early; both trade sharpness for stability. PSNR (peak signal-to-noise ratio, in decibels) measures how close the reconstruction is to the original: higher is better.',
    };
const client = { lang, T };
---
<div class="eng-tab cp" data-eng-tab="computing" hidden={hidden} data-cp-text={JSON.stringify(client)}>
  <div class="eng-switches">
    <div class="eng-switch"><span>{T.exLabel}:</span>
      <div class="seg" role="group" aria-label={T.exLabel}>
        <button type="button" data-cp-ex-btn="deblur" aria-pressed="true">{T.exDeblur}</button>
        <button type="button" data-cp-ex-btn="trust" aria-pressed="false">{T.exTrust}</button>
      </div>
    </div>
  </div>

  <div data-cp-ex="deblur">
  <p class="eng-fi"><em>{T.fwd}</em>{T.fi[0]}<em>{T.inv}</em>{T.fi[1]}</p>

  <div class="eng-switches">
    <div class="eng-switch"><span>{T.method}:</span>
    <div class="seg" role="group" aria-label={T.method}>
      <button type="button" data-cp-m="inv" aria-pressed="false">{T.mInv}</button>
      <button type="button" data-cp-m="tik" aria-pressed="true">{T.mTik}</button>
      <button type="button" data-cp-m="rl" aria-pressed="false">{T.mRl}</button>
      <button type="button" data-cp-m="pinn" aria-pressed="false">{T.mPinn}</button>
    </div>
    </div>
  </div>

  <div class="cp__panels">
    <figure class="cp__p"><p class="panel-title">{T.pObs}</p><canvas data-cp-obs width="128" height="128" aria-hidden="true"></canvas></figure>
    <figure class="cp__p"><p class="panel-title">{T.pRec}</p><canvas data-cp-rec width="128" height="128" aria-hidden="true"></canvas></figure>
    <figure class="cp__p"><p class="panel-title">{T.pTrue}</p><div class="cp__truth"><canvas data-cp-true width="128" height="128" aria-hidden="true"></canvas><span class="cp__veil" data-cp-veil>?<small>{T.hidden}</small></span></div></figure>
  </div>
  <div class="cp__small">
    <figure><canvas data-cp-psf width="33" height="33" aria-hidden="true"></canvas><figcaption>{T.pPsf}</figcaption></figure>
    <figure><canvas data-cp-spec width="128" height="128" aria-hidden="true"></canvas><figcaption>{T.pSpec}</figcaption></figure>
  </div>

  <div class="eng-controls cp__four">
    <div class="control">
      <div class="control__head"><label for={`cp-len-${lang}`}>{T.len}</label><output data-cp-lout>15 px</output></div>
      <input id={`cp-len-${lang}`} data-cp-len type="range" min="0" max="30" step="1" value="15" />
    </div>
    <div class="control">
      <div class="control__head"><label for={`cp-ang-${lang}`}>{T.ang}</label><output data-cp-aout>20°</output></div>
      <input id={`cp-ang-${lang}`} data-cp-ang type="range" min="0" max="180" step="5" value="20" />
    </div>
    <div class="control">
      <div class="control__head"><label for={`cp-noise-${lang}`}>{T.noise}</label><output data-cp-nout>1.0 %</output></div>
      <input id={`cp-noise-${lang}`} data-cp-noise type="range" min="0" max="5" step="0.1" value="1" />
    </div>
    <div class="control" data-cp-only="tik">
      <div class="control__head"><label for={`cp-lam-${lang}`}>{T.lam}</label><output data-cp-lamout>−3.0</output></div>
      <input id={`cp-lam-${lang}`} data-cp-lam type="range" min="-6" max="0" step="0.1" value="-3" />
    </div>
  </div>
  <p class="eng-actions">
    <button type="button" class="btn" data-cp-run data-cp-only="rl" hidden>{T.run}</button>
      <button type="button" class="btn" data-cp-train data-cp-only="pinn" hidden>{T.train}</button>
      <button type="button" class="btn" data-cp-reveal>{T.reveal}</button>
    </p>

  <div class="eng-eqs">
    <Equation tex={String.raw`g = h * f + \varepsilon \;\;\Longleftrightarrow\;\; G = H\,F + E`} />
    <Equation tex={String.raw`\hat F = \frac{\overline{H}\,G}{|H|^2 + \lambda}`} />
  </div>
  <p class="eng-loss" data-cp-only="pinn" hidden>{T.lossLabel} <Equation display={false} tex={String.raw`\mathcal{L}(\theta) = \tfrac{1}{N^2}\lVert h * f_\theta - g \rVert^2 + \mu \lVert A \rVert^2`} /></p>
  <p class="lab__readout" data-cp-read aria-live="polite"></p>
  <p class="eng-cap">{T.cap}{T.pinnCap}{T.credit}</p>
  </div>

  <div data-cp-ex="trust" hidden>
    <p class="eng-fi"><em>{T.fwd}</em>{T.tr.fi[0]}<em>{T.inv}</em>{T.tr.fi[1]}</p>
    <div class="eng-switches">
      <div class="eng-switch"><span>{T.tr.method}:</span>
      <div class="seg" role="group" aria-label={T.tr.method}>
        <button type="button" data-tr-m="nn" aria-pressed="true">{T.tr.mNn}</button>
        <button type="button" data-tr-m="pinn" aria-pressed="false">{T.tr.mPinn}</button>
      </div>
      </div>
    </div>
    <div class="tr__plot" data-tr-plot></div>
    <p class="tr__key">
      <span><span class="tr__dot c-data">●</span>{T.tr.leg.train}</span>
      <span><span class="tr__dot muted">●</span>{T.tr.leg.calib}</span>
      <span><span class="key key--truth tr__dash"></span>{T.tr.leg.truth}</span>
      <span><span class="key key--learned"></span>{T.tr.leg.mean}</span>
      <span><span class="tr__sw tr__sw--band"></span>{T.tr.leg.band}</span>
      <span><span class="tr__sw tr__sw--ood"></span>{T.tr.leg.ood}</span>
    </p>
    <div class="eng-controls">
      <div class="control">
        <div class="control__head"><label for={`tr-cov-${lang}`}>{T.tr.coverage}</label><output data-tr-covout>90 %</output></div>
        <input id={`tr-cov-${lang}`} data-tr-cov type="range" min="0.8" max="0.95" step="0.01" value="0.9" />
      </div>
      <div class="control">
        <div class="control__head"><label for={`tr-noise-${lang}`}>{T.tr.noise}</label><output data-tr-nout>0.05</output></div>
        <input id={`tr-noise-${lang}`} data-tr-noise type="range" min="0.01" max="0.15" step="0.01" value="0.05" />
      </div>
    </div>
    <div class="eng-checks"><label><input type="checkbox" data-tr-members checked /> {T.tr.members}</label></div>
    <p class="eng-actions">
        <button type="button" class="btn" data-tr-train>{T.tr.train}</button>
        <button type="button" class="btn" data-tr-new>{T.tr.newData}</button>
      </p>
    <div class="eng-eqs">
      <Equation tex={String.raw`y'' + 2\zeta\omega\,y' + \omega^2 y = 0`} />
      <Equation tex={String.raw`C(x) = \bar u(x) \pm \hat q`} />
      <Equation tex={String.raw`\hat q = Q_{\lceil (n+1)(1-\alpha)\rceil / n}\big\{\lvert y_i - \bar u(x_i)\rvert\big\}`} />
    </div>
    <p class="eng-loss">{T.tr.lossLabel} <Equation display={false} tex={String.raw`\mathcal{L}(\theta_m) = \overline{(u_{\theta_m} - y_i)^2} + \lambda\,\overline{\big(u_{\theta_m}'' + 2\zeta\omega u_{\theta_m}' + \omega^2 u_{\theta_m}\big)^2}`} /> <span data-tr-lossnote></span></p>
    <p class="lab__readout" data-tr-read aria-live="polite">{T.tr.idle}</p>
    <p class="eng-cap">{T.tr.cap}</p>
  </div>
</div>

<script>
  import { motionPsf, blur, tikhonov, richardsonLucyStep, psnr, fft2, type Spec } from '../../lib/eng/deblur';
  import { initImageNet, makeImageTrainer } from '../../lib/eng/pinn-image';
  import * as TR from '../../lib/eng/trust';
  import { LinePlot, type Series } from '../../lib/plot';

  const N = 128, RL_MAX = 120, RL_PER_FRAME = 3, PINN_STEPS = 500, FRAME_MS = 8;

  /**
   * The sharp scene, drawn once in the browser: the letters "UC" next to a football,
   * the forward model, bars and a checker block.
   */
  function scene(): Float64Array {
    const c = document.createElement('canvas');
    c.width = N; c.height = N;
    const x = c.getContext('2d')!;
    x.fillStyle = '#fff'; x.fillRect(0, 0, N, N);
    // letters UC
    x.fillStyle = '#111';
    x.textAlign = 'center'; x.textBaseline = 'middle';
    x.font = 'bold 34px Georgia, "Times New Roman", serif';
    x.fillText('UC', 35, 38);
    // football: white disc, central black pentagon, seams to five clipped outer pentagons
    const bx = 96, by = 36, r = 27;
    const pent = (cx: number, cy: number, rad: number, rot: number) => {
      x.beginPath();
      for (let k = 0; k < 5; k++) {
        const a = rot + (2 * Math.PI * k) / 5;
        x.lineTo(cx + rad * Math.cos(a), cy + rad * Math.sin(a));
      }
      x.closePath();
    };
    x.save();
    x.beginPath(); x.arc(bx, by, r, 0, 2 * Math.PI); x.clip();
    x.fillStyle = '#fff'; x.fillRect(bx - r, by - r, 2 * r, 2 * r);
    x.fillStyle = '#111'; x.strokeStyle = '#111'; x.lineWidth = 2;
    const up = -Math.PI / 2, rc = r * 0.34;
    pent(bx, by, rc, up); x.fill();
    for (let k = 0; k < 5; k++) {
      const a = up + (2 * Math.PI * k) / 5, ca = Math.cos(a), sa = Math.sin(a);
      x.beginPath();
      x.moveTo(bx + rc * ca, by + rc * sa);
      x.lineTo(bx + r * 0.68 * ca, by + r * 0.68 * sa);
      x.stroke();
      pent(bx + r * 0.98 * ca, by + r * 0.98 * sa, r * 0.32, a + Math.PI); x.fill();
    }
    x.restore();
    x.lineWidth = 2.5; x.beginPath(); x.arc(bx, by, r - 1, 0, 2 * Math.PI); x.stroke();
    // forward model, bars and checker block
    x.fillStyle = '#000';
    x.font = 'italic 14px Georgia, "Times New Roman", serif';
    x.fillText('g = h ∗ f + ε', N / 2, 80);
    for (let i = 0; i < 9; i++) x.fillRect(12 + i * 6, 92, 3, 32);
    for (let j = 0; j < 4; j++) for (let i = 0; i < 5; i++) if ((i + j) % 2 === 0) x.fillRect(76 + i * 8, 92 + j * 8, 8, 8);
    const d = x.getImageData(0, 0, N, N).data, f = new Float64Array(N * N);
    for (let i = 0; i < N * N; i++) f[i] = d[4 * i] / 255;
    return f;
  }

  function paint(cv: HTMLCanvasElement, img: ArrayLike<number>, n = N, lo = 0, hi = 1) {
    const x = cv.getContext('2d')!, im = x.createImageData(n, n);
    for (let i = 0; i < n * n; i++) {
      const v = Math.round(255 * Math.max(0, Math.min(1, (img[i] - lo) / (hi - lo || 1))));
      im.data[4 * i] = im.data[4 * i + 1] = im.data[4 * i + 2] = v; im.data[4 * i + 3] = 255;
    }
    x.putImageData(im, 0, 0);
  }

  function init(root: HTMLElement) {
    const { lang, T } = JSON.parse(root.dataset.cpText!);
    const exBox = root.querySelector<HTMLElement>('[data-cp-ex="deblur"]')!;
    const off = () => root.hidden || exBox.hidden;
    const nf = (v: number, d = 1) => (lang === 'es' ? v.toFixed(d).replace('.', ',') : v.toFixed(d)).replace('-', '−');
    const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const cObs = q<HTMLCanvasElement>('[data-cp-obs]'), cRec = q<HTMLCanvasElement>('[data-cp-rec]'), cTrue = q<HTMLCanvasElement>('[data-cp-true]');
    const cPsf = q<HTMLCanvasElement>('[data-cp-psf]'), cSpec = q<HTMLCanvasElement>('[data-cp-spec]');
    const lenIn = q<HTMLInputElement>('[data-cp-len]'), angIn = q<HTMLInputElement>('[data-cp-ang]'), noiseIn = q<HTMLInputElement>('[data-cp-noise]'), lamIn = q<HTMLInputElement>('[data-cp-lam]');
    const read = q<HTMLElement>('[data-cp-read]'), veil = q<HTMLElement>('[data-cp-veil]');
    const runBtn = q<HTMLButtonElement>('[data-cp-run]'), revealBtn = q<HTMLButtonElement>('[data-cp-reveal]');

    const f = scene();
    paint(cTrue, f);
    let method: 'inv' | 'tik' | 'rl' | 'pinn' = 'tik', revealed = false;
    const trainBtn = q<HTMLButtonElement>('[data-cp-train]');
    let trainer: ReturnType<typeof makeImageTrainer> | null = null, praf = 0, training = false, trainedOnce = false, lastF: Float64Array | null = null, lastData = NaN, tikRef = NaN;
    let h: Float64Array = new Float64Array(0), H: Spec | null = null, g: Float64Array = new Float64Array(0), rl: Float64Array | null = null, it = 0, raf = 0;

    const forward = () => {
      h = motionPsf(N, +lenIn.value, +angIn.value, +lenIn.value === 0 ? 1.2 : 0);
      H = fft2(N, h);
      g = blur(N, f, h, +noiseIn.value / 100, 7);
      q('[data-cp-lout]').textContent = `${lenIn.value} px`;
      q('[data-cp-aout]').textContent = `${angIn.value}°`;
      q('[data-cp-nout]').textContent = `${nf(+noiseIn.value)} %`;
      paint(cObs, g);
      // kernel (centred crop) and log |H| (centred spectrum)
      const k = 33, crop = new Float64Array(k * k);
      let hmax = 0;
      for (let y = 0; y < k; y++) for (let x = 0; x < k; x++) {
        const v = h[((y - 16 + N) % N) * N + ((x - 16 + N) % N)];
        crop[y * k + x] = v; hmax = Math.max(hmax, v);
      }
      paint(cPsf, crop.map((v) => 1 - v / (hmax || 1)), k);
      const s = new Float64Array(N * N);
      for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
        const i = ((y + N / 2) % N) * N + ((x + N / 2) % N);
        s[y * N + x] = Math.log10(Math.hypot(H.re[i], H.im[i]) + 1e-4);
      }
      paint(cSpec, s, N, -4, 0);
    };

    const report = (rec: ArrayLike<number>, extra = '') => {
      const note = method === 'inv' ? T.rdInv : method === 'tik' ? T.rdTik : method === 'rl' ? T.rdRl : T.rdPinn;
      read.textContent = `PSNR: ${T.rdBlur} ${nf(psnr(g, f))} dB · ${T.rdRec} ${nf(psnr(rec, f))} dB${extra} · ${note}`;
    };

    const stopRl = () => { cancelAnimationFrame(raf); raf = 0; };
    const rlLoop = () => {
      if (!rl || !H || off()) { raf = 0; return; }
      for (let k = 0; k < RL_PER_FRAME && it < RL_MAX; k++, it++) richardsonLucyStep(H, g, rl);
      paint(cRec, rl);
      report(rl, ` · ${T.rdIt} ${it}`);
      raf = it < RL_MAX ? requestAnimationFrame(rlLoop) : 0;
    };
    const startRl = () => { stopRl(); rl = Float64Array.from(g, (v) => Math.max(v, 0)); it = 0; raf = requestAnimationFrame(rlLoop); };

    const stopPinn = () => { training = false; cancelAnimationFrame(praf); praf = 0; trainBtn.textContent = T.train; };
    const pinnReport = () => {
      if (!trainer || !lastF) { read.textContent = T.rdPinnIdle; return; }
      if (Number.isNaN(tikRef)) tikRef = psnr(tikhonov(N, g, h, 10 ** +lamIn.value), f);
      report(lastF, ` · ${T.rdIt} ${trainer.iter} · ${T.rdTikRef}: ${nf(tikRef)} dB`);
    };
    const pinnLoop = () => {
      if (!training || !trainer || off()) { stopPinn(); return; }
      const t0 = performance.now();
      do { const r = trainer.step(); lastF = r.f; lastData = r.data; } while (performance.now() - t0 < FRAME_MS && trainer.iter < PINN_STEPS);
      paint(cRec, lastF!);
      pinnReport();
      if (trainer.iter >= PINN_STEPS) { stopPinn(); return; }
      praf = requestAnimationFrame(pinnLoop);
    };
    const trainPinn = () => {
      stopPinn();
      const net = initImageNet(64, 3, 16);
      trainer = makeImageTrainer(net, H!, g, 0.02, 0.01);
      lastF = null; training = true; trainedOnce = true; trainBtn.textContent = T.stop;
      praf = requestAnimationFrame(pinnLoop);
    };
    void lastData;

    const inverse = () => {
      stopRl();
      stopPinn();
      tikRef = NaN;
      root.querySelectorAll<HTMLElement>('[data-cp-only]').forEach((e) => (e.hidden = e.dataset.cpOnly !== method));
      q('[data-cp-lamout]').textContent = nf(+lamIn.value);
      if (method === 'rl') { startRl(); return; }
      if (method === 'pinn') {
        trainer = null; lastF = null;
        paint(cRec, g);
        pinnReport();
        if (trainedOnce) trainPinn();
        return;
      }
      const rec = tikhonov(N, g, h, method === 'inv' ? 0 : 10 ** +lamIn.value);
      paint(cRec, rec);
      report(rec);
    };

    const all = () => { forward(); inverse(); };
    [lenIn, angIn, noiseIn].forEach((el) => el.addEventListener('input', () => allDebounced()));
    lamIn.addEventListener('input', () => { tikRef = NaN; if (method === 'pinn') pinnReport(); else inverse(); });
    root.querySelectorAll<HTMLButtonElement>('[data-cp-m]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.cpM as typeof method;
      root.querySelectorAll('[data-cp-m]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      inverse();
    }));
    runBtn.addEventListener('click', startRl);
    trainBtn.addEventListener('click', () => (training ? stopPinn() : trainPinn()));
    revealBtn.addEventListener('click', () => {
      revealed = !revealed;
      veil.hidden = revealed;
      revealBtn.textContent = revealed ? T.hide : T.reveal;
    });
    root.addEventListener('eng:show', () => { if (method === 'rl' && it < RL_MAX && !raf) raf = requestAnimationFrame(rlLoop); });
    let debounce = 0;
    const allDebounced = () => { if (method !== 'pinn') { all(); return; } forward(); clearTimeout(debounce); debounce = window.setTimeout(inverse, 250); };
    all();
  }

  /* ------------------------------------------------ trustworthy AI example */

  function initTrust(root: HTMLElement) {
    const { lang, T: TT } = JSON.parse(root.dataset.cpText!);
    const T = TT.tr;
    const box = root.querySelector<HTMLElement>('[data-cp-ex="trust"]')!;
    const q = <E extends Element>(s: string) => box.querySelector<E>(s)!;
    const nf = (v: number, d = 2) => (lang === 'es' ? v.toFixed(d).replace('.', ',') : v.toFixed(d)).replace('-', '−');
    const pct = (v: number) => `${Math.round(v * 100)} %`;
    const covIn = q<HTMLInputElement>('[data-tr-cov]'), noiseIn = q<HTMLInputElement>('[data-tr-noise]');
    const membersBox = q<HTMLInputElement>('[data-tr-members]'), trainBtn = q<HTMLButtonElement>('[data-tr-train]'), newBtn = q<HTMLButtonElement>('[data-tr-new]');
    const read = q<HTMLElement>('[data-tr-read]'), lossNote = q<HTMLElement>('[data-tr-lossnote]');
    const plot = new LinePlot(q<HTMLElement>('[data-tr-plot]'), { width: 640, height: 300, xlabel: T.x, ylabel: T.y, title: T.plot, legend: false });
    const xs = Array.from({ length: 241 }, (_, i) => (i / 240) * TR.L);
    const truthLine = xs.map(TR.truth);

    let method: 'nn' | 'pinn' = 'nn', seed = 3, data = TR.makeData(seed, +noiseIn.value);
    let ens: ReturnType<typeof TR.makeEnsemble> | null = null, iter = 0, total = TR.NN_STEPS, running = false, trainedOnce = false, raf = 0, lastDraw = 0;
    const gapErr: Partial<Record<'nn' | 'pinn', number>> = {};
    const off = () => root.hidden || box.hidden;

    const draw = () => {
      const series: Series[] = [];
      let msg = T.idle;
      if (ens) {
        const st = TR.ensembleStats(ens.nets, xs);
        // batch evaluations: calibration, test and error grids
        const muCal = TR.ensembleStats(ens.nets, data.calib.map((s) => s.x)).mean;
        const testX = data.test.map((s) => s.x), muTest = TR.ensembleStats(ens.nets, testX).mean;
        const lookup = new Map<number, number>();
        testX.forEach((x, i) => lookup.set(x, muTest[i]));
        const mu = (x: number) => lookup.get(x) ?? TR.ensembleStats(ens!.nets, [x]).mean[0];
        const qh = TR.conformalQuantile(data.calib.map((s, i) => Math.abs(s.y - muCal[i])), +covIn.value);
        // out-of-distribution shading where the members disagree
        const thr = TR.oodThreshold(xs, st.sd);
        let flagged = 0;
        for (let i = 0; i < xs.length; ) {
          if (st.sd[i] <= thr) { i++; continue; }
          let j = i;
          while (j < xs.length && st.sd[j] > thr) j++;
          flagged += j - i;
          const seg = xs.slice(Math.max(0, i - 1), Math.min(xs.length, j + 1));
          series.push({ kind: 'band', x: seg, y: seg.map(() => -5), y2: seg.map(() => 5), cls: 's-warn' });
          i = j;
        }
        series.push({ kind: 'band', x: xs, y: Array.from(st.mean, (m) => m - qh), y2: Array.from(st.mean, (m) => m + qh), cls: 's-learned' });
        if (membersBox.checked) st.members.forEach((m) => series.push({ kind: 'line', x: xs, y: m, cls: 's-muted' }));
        series.push({ kind: 'line', x: xs, y: truthLine, cls: 's-truth', dash: true });
        series.push({ kind: 'line', x: xs, y: st.mean, cls: 's-learned' });
        const cov = TR.coverageByRegion(data.test, mu, qh);
        const e = iter >= total || !running ? TR.rmsInRegion((x) => TR.ensembleStats(ens!.nets, [x]).mean[0], 'gap') : NaN;
        if (iter >= total) gapErr[method] = e;
        const cmp = (['nn', 'pinn'] as const).filter((k) => gapErr[k] !== undefined).map((k) => `${k === 'nn' ? T.mNn : T.mPinn} ${nf(gapErr[k]!, 3)}`).join(' · ');
        msg = `${method === 'nn' ? T.mNn : T.mPinn} · ${T.it} ${iter}/${total} · ${T.band}${nf(qh, 3)} (${T.target} ${pct(+covIn.value)}) · ${T.cov}: ${T.covData} ${pct(cov.data)}, ${T.covGap} ${pct(cov.gap)}, ${T.covExtra} ${pct(cov.extra)} · ${T.ood} ${pct(flagged / xs.length)} ${T.ofAxis}${cmp ? ` · ${T.gapErr}: ${cmp}` : ''}${iter >= total ? ' · ' + (method === 'nn' ? T.lessonNn : T.lessonPinn) : ''}`;
      } else {
        series.push({ kind: 'line', x: xs, y: truthLine, cls: 's-truth', dash: true });
      }
      series.push({ kind: 'points', x: data.calib.map((s) => s.x), y: data.calib.map((s) => s.y), cls: 's-muted' });
      series.push({ kind: 'points', x: data.train.map((s) => s.x), y: data.train.map((s) => s.y), cls: 's-data' });
      read.textContent = msg;
      plot.render(series, { xlim: [0, TR.L], ylim: [-1.3, 1.5] });
    };

    const stop = () => { running = false; cancelAnimationFrame(raf); raf = 0; trainBtn.textContent = T.train; };
    const loop = () => {
      if (!running || !ens || off()) { stop(); return; }
      const t0 = performance.now();
      while (performance.now() - t0 < 7 && iter < total) {
        const lr = TR.lrAt(iter, total);
        for (const net of ens.nets) TR.adamT(net, TR.lossGradT(net, data.train, ens.cfg).g, lr);
        iter++;
      }
      // redraw a few times per second while training (drawing costs more than a step)
      if (iter >= total || t0 - lastDraw > 150) { lastDraw = t0; draw(); }
      if (iter >= total) { stop(); return; }
      raf = requestAnimationFrame(loop);
    };
    const train = () => {
      stop();
      ens = TR.makeEnsemble(method === 'pinn');
      total = method === 'pinn' ? TR.PINN_STEPS : TR.NN_STEPS;
      iter = 0; running = true; trainedOnce = true; trainBtn.textContent = T.stop;
      raf = requestAnimationFrame(loop);
    };
    const reset = () => { stop(); ens = null; iter = 0; if (trainedOnce) train(); else draw(); };
    const setNote = () => { lossNote.textContent = method === 'pinn' ? `(λ = ${nf(TR.PHYS_WEIGHT, 1)})` : `(λ = 0)`; };

    box.querySelectorAll<HTMLButtonElement>('[data-tr-m]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.trM as typeof method;
      box.querySelectorAll('[data-tr-m]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      setNote(); reset();
    }));
    covIn.addEventListener('input', () => { q('[data-tr-covout]').textContent = pct(+covIn.value); if (!running) draw(); });
    noiseIn.addEventListener('input', () => { q('[data-tr-nout]').textContent = nf(+noiseIn.value); data = TR.makeData(seed, +noiseIn.value); delete gapErr.nn; delete gapErr.pinn; reset(); });
    membersBox.addEventListener('change', () => { if (!running) draw(); });
    trainBtn.addEventListener('click', () => (running ? stop() : train()));
    newBtn.addEventListener('click', () => { seed += 1; data = TR.makeData(seed, +noiseIn.value); delete gapErr.nn; delete gapErr.pinn; reset(); });
    window.addEventListener('themechange', () => { if (!off()) draw(); });
    q('[data-tr-nout]').textContent = nf(+noiseIn.value);
    setNote(); draw();
    return { resume: () => { if (ens && iter < total && !running && trainedOnce) { running = true; trainBtn.textContent = T.stop; raf = requestAnimationFrame(loop); } else draw(); } };
  }

  document.querySelectorAll<HTMLElement>('[data-eng-tab="computing"]').forEach((root) => {
    let done = false, trust: ReturnType<typeof initTrust> | null = null;
    const exOf = () => root.querySelector<HTMLButtonElement>('[data-cp-ex-btn][aria-pressed="true"]')!.dataset.cpExBtn;
    const start = () => { if (done) return; done = true; init(root); };
    root.querySelectorAll<HTMLButtonElement>('[data-cp-ex-btn]').forEach((b) => b.addEventListener('click', () => {
      const ex = b.dataset.cpExBtn!;
      root.querySelectorAll('[data-cp-ex-btn]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-cp-ex]').forEach((e) => (e.hidden = e.dataset.cpEx !== ex));
      if (ex === 'trust') { if (!trust) trust = initTrust(root); else trust.resume(); }
      else root.dispatchEvent(new CustomEvent('eng:show'));
    }));
    root.addEventListener('eng:show', () => { if (exOf() === 'trust') { if (!trust) trust = initTrust(root); else trust.resume(); } else start(); });
    if (!root.hidden) start();
  });
</script>

<style>
  .cp__panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); max-width: 40rem; margin-inline: auto; align-items: end; }
  .cp__p { margin: 0; }
  .cp canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; outline: 0.5px solid var(--ink-3); }
  .cp__truth { position: relative; }
  .cp__veil { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; background: var(--paper-2, var(--paper)); outline: 0.5px solid var(--ink-3); font-size: 2.2rem; color: var(--ink-3); line-height: 1; }
  .cp__veil small { display: block; font-size: var(--step--2); font-style: italic; margin-top: 0.3rem; }
  .cp__veil[hidden] { display: none; }
  .cp__small { display: flex; justify-content: center; gap: var(--s-5); margin-top: var(--s-3); }
  .cp__small figure { margin: 0; width: 4.5rem; }
  .cp__small figcaption { font-size: var(--step--2); text-align: center; font-style: italic; color: var(--ink-2); margin-top: 0.2rem; }
  .cp .eng-cap, .cp .eng-fi { max-width: 40rem; margin-inline: auto; }
  .cp .lab__readout { max-width: 40rem; margin-inline: auto; text-align: center; }
  [data-cp-ex][hidden] { display: none; }
  /* deblurring: four sliders on one row */
  .cp .eng-controls.cp__four { grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); max-width: 40rem; margin-inline: auto; }
  .tr__plot { max-width: 40rem; margin-inline: auto; min-height: 14rem; }
  .tr__key { max-width: 40rem; margin: var(--s-2) auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2em 1.1em; font-size: var(--step--2); color: var(--ink-2); }
  .tr__key > span { white-space: nowrap; }
  .tr__dot { margin-right: 0.3em; font-size: 0.9em; }
  .tr__dash { background: repeating-linear-gradient(90deg, var(--c-truth) 0 4px, transparent 4px 7px); }
  .tr__sw { display: inline-block; width: 0.9em; height: 0.7em; vertical-align: middle; margin-right: 0.3em; }
  .tr__sw--band { background: var(--c-band); }
  .tr__sw--ood { background: color-mix(in srgb, var(--c-warn) 14%, transparent); }
  @media (max-width: 34rem) {
    .cp__panels { gap: var(--s-2); }
    .cp__panels .panel-title { font-size: 0.8rem; hyphens: none; letter-spacing: 0; }
  }
</style>
