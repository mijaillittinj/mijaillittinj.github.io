---
/**
 * Industrial engineering tab: delivery routing as a travelling salesman problem.
 * Click to add customers, drag to move them, then optimise: a nearest-neighbour route
 * is improved live by simulated annealing with 2-opt moves (src/lib/eng/tsp.ts).
 * Synthetic service area of 100 km × 100 km.
 */
import Equation from '../viz/Equation.astro';
interface Props { lang?: 'en' | 'es'; hidden?: boolean }
const { lang = 'en', hidden = false } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      fwd: 'Directo', opt: 'Optimización',
      fi: [': dada una ruta, calcular su longitud y su tiempo. ', ': encontrar la ruta que los minimiza, con la misma maquinaria (minimizar una función objetivo) que resuelve los problemas inversos.'],
      map: 'Área de servicio de 100 km × 100 km con un depósito y clientes',
      hint: 'Haga clic para agregar clientes, arrástrelos para moverlos y haga doble clic para quitarlos.',
      n: 'Clientes aleatorios', speed: 'Velocidad media del camión',
      random: 'clientes aleatorios', optimise: 'optimizar la ruta', stop: 'detener', clear: 'borrar',
      depot: 'depósito', plot: 'Longitud de la ruta durante el recocido', xl: 'iteración (miles)', yl: 'longitud (km)',
      legSA: 'recocido simulado', legNN: 'vecino más cercano', legSOM: 'red neuronal (SOM)',
      method: 'Método', mSA: 'recocido simulado', mSOM: 'red neuronal (SOM)', train: 'entrenar la red', polish: 'Pulir el resultado con 2-opt',
      plotSOM: 'Longitud de la ruta durante el entrenamiento', xlSOM: 'paso de entrenamiento (miles)',
      capSOM: 'Es una red neuronal, pero no informada por la física: el ruteo no tiene una ecuación gobernante que poner en la función de pérdida. El mapa autoorganizado aprende un anillo de neuronas que se ajusta a los clientes (en la línea de la red elástica de Durbin y Willshaw); es una heurística elegante, en general a pocos puntos porcentuales del recocido simulado.',
      cap: 'El problema del vendedor viajero es NP-difícil: con 40 clientes hay unas 10⁴⁶ rutas posibles (39!/2), así que no se pueden revisar todas. La ruta del vecino más cercano es rápida pero deja cruces; el recocido simulado propone invertir tramos (movimientos 2-opt) y, mientras la «temperatura» es alta, acepta a veces empeorar para escapar de mínimos locales. Es la misma dificultad de un problema inverso no convexo: minimizar un objetivo en un espacio enorme sin quedar atrapado. Ejemplo sintético.',
    }
  : {
      fwd: 'Forward', opt: 'Optimisation',
      fi: [': given a route, compute its length and time. ', ': find the route that minimises them, with the same machinery (minimising an objective) that solves inverse problems.'],
      map: 'Service area of 100 km × 100 km with a depot and customers',
      hint: 'Click to add customers, drag to move them, double-click to remove them.',
      n: 'Random customers', speed: 'Average truck speed',
      random: 'random customers', optimise: 'optimise the route', stop: 'stop', clear: 'clear',
      depot: 'depot', plot: 'Route length during annealing', xl: 'iteration (thousands)', yl: 'length (km)',
      legSA: 'simulated annealing', legNN: 'nearest neighbour', legSOM: 'neural network (SOM)',
      method: 'Method', mSA: 'simulated annealing', mSOM: 'neural network (SOM)', train: 'train the network', polish: 'Polish the result with 2-opt',
      plotSOM: 'Route length during training', xlSOM: 'training step (thousands)',
      capSOM: 'This is a neural network but not a physics-informed one: routing has no governing equation to put in the loss. The self-organising map learns a ring of neurons that fits the customers (in the spirit of the Durbin–Willshaw elastic net), an elegant heuristic that usually lands within a few per cent of annealing.',
      cap: 'The travelling salesman problem is NP-hard: with 40 customers there are about 10⁴⁶ possible routes (39!/2), so they cannot all be checked. The nearest-neighbour route is fast but leaves crossings; simulated annealing proposes reversing segments (2-opt moves) and, while the “temperature” is high, sometimes accepts a worse route to escape local minima. It is the same difficulty as a non-convex inverse problem: minimising an objective over a huge space without getting trapped. Synthetic example.',
    };
const client = { lang, depot: T.depot, optimise: T.optimise, stop: T.stop, xl: T.xl, yl: T.yl, legSA: T.legSA, legNN: T.legNN, plot: T.plot, legSOM: T.legSOM, train: T.train, plotSOM: T.plotSOM, xlSOM: T.xlSOM };
---
<div class="eng-tab r" data-eng-tab="industrial" hidden={hidden} data-r-text={JSON.stringify(client)}>
  <p class="eng-fi"><em>{T.fwd}</em>{T.fi[0]}<em>{T.opt}</em>{T.fi[1]}</p>

  <div class="r__grid">
    <div>
      <canvas class="r__canvas" data-r-canvas role="img" aria-label={T.map}></canvas>
      <p class="r__hint meta">{T.hint}</p>
    </div>
    <div class="r__side">
      <p class="r__h" data-r-ph>{T.plot}</p>
      <div class="r__plot" data-r-lplot></div>
    </div>
  </div>

  <div class="r__method">
    <span class="r__mlabel">{T.method}:</span>
    <div class="seg" role="group" aria-label={T.method}>
      <button type="button" data-r-method="sa" aria-pressed="true">{T.mSA}</button>
      <button type="button" data-r-method="som" aria-pressed="false">{T.mSOM}</button>
    </div>
    <label class="meta r__polish" data-r-polishwrap hidden><input type="checkbox" data-r-polish /> {T.polish}</label>
  </div>

  <div class="r__controls">
    <div class="control">
      <div class="control__head"><label for={`r-n-${lang}`}>{T.n}</label><output data-r-nout>40</output></div>
      <input id={`r-n-${lang}`} data-r-n type="range" min="10" max="80" step="1" value="40" />
    </div>
    <div class="control">
      <div class="control__head"><label for={`r-v-${lang}`}>{T.speed}</label><output data-r-vout>50 km/h</output></div>
      <input id={`r-v-${lang}`} data-r-v type="range" min="20" max="90" step="5" value="50" />
    </div>
    <p class="r__btns">
      <button type="button" class="btn" data-r-opt>{T.optimise}</button>
      <button type="button" class="btn" data-r-rand>{T.random}</button>
      <button type="button" class="btn" data-r-clear>{T.clear}</button>
    </p>
  </div>

  <div class="eng-eqs">
    <Equation tex={String.raw`\min_{\pi}\; \sum_{k=1}^{n} \big\lVert \mathbf{x}_{\pi(k)} - \mathbf{x}_{\pi(k+1)} \big\rVert`} />
    <div data-r-eq="sa"><Equation tex={String.raw`P(\text{accept}) = \min\!\big(1, e^{-\Delta L / T}\big)`} /></div>
    <div data-r-eq="som" hidden><Equation tex={String.raw`\mathbf{w}_j \leftarrow \mathbf{w}_j + \eta\, e^{-(j-j^*)^2/2\sigma^2}\,(\mathbf{x} - \mathbf{w}_j)`} /></div>
  </div>
  <p class="lab__readout" data-r-read aria-live="polite"></p>
  <p class="eng-cap" data-r-cap="sa">{T.cap}</p>
  <p class="eng-cap" data-r-cap="som" hidden>{T.capSOM}</p>
</div>

<script>
  import { tourLength, nearestNeighbour, makeAnnealer, randomCustomers, twoOptPolish, type Pt, type Annealer } from '../../lib/eng/tsp';
  import { makeSom, type Som } from '../../lib/eng/som';
  import { cssVar, LinePlot } from '../../lib/plot';

  const L = 100;

  function init(root: HTMLElement) {
    const text = JSON.parse(root.dataset.rText!);
    const es = text.lang === 'es';
    const canvas = root.querySelector<HTMLCanvasElement>('[data-r-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const read = root.querySelector<HTMLElement>('[data-r-read]')!;
    const nIn = root.querySelector<HTMLInputElement>('[data-r-n]')!;
    const vIn = root.querySelector<HTMLInputElement>('[data-r-v]')!;
    const nout = root.querySelector<HTMLOutputElement>('[data-r-nout]')!;
    const vout = root.querySelector<HTMLOutputElement>('[data-r-vout]')!;
    const optBtn = root.querySelector<HTMLButtonElement>('[data-r-opt]')!;
    const plot = new LinePlot(root.querySelector<HTMLElement>('[data-r-lplot]')!, { width: 300, height: 230, xlabel: text.xl, ylabel: text.yl, title: text.plot });
    const num = (v: number, d = 0) => (es ? v.toFixed(d).replace('.', ',') : v.toFixed(d));

    let seed = 11;
    let pts: Pt[] = [];                 // pts[0] is the depot
    let tour: number[] = [], nnLen = 0;
    let ann: Annealer | null = null, running = false, raf = 0, optimised = false;
    let hist: [number, number][] = [];
    let method: 'sa' | 'som' = 'sa', som: Som | null = null, somLen = 0, refLen = 0;
    const polishBox = root.querySelector<HTMLInputElement>('[data-r-polish]')!;
    let W = 300, pad = 30;
    let drag = -1, moved = false;

    const col = () => ({
      ink: cssVar('--ink'), ink3: cssVar('--ink-3'), rule: cssVar('--rule'), paper: cssVar('--paper'),
      data: cssVar('--c-data'), learned: cssVar('--c-learned'), font: cssVar('--font-serif') || 'serif',
    });
    const X = (x: number) => pad + (x / L) * (W - pad - 8);
    const Y = (y: number) => W - pad - (y / L) * (W - pad - 8);
    const invX = (px: number) => ((px - pad) / (W - pad - 8)) * L;
    const invY = (py: number) => ((W - pad - py) / (W - pad - 8)) * L;

    const resize = () => {
      const w = Math.round(canvas.clientWidth);
      if (!w) return false;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = w; pad = w < 340 ? 26 : 32;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    };

    const reset = () => {
      stop();
      ann = null; som = null; somLen = 0; refLen = 0; optimised = false; hist = [];
      tour = nearestNeighbour(pts);
      nnLen = pts.length > 1 ? tourLength(pts, tour) : 0;
      draw(); drawPlot();
    };

    const draw = () => {
      const c = col();
      ctx.clearRect(0, 0, W, W);
      ctx.fillStyle = c.paper; ctx.fillRect(0, 0, W, W);
      const x0 = X(0), y0 = Y(L), side = X(L) - X(0);
      ctx.font = `11px ${c.font}`; ctx.fillStyle = c.ink; ctx.strokeStyle = c.ink; ctx.lineWidth = 0.7;
      for (let v = 0; v <= L; v += 25) {
        ctx.beginPath(); ctx.moveTo(X(v), Y(0)); ctx.lineTo(X(v), Y(0) - 4); ctx.moveTo(X(0), Y(v)); ctx.lineTo(X(0) + 4, Y(v)); ctx.stroke();
        ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(String(v), X(v), Y(0) + 4);
        ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; ctx.fillText(String(v), X(0) - 4, Y(v));
      }
      ctx.strokeRect(x0, y0, side, side);
      ctx.font = `italic 11px ${c.font}`; ctx.textAlign = 'right'; ctx.textBaseline = 'bottom';
      ctx.fillText('km', X(L), Y(0) + pad - 2);

      // route
      const t = ann ? ann.tour : tour;
      if (t.length > 1 && !(som && !optimised)) {
        ctx.beginPath();
        t.forEach((k, i) => (i ? ctx.lineTo(X(pts[k].x), Y(pts[k].y)) : ctx.moveTo(X(pts[k].x), Y(pts[k].y))));
        ctx.closePath();
        if (ann || optimised) { ctx.strokeStyle = c.learned; ctx.lineWidth = 1.6; ctx.setLineDash([]); }
        else { ctx.strokeStyle = c.ink3; ctx.lineWidth = 1; ctx.setLineDash([4, 3]); }
        ctx.lineJoin = 'round'; ctx.stroke(); ctx.setLineDash([]);
      }
      // self-organising map: ring of neurons (smooth closed curve through them)
      if (som && !(som.done && optimised)) {
        const g = som.ring, m = som.m;
        const mx = (j: number) => (X(g[2 * (j % m)]) + X(g[2 * ((j + 1) % m)])) / 2;
        const my = (j: number) => (Y(g[2 * (j % m) + 1]) + Y(g[2 * ((j + 1) % m) + 1])) / 2;
        ctx.beginPath(); ctx.moveTo(mx(m - 1), my(m - 1));
        for (let j = 0; j < m; j++) ctx.quadraticCurveTo(X(g[2 * j]), Y(g[2 * j + 1]), mx(j), my(j));
        ctx.closePath(); ctx.strokeStyle = c.learned; ctx.lineWidth = 1.4; ctx.setLineDash([]); ctx.stroke();
        ctx.fillStyle = c.learned;
        for (let j = 0; j < m; j++) { ctx.beginPath(); ctx.arc(X(g[2 * j]), Y(g[2 * j + 1]), 1.6, 0, 2 * Math.PI); ctx.fill(); }
      }
      // customers
      const r = W < 340 ? 3.2 : 3.8;
      for (let i = 1; i < pts.length; i++) {
        ctx.beginPath(); ctx.arc(X(pts[i].x), Y(pts[i].y), r, 0, 2 * Math.PI);
        ctx.fillStyle = c.data; ctx.fill(); ctx.strokeStyle = c.paper; ctx.lineWidth = 0.8; ctx.stroke();
      }
      // depot
      if (pts.length) {
        const dx = X(pts[0].x), dy = Y(pts[0].y), s = 7;
        ctx.fillStyle = c.ink; ctx.fillRect(dx - s, dy - s, 2 * s, 2 * s);
        ctx.strokeStyle = c.paper; ctx.lineWidth = 1; ctx.strokeRect(dx - s, dy - s, 2 * s, 2 * s);
        ctx.font = `italic 12px ${c.font}`; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
        const lw = ctx.measureText(text.depot).width;
        const lx = pts[0].x > L - 22 ? dx - s - 4 - lw : dx + s + 4;
        ctx.fillStyle = c.paper; ctx.fillRect(lx - 2, dy - 8, lw + 4, 16);
        ctx.fillStyle = c.ink; ctx.fillText(text.depot, lx, dy);
      }
      readout();
    };

    const drawPlot = () => {
      const series: import('../../lib/plot').Series[] = [];
      const xmax = ann ? ann.total / 1000 : som ? som.total / 1000 : 1;
      if (nnLen > 0) series.push({ kind: 'line', x: [0, xmax], y: [nnLen, nnLen], cls: 's-muted', dash: true, label: text.legNN });
      if (hist.length) series.push({ kind: 'line', x: hist.map((h) => h[0] / 1000), y: hist.map((h) => h[1]), cls: 's-learned', label: method === 'som' ? text.legSOM : text.legSA });
      if (method === 'som' && refLen > 0) series.push({ kind: 'line', x: [0, xmax], y: [refLen, refLen], cls: 's-truth', dash: true, label: text.legSA });
      if (!series.length) series.push({ kind: 'line', x: [0, 1], y: [NaN, NaN], cls: 's-muted' });
      const ys = [nnLen, refLen, ...hist.map((h) => h[1])].filter((v) => v > 0);
      const lo = ys.length ? Math.min(...ys) : 0, hi = ys.length ? Math.max(...ys) : 1;
      plot.render(series, { xlim: [0, xmax], ylim: [Math.max(0, lo * 0.9), hi * 1.08 || 1] });
    };

    const readout = () => {
      const n = pts.length - 1;
      if (n < 2) { read.textContent = es ? 'Agregue al menos dos clientes.' : 'Add at least two customers.'; return; }
      const len = ann ? ann.length : som ? somLen : tourLength(pts, tour);
      const hours = len / +vIn.value;
      const h = Math.floor(hours), m = Math.round((hours - h) * 60);
      const imp = nnLen > 0 ? ((nnLen - len) / nnLen) * 100 : 0;
      let s = es
        ? `${n} clientes · ruta de ${num(len)} km (vecino más cercano ${num(nnLen)} km, ${imp > 0.05 ? '−' + num(imp, 1) : '0'} %) · ${h} h ${String(m).padStart(2, '0')} min de conducción`
        : `${n} customers · route ${num(len)} km (nearest neighbour ${num(nnLen)} km, ${imp > 0.05 ? '−' + num(imp, 1) : '0'} %) · ${h} h ${String(m).padStart(2, '0')} min driving`;
      if (som) {
        s += es ? ` · paso ${som.iter.toLocaleString('es-CL')} · vecindad σ = ${num(som.sigma, 1)} neuronas` : ` · step ${som.iter.toLocaleString('en-GB')} · neighbourhood σ = ${num(som.sigma, 1)} neurons`;
        if (refLen > 0) { const gap = ((len - refLen) / refLen) * 100; s += es ? ` · diferencia con el recocido ${gap >= 0 ? '+' : '−'}${num(Math.abs(gap), 1)} %` : ` · gap to annealing ${gap >= 0 ? '+' : '−'}${num(Math.abs(gap), 1)} %`; }
      }
      if (ann) s += es ? ` · iteración ${ann.iter.toLocaleString('es-CL')} · T = ${num(ann.T, 2)} km` : ` · iteration ${ann.iter.toLocaleString('en-GB')} · T = ${num(ann.T, 2)} km`;
      read.textContent = s;
    };

    const visible = () => !root.hidden && root.offsetParent !== null;
    const stop = () => { running = false; cancelAnimationFrame(raf); optBtn.textContent = method === 'som' ? text.train : text.optimise; };
    const loop = () => {
      if (!running || !ann) return;
      if (!visible()) { stop(); return; }
      const done = ann.run(Math.ceil(ann.total / 200));
      hist.push([ann.iter, ann.length]);
      draw(); drawPlot();
      if (done) { optimised = true; tour = ann.tour.slice(); stop(); draw(); return; }
      raf = requestAnimationFrame(loop);
    };
    const somLoop = () => {
      if (!running || !som) return;
      if (!visible()) { stop(); return; }
      const done = som.run(Math.ceil(som.total / 180));
      tour = som.tour(); somLen = tourLength(pts, tour);
      hist.push([som.iter, somLen]);
      if (done) {
        const A = makeAnnealer(pts, nearestNeighbour(pts), seed);
        while (!A.run(20000));
        refLen = A.length;
        if (polishBox.checked) { twoOptPolish(pts, tour); somLen = tourLength(pts, tour); }
        optimised = true; stop(); draw(); drawPlot(); return;
      }
      draw(); drawPlot();
      raf = requestAnimationFrame(somLoop);
    };
    const train = () => {
      if (pts.length < 4) return;
      stop();
      tour = nearestNeighbour(pts); nnLen = tourLength(pts, tour);
      ann = null; optimised = false; refLen = 0;
      som = makeSom(pts, seed);
      somLen = tourLength(pts, som.tour());
      hist = [[0, somLen]];
      running = true; optBtn.textContent = text.stop;
      raf = requestAnimationFrame(somLoop);
    };
    const optimise = () => {
      if (method === 'som') { train(); return; }
      if (pts.length < 4) return;
      stop();
      tour = nearestNeighbour(pts); nnLen = tourLength(pts, tour);
      som = null;
      ann = makeAnnealer(pts, tour, seed);
      hist = [[0, ann.length]];
      running = true; optBtn.textContent = text.stop;
      raf = requestAnimationFrame(loop);
    };

    const randomise = () => {
      seed++;
      pts = [{ x: 50, y: 50 }, ...randomCustomers(+nIn.value, seed)];
      reset();
    };

    // pointer interaction
    const pos = (e: PointerEvent | MouseEvent) => { const b = canvas.getBoundingClientRect(); return { px: e.clientX - b.left, py: e.clientY - b.top }; };
    const hit = (px: number, py: number, rad: number) => {
      let best = -1, bd = rad;
      pts.forEach((p, i) => { const dd = Math.hypot(X(p.x) - px, Y(p.y) - py); if (dd < bd) { bd = dd; best = i; } });
      return best;
    };
    const inside = (px: number, py: number) => px >= X(0) && px <= X(L) && py >= Y(L) && py <= Y(0);
    const clampKm = (v: number) => Math.max(1, Math.min(L - 1, v));
    canvas.addEventListener('pointerdown', (e) => {
      const { px, py } = pos(e);
      drag = hit(px, py, e.pointerType === 'touch' ? 18 : 10);
      moved = false;
      if (drag >= 0) canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (drag < 0) return;
      const { px, py } = pos(e);
      pts[drag] = { x: clampKm(invX(px)), y: clampKm(invY(py)) };
      if (!moved) { moved = true; stop(); ann = null; som = null; optimised = false; }
      tour = nearestNeighbour(pts); nnLen = tourLength(pts, tour);
      draw();
    });
    canvas.addEventListener('pointerup', (e) => {
      const { px, py } = pos(e);
      if (drag >= 0 && moved) { drag = -1; reset(); return; }
      if (drag < 0 && inside(px, py) && pts.length < 121) {
        pts.push({ x: clampKm(invX(px)), y: clampKm(invY(py)) });
        reset();
      }
      drag = -1;
    });
    canvas.addEventListener('dblclick', (e) => {
      const { px, py } = pos(e);
      const i = hit(px, py, 12);
      if (i > 0) { pts.splice(i, 1); reset(); }
    });

    optBtn.addEventListener('click', () => (running ? stop() : optimise()));
    const ph = root.querySelector<HTMLElement>('[data-r-ph]')!;
    root.querySelectorAll<HTMLButtonElement>('[data-r-method]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.rMethod as 'sa' | 'som';
      root.querySelectorAll<HTMLButtonElement>('[data-r-method]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      root.querySelectorAll<HTMLElement>('[data-r-eq]').forEach((e) => (e.hidden = e.dataset.rEq !== method));
      root.querySelectorAll<HTMLElement>('[data-r-cap]').forEach((e) => (e.hidden = e.dataset.rCap !== method));
      root.querySelector<HTMLElement>('[data-r-polishwrap]')!.hidden = method !== 'som';
      ph.textContent = method === 'som' ? text.plotSOM : text.plot;
      plot.setLabels(method === 'som' ? text.xlSOM : text.xl);
      reset();
    }));
    root.querySelector('[data-r-rand]')!.addEventListener('click', randomise);
    root.querySelector('[data-r-clear]')!.addEventListener('click', () => { pts = [{ x: 50, y: 50 }]; reset(); });
    nIn.addEventListener('input', () => { nout.textContent = nIn.value; });
    nIn.addEventListener('change', randomise);
    vIn.addEventListener('input', () => { vout.textContent = `${vIn.value} km/h`; readout(); });
    window.addEventListener('themechange', draw);
    new ResizeObserver(() => { if (resize()) draw(); }).observe(canvas);
    root.addEventListener('eng:show', () => { if (resize()) { draw(); drawPlot(); } });

    resize();
    pts = [{ x: 50, y: 50 }, ...randomCustomers(+nIn.value, seed)];
    reset();
  }

  document.querySelectorAll<HTMLElement>('[data-eng-tab="industrial"]').forEach((root) => {
    let done = false;
    const start = () => { if (!done) { done = true; init(root); } };
    root.addEventListener('eng:show', start, { once: true });
    if (!root.hidden) start();
  });
</script>

<style>
  .r__grid { display: grid; gap: var(--s-4); grid-template-columns: minmax(0, 1fr) minmax(0, 15rem); align-items: start; max-width: 40rem; margin-inline: auto; }
  .r__canvas { width: 100%; aspect-ratio: 1; display: block; touch-action: none; cursor: crosshair; }
  .r__hint { margin-top: var(--s-1); font-style: italic; font-size: var(--step--2); text-align: center; }
  .r__h { font-size: var(--step--1); font-style: italic; margin-bottom: var(--s-2); text-align: center; }
  .r__plot { min-width: 0; }
