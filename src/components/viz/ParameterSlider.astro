---
/** Labelled range input with live numeric readout. Islands listen to `input` events on `name`. */
interface Props { name: string; label: string; min: number; max: number; step: number; value: number; unit?: string; format?: 'fixed2' | 'fixed3' | 'exp' | 'int'; hint?: string; lang?: 'en' | 'es' }
// `lang` is optional: without it the page language (<html lang>) decides; Spanish uses a decimal comma.
const { name, label, min, max, step, value, unit = '', format = 'fixed2', hint, lang } = Astro.props;
const id = `p-${name}-${Math.random().toString(36).slice(2, 7)}`;
---
<div class="control" data-param={name} data-format={format} data-unit={unit} data-lang={lang}>
  <div class="control__head">
    <label for={id}>{label}</label>
    <output for={id}>{value}{unit}</output>
  </div>
  <input id={id} name={name} type="range" min={min} max={max} step={step} value={value} aria-describedby={hint ? `${id}-h` : undefined} />
  {hint && <small id={`${id}-h`} class="muted">{hint}</small>}
</div>
<script>
  const f = (v: number, kind: string) => kind === 'exp' ? v.toExponential(1) : kind === 'int' ? String(Math.round(v)) : kind === 'fixed3' ? v.toFixed(3) : v.toFixed(2);
  document.querySelectorAll<HTMLElement>('[data-param]').forEach((c) => {
    const input = c.querySelector('input')!;
    const out = c.querySelector('output')!;
    const lang = c.dataset.lang ?? c.closest('[lang]')?.getAttribute('lang') ?? 'en';
    const comma = lang.startsWith('es');
    const upd = () => {
      const txt = f(+input.value, c.dataset.format!);
      out.textContent = (comma ? txt.replace('.', ',') : txt) + (c.dataset.unit ?? '');
    };
    input.addEventListener('input', upd);
    upd();
  });
</script>

<style>
  .control__head output { white-space: nowrap; }
  .control__head label { min-width: 0; }
</style>
