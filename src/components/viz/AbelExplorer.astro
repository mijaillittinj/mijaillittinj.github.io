---
/**
 * ProjectionReconstruction + UncertaintyBand: the Abel transform learning lab.
 * Shape a radial profile, project it, add noise, invert it directly (onion peeling)
 * and with Tikhonov regularisation, and see the spread over repeated noise draws.
 */
import ParameterSlider from './ParameterSlider.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const T = lang === 'es'
  ? {
      comma: true,
      profile: 'Perfil radial f(r)', gaussian: 'Máximo en el eje', annular: 'Anillo fuera del eje', twozone: 'Dos zonas',
      a: 'Forma: posición / ancho', b: 'Forma: ancho del anillo / suavidad del borde',
      noise: 'Ruido de medición (% del máximo)', lam: 'Regularización log₁₀ λ', lamHint: 'Peso de la penalización de suavidad ‖Df‖².',
      band: 'Mostrar la dispersión en 30 realizaciones del ruido', direct: 'Mostrar la inversión directa',
      pDisk: 'Sección transversal (lo que buscamos)', pProj: 'Proyección (lo que medimos)', pRec: 'Reconstrucción (lo que inferimos)',
      diskAria: 'Sección transversal del campo axisimétrico',
      xProj: 'desplazamiento del rayo y', xRec: 'radio r',
      exact: 'proyección exacta', noisy: 'datos con ruido', bandL: 'regularizada ±2σ (30 realizaciones)', truth: 'f(r) verdadera', directL: 'inversión directa', reg: 'regularizada',
      err: 'Error (RMS, relativo al máximo)', dir: 'directa', regR: 'regularizada',
      hurt: ' Aquí la regularización empeora el resultado: λ es demasiado grande y aplana estructura real.',
      helps: ' La penalización elimina la mayor parte del ruido amplificado.',
    }
  : {
      profile: 'Radial profile f(r)', gaussian: 'Peak on axis', annular: 'Off-axis ring', twozone: 'Two zones',
      a: 'Shape: position / width', b: 'Shape: ring width / edge softness',
      noise: 'Measurement noise (% of max)', lam: 'Regularisation log₁₀ λ', lamHint: 'Weight of the smoothness penalty ‖Df‖².',
      band: 'Show spread over 30 noise draws', direct: 'Show direct inversion',
      pDisk: 'Cross-section (what we want)', pProj: 'Projection (what we measure)', pRec: 'Reconstruction (what we infer)',
      diskAria: 'Cross-section of the axisymmetric field',
      xProj: 'ray offset y', xRec: 'radius r',
      exact: 'exact projection', noisy: 'noisy data', bandL: 'regularised ±2σ (30 draws)', truth: 'true f(r)', directL: 'direct inversion', reg: 'regularised',
      err: 'Error (RMS, relative to peak)', dir: 'direct', regR: 'regularised',
      hurt: ' Here regularisation hurts: λ is too large and flattens real structure.',
      helps: ' The penalty removes most of the amplified noise.',
    };
---
<div class="lab" data-abel data-t={JSON.stringify(T)}>
  <div class="lab__grid">
    <div class="lab__controls">
      <div class="control">
        <span class="control__head">{T.profile}</span>
        <div class="seg" role="group" aria-label={T.profile}>
          <button type="button" data-kind="gaussian" aria-pressed="false">{T.gaussian}</button>
          <button type="button" data-kind="annular" aria-pressed="true">{T.annular}</button>
          <button type="button" data-kind="two-zone" aria-pressed="false">{T.twozone}</button>
        </div>
      </div>
      <ParameterSlider name="a" label={T.a} min={0} max={1} step={0.01} value={0.5} />
      <ParameterSlider name="b" label={T.b} min={0} max={1} step={0.01} value={0.4} />
      <ParameterSlider name="noise" label={T.noise} min={0} max={6} step={0.1} value={2} format="fixed2" unit=" %" />
      <ParameterSlider name="lam" label={T.lam} min={-3} max={4} step={0.1} value={1} hint={T.lamHint} />
      <label class="meta"><input type="checkbox" data-band checked /> {T.band}</label>
      <label class="meta"><input type="checkbox" data-direct checked /> {T.direct}</label>
      <p class="lab__readout" data-read aria-live="polite"></p>
    </div>
    <div class="lab__plots">
      <div>
        <p class="panel-title">{T.pDisk}</p>
        <canvas class="canvas-field disk" data-disk width="240" height="240" aria-label={T.diskAria} role="img"></canvas>
      </div>
      <div>
        <p class="panel-title">{T.pProj}</p>
        <div data-proj></div>
      </div>
      <div class="wide">
        <p class="panel-title">{T.pRec}</p>
        <div data-rec></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { keyed } from '../../lib/legendkey';
  import { chordMatrix, project, onionPeel, tikhonov, profile, type ProfileKind } from '../../lib/abel';
  import { rng, rms } from '../../lib/linalg';
  import { LinePlot, drawField, viridis } from '../../lib/plot';

  document.querySelectorAll<HTMLElement>('[data-abel]').forEach((root) => {
    const T = JSON.parse(root.dataset.t!);
    // Spanish readouts use a decimal comma
    const dec = (t: string) => (T.comma ? t.replace(/(\d)\.(\d)/g, '$1,$2') : t);
    const n = 60;
    const L = chordMatrix(n);
    const rc = Float64Array.from({ length: n }, (_, i) => (i + 0.5) / n); // annulus centres
    const yr = Float64Array.from({ length: n }, (_, i) => i / n);         // ray offsets
    const val = (name: string) => +root.querySelector<HTMLInputElement>(`[name="${name}"]`)!.value;
    let kind: ProfileKind = 'annular';
    const pProj = new LinePlot(root.querySelector('[data-proj]')!, { width: 420, height: 260, xlabel: T.xProj, ylabel: 'P(y)', title: T.pProj, legend: false});
    const pProjR = keyed(pProj, root.querySelector('[data-proj]')!);
    const pRec = new LinePlot(root.querySelector('[data-rec]')!, { width: 860, height: 300, xlabel: T.xRec, ylabel: 'f(r)', title: T.pRec, legend: false});
    const pRecR = keyed(pRec, root.querySelector('[data-rec]')!);
    const disk = root.querySelector<HTMLCanvasElement>('[data-disk]')!;
    const read = root.querySelector<HTMLElement>('[data-read]')!;
    const bandBox = root.querySelector<HTMLInputElement>('[data-band]')!;
    const directBox = root.querySelector<HTMLInputElement>('[data-direct]')!;

    const drawDisk = (f: Float64Array) => {
      const N = 120, img = new Float32Array(N * N);
      for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) {
        const x = (i + 0.5) / N * 2 - 1, y = (j + 0.5) / N * 2 - 1;
        const r = Math.hypot(x, y);
        img[j * N + i] = r < 1 ? f[Math.min(n - 1, Math.floor(r * n))] : NaN;
      }
      drawField(disk, img, { nx: N, ny: N, cmap: viridis, vmin: 0, nanColor: null });
    };

    const update = () => {
      const a = val('a'), b = val('b'), sig = val('noise') / 100, lam = 10 ** val('lam');
      const f = Float64Array.from(rc, (r) => profile(kind, r, a, b));
      const fmax = Math.max(...f);
      for (let i = 0; i < n; i++) f[i] /= fmax;
      const p = project(L, f);
      const pmax = Math.max(...p);
      const noisy = (seed: number) => { const r = rng(seed); return Float64Array.from(p, (v) => v + sig * pmax * r.normal()); };
      const pn = noisy(1);
      const fd = onionPeel(L, pn);
      const ft = tikhonov(L, pn, lam);

      // spread over repeated noise draws (UncertaintyBand)
      const R = 30;
      const lo = new Float64Array(n).fill(Infinity), hi = new Float64Array(n).fill(-Infinity);
      const sum = new Float64Array(n), sq = new Float64Array(n);
      if (bandBox.checked && sig > 0) {
        for (let s = 0; s < R; s++) {
          const fr = tikhonov(L, noisy(100 + s), lam);
          for (let i = 0; i < n; i++) { sum[i] += fr[i]; sq[i] += fr[i] * fr[i]; }
        }
        for (let i = 0; i < n; i++) {
          const m = sum[i] / R, sd = Math.sqrt(Math.max(sq[i] / R - m * m, 0));
          lo[i] = m - 2 * sd; hi[i] = m + 2 * sd;
        }
      }
      drawDisk(f);
      pProjR([
        { kind: 'line', x: yr, y: p, cls: 's-physics', label: T.exact },
        { kind: 'points', x: yr, y: pn, cls: 's-data', label: T.noisy },
      ], { xlim: [0, 1] });
      const series: Parameters<typeof pRec.render>[0] = [];
      if (bandBox.checked && sig > 0) series.push({ kind: 'band', x: rc, y: lo, y2: hi, cls: 's-learned', label: T.bandL });
      series.push({ kind: 'line', x: rc, y: f, cls: 's-truth', label: T.truth });
      if (directBox.checked) series.push({ kind: 'line', x: rc, y: fd, cls: 's-warn', label: T.directL });
      series.push({ kind: 'line', x: rc, y: ft, cls: 's-learned', label: T.reg });
      pRecR(series, { xlim: [0, 1], ylim: [-0.4, 1.5] });
      const eD = rms(fd, f), eT = rms(ft, f);
      read.innerHTML = dec(`${T.err}: ${T.dir} <strong>${(100 * eD).toFixed(1)} %</strong>, ${T.regR} <strong>${(100 * eT).toFixed(1)} %</strong>.` +
        (eT > eD ? T.hurt : eD > 3 * eT ? T.helps : ''));
    };

    root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((btn) => btn.addEventListener('click', () => {
      kind = btn.dataset.kind as ProfileKind;
      root.querySelectorAll('[data-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
      update();
    }));
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

<style>
  .disk { max-width: 15rem; aspect-ratio: 1; border-radius: 50%; background: transparent; margin-inline: auto; }
  .wide { grid-column: 1 / -1; }
  [data-abel] .seg { flex-wrap: wrap; }
</style>
