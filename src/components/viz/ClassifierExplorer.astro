---
/**
 * How a neural network learns to classify: 2D datasets, click to add points, a small MLP
 * trained live (cross-entropy, Adam); the class probability is drawn as a background image
 * with the decision boundary. Numerics in src/lib/classifier.ts.
 */
import ParameterSlider from './ParameterSlider.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      dec: ',', dataset: 'Datos', ds: { blobs: 'dos nubes', moons: 'lunas', circles: 'círculos', xor: 'XOR', spiral: 'espiral' },
      npts: 'Puntos de entrenamiento', noise: 'Ruido', layers: 'Capas ocultas', width: 'Neuronas por capa', act: 'Activación',
      feats: 'Entradas', decay: 'Decaimiento de pesos (κ = 10⁻²)', add: 'Clic agrega un punto de clase', train: 'entrenar', pause: 'pausa', cont: 'continuar', reset: 'reiniciar',
      canvas: 'Clases y probabilidad aprendida (clic para agregar puntos)', loss: 'Entropía cruzada durante el entrenamiento', it: 'iteración',
      trainL: 'entrenamiento', testL: 'prueba (datos no vistos)', classA: 'clase A', classB: 'clase B',
      params: 'parámetros', acc: 'exactitud', trainW: 'entrenamiento', testW: 'prueba', far: 'confianza media lejos de los datos', noFeat: 'elija al menos una entrada',
    }
  : {
      dec: '.', dataset: 'Data', ds: { blobs: 'two blobs', moons: 'moons', circles: 'circles', xor: 'XOR', spiral: 'spiral' },
      npts: 'Training points', noise: 'Noise', layers: 'Hidden layers', width: 'Neurons per layer', act: 'Activation',
      feats: 'Inputs', decay: 'Weight decay (κ = 10⁻²)', add: 'Click adds a point of class', train: 'train', pause: 'pause', cont: 'continue', reset: 'reset',
      canvas: 'Classes and learned probability (click to add points)', loss: 'Cross-entropy during training', it: 'iteration',
      trainL: 'training', testL: 'test (unseen data)', classA: 'class A', classB: 'class B',
      params: 'parameters', acc: 'accuracy', trainW: 'training', testW: 'test', far: 'mean confidence far from the data', noFeat: 'choose at least one input',
    };
const feats = [['x', 'x'], ['y', 'y'], ['x2', 'x²'], ['y2', 'y²'], ['xy', 'xy']];
---
<div class="lab clf" data-clf data-text={JSON.stringify(T)}>
  <div class="clf__top">
    <div class="control">
      <span class="control__head">{T.dataset}</span>
      <div class="seg" role="group" aria-label={T.dataset}>
        {(['blobs', 'moons', 'circles', 'xor', 'spiral'] as const).map((d) => <button type="button" data-cf-ds={d} aria-pressed={d === 'circles' ? 'true' : 'false'}>{T.ds[d]}</button>)}
      </div>
    </div>
    <div class="control">
      <span class="control__head">{T.layers}</span>
      <div class="seg" role="group" aria-label={T.layers}>
        {[0, 1, 2].map((n) => <button type="button" data-cf-depth={n} aria-pressed={n === 1 ? 'true' : 'false'}>{n}</button>)}
      </div>
    </div>
    <div class="control">
      <span class="control__head">{T.act}</span>
      <div class="seg" role="group" aria-label={T.act}>
        <button type="button" data-cf-act="tanh" aria-pressed="true">tanh</button>
        <button type="button" data-cf-act="relu" aria-pressed="false">ReLU</button>
      </div>
    </div>
  </div>

  <div class="clf__main">
    <div class="clf__view">
      <p class="panel-title">{T.canvas}</p>
      <canvas class="clf__canvas" data-cf-canvas width="440" height="440" aria-label={T.canvas} role="img"></canvas>
      <p class="meta clf__add">{T.add}
        <span class="seg" role="group" aria-label={T.add}>
          <button type="button" data-cf-cls="0" aria-pressed="true">A</button>
          <button type="button" data-cf-cls="1" aria-pressed="false">B</button>
        </span>
      </p>
    </div>
    <div class="clf__side">
      <div class="clf__grid">
        <ParameterSlider name="cf-n" label={T.npts} min={8} max={300} step={2} value={150} format="int" />
        <ParameterSlider name="cf-noise" label={T.noise} min={0} max={0.35} step={0.01} value={0.08} />
        <ParameterSlider name="cf-width" label={T.width} min={2} max={24} step={1} value={8} format="int" />
      </div>
      <div class="control">
        <span class="control__head">{T.feats}</span>
        <div class="clf__feats">
          {feats.map(([k, lab]) => <label class="meta"><input type="checkbox" data-cf-feat={k} checked={k === 'x' || k === 'y'} /> <i>{lab}</i></label>)}
        </div>
      </div>
      <label class="meta clf__check"><input type="checkbox" data-cf-decay /> {T.decay}</label>
      <p class="clf__btns"><button type="button" class="btn" data-cf-train>{T.pause}</button> <button type="button" class="btn" data-cf-reset>{T.reset}</button></p>
      <p class="lab__readout clf__read" data-cf-read aria-live="polite"></p>
      <p class="panel-title">{T.loss}</p>
      <div class="clf__loss" data-cf-loss></div>
    </div>
  </div>
</div>

<script>
  import { makeDataset, initNet, lossGrad, adam, prob, accuracy, meanLoss, nParams, type DatasetId, type Feature, type Activation, type Point, type Net } from '../../lib/classifier';
  import { LinePlot, cssVar, type Series } from '../../lib/plot';
  import { keyed } from '../../lib/legendkey';

  const L = 2;          // view is [−L, L]²
  const G = 64;         // probability grid resolution
  const MAX = 4000;     // iterations per run

  const hex = (c: string): [number, number, number] => {
    const m = c.trim().match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
    if (m) return [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)];
    const r = c.match(/\d+(\.\d+)?/g);
    return r ? [+r[0], +r[1], +r[2]] : [128, 128, 128];
  };

  function init(root: HTMLElement) {
    const T = JSON.parse(root.dataset.text!);
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const num = (n: string) => +$<HTMLInputElement>(`[name="${n}"]`).value;
    const canvas = $<HTMLCanvasElement>('[data-cf-canvas]');
    const ctx = canvas.getContext('2d')!;
    const grid = document.createElement('canvas');
    grid.width = G; grid.height = G;
    const gctx = grid.getContext('2d')!;
    const lossDiv = $<HTMLElement>('[data-cf-loss]');
    const pLoss = new LinePlot(lossDiv, { width: 420, height: 200, xlabel: T.it, ylabel: 'loss', logy: true, title: T.loss, legend: false });
    const rLoss = keyed(pLoss, lossDiv);
    const read = $<HTMLElement>('[data-cf-read]');
    const btn = $<HTMLButtonElement>('[data-cf-train]');

    let ds: DatasetId = 'circles', depth = 1, act: Activation = 'tanh', addCls: 0 | 1 = 0;
    let train: Point[] = [], test: Point[] = [], net: Net | null = null;
    let it = 0, running = false, visible = true, hI: number[] = [], hTr: number[] = [], hTe: number[] = [], perFrame = 10;
    const probGrid = new Float64Array(G * G);

    const featsOn = (): Feature[] => [...root.querySelectorAll<HTMLInputElement>('[data-cf-feat]')].filter((c) => c.checked).map((c) => c.dataset.cfFeat as Feature);
    const toPx = (v: number) => ((v + L) / (2 * L)) * canvas.width;
    const toPy = (v: number) => ((L - v) / (2 * L)) * canvas.height;

    const regen = () => {
      train = makeDataset(ds, Math.round(num('cf-n')), num('cf-noise'), 1);
      test = makeDataset(ds, 400, num('cf-noise'), 99);
    };
    const rebuild = () => {
      const fs = featsOn();
      net = fs.length ? initNet(fs, Array(depth).fill(Math.round(num('cf-width'))), act, 7) : null;
      it = 0; hI = []; hTr = []; hTe = [];
    };

    const draw = () => {
      const w = canvas.width, h = canvas.height;
      const paper = hex(cssVar('--paper')), ink = hex(cssVar('--ink'));
      const cA = hex(cssVar('--c-physics')), cB = hex(cssVar('--c-data'));
      // background: probability of class B on a coarse grid, upscaled smoothly
      const img = gctx.createImageData(G, G);
      for (let j = 0; j < G; j++) for (let i = 0; i < G; i++) {
        const x = -L + (2 * L * (i + 0.5)) / G, y = L - (2 * L * (j + 0.5)) / G;
        const p = net ? prob(net, { x, y }) : 0.5;
        probGrid[j * G + i] = p;
        const c = p >= 0.5 ? cB : cA, a = Math.abs(p - 0.5) * 2 * 0.55;
        const q = (j * G + i) * 4;
        for (let k = 0; k < 3; k++) img.data[q + k] = Math.round(paper[k] + (c[k] - paper[k]) * a);
        img.data[q + 3] = 255;
      }
      gctx.putImageData(img, 0, 0);
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(grid, 0, 0, w, h);
      // decision boundary p = 0.5 by marching squares on the grid
      if (net) {
        ctx.strokeStyle = `rgb(${ink.join(',')})`; ctx.lineWidth = 1.4; ctx.beginPath();
        const cx = (i: number) => ((i + 0.5) / G) * w, cy = (j: number) => ((j + 0.5) / G) * h;
        for (let j = 0; j < G - 1; j++) for (let i = 0; i < G - 1; i++) {
          const v = [probGrid[j * G + i], probGrid[j * G + i + 1], probGrid[(j + 1) * G + i + 1], probGrid[(j + 1) * G + i]].map((p) => p - 0.5);
          const pts: [number, number][] = [];
          const edge = (a: number, b: number, x0: number, y0: number, x1: number, y1: number) => {
            if ((v[a] < 0) !== (v[b] < 0)) { const t = v[a] / (v[a] - v[b]); pts.push([x0 + (x1 - x0) * t, y0 + (y1 - y0) * t]); }
          };
          edge(0, 1, cx(i), cy(j), cx(i + 1), cy(j));
          edge(1, 2, cx(i + 1), cy(j), cx(i + 1), cy(j + 1));
          edge(2, 3, cx(i + 1), cy(j + 1), cx(i), cy(j + 1));
          edge(3, 0, cx(i), cy(j + 1), cx(i), cy(j));
          for (let k = 0; k + 1 < pts.length; k += 2) { ctx.moveTo(pts[k][0], pts[k][1]); ctx.lineTo(pts[k + 1][0], pts[k + 1][1]); }
        }
        ctx.stroke();
      }
      // axes box of the data region
      ctx.strokeStyle = `rgba(${ink.join(',')},0.25)`; ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
      ctx.strokeRect(toPx(-1.3), toPy(1.3), toPx(1.3) - toPx(-1.3), toPy(-1.3) - toPy(1.3));
      ctx.setLineDash([]);
      // training points
      for (const p of train) {
        ctx.beginPath(); ctx.arc(toPx(p.x), toPy(p.y), 3.6, 0, 2 * Math.PI);
        ctx.fillStyle = `rgb(${(p.c ? cB : cA).join(',')})`; ctx.fill();
        ctx.strokeStyle = `rgb(${paper.join(',')})`; ctx.lineWidth = 1; ctx.stroke();
      }
      // readout and loss curves
      if (!net) { read.textContent = T.noFeat; rLoss([]); return; }
      let far = 0, nf = 0;
      for (let j = 0; j < G; j++) for (let i = 0; i < G; i++) {
        const x = -L + (2 * L * (i + 0.5)) / G, y = L - (2 * L * (j + 0.5)) / G;
        if (Math.max(Math.abs(x), Math.abs(y)) > 1.6) { const p = probGrid[j * G + i]; far += Math.max(p, 1 - p); nf++; }
      }
      read.textContent = `${nParams(net)} ${T.params} · ${T.it} ${it} · ${T.acc}: ${T.trainW} ${(accuracy(net, train) * 100).toFixed(0)}\u00a0%, ${T.testW} ${(accuracy(net, test) * 100).toFixed(0)}\u00a0% · ${T.far} ${(far / nf * 100).toFixed(0)}\u00a0%`;
      const series: Series[] = hI.length ? [
        { kind: 'line', x: hI, y: hTr, cls: 's-learned', label: T.trainL },
        { kind: 'line', x: hI, y: hTe, cls: 's-warn', label: T.testL },
      ] : [];
      rLoss(series, { xlim: [0, MAX], ylim: [1e-3, 3] });
    };

    const loop = () => {
      if (!running || !net) return;
      if (!visible || root.offsetParent === null) { running = false; btn.textContent = T.cont; return; }
      const decay = $<HTMLInputElement>('[data-cf-decay]').checked ? 1e-2 : 0;
      const t0 = performance.now();
      for (let k = 0; k < perFrame && it < MAX; k++, it++) adam(net, lossGrad(net, train, decay).grads, 0.02);
      const dtMs = performance.now() - t0;
      perFrame = Math.max(1, Math.min(60, Math.round(perFrame * (7 / Math.max(dtMs, 0.5)))));
      hI.push(it); hTr.push(Math.max(meanLoss(net, train), 1e-3)); hTe.push(Math.max(meanLoss(net, test), 1e-3));
      draw();
      if (it >= MAX) { running = false; btn.textContent = T.train; return; }
      requestAnimationFrame(loop);
    };
    const start = () => { if (!net) { draw(); return; } running = true; btn.textContent = T.pause; requestAnimationFrame(loop); };
    const restart = () => { running = false; rebuild(); draw(); start(); };

    btn.addEventListener('click', () => {
      if (running) { running = false; btn.textContent = T.cont; return; }
      if (it >= MAX) rebuild();
      start();
    });
    $('[data-cf-reset]').addEventListener('click', () => { regen(); restart(); });
    const segGroup = (attr: string, set: (v: string) => void) => root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll(`[${attr}]`).forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      set(b.getAttribute(attr)!);
    }));
    segGroup('data-cf-ds', (v) => { ds = v as DatasetId; regen(); restart(); });
    segGroup('data-cf-depth', (v) => { depth = +v; restart(); });
    segGroup('data-cf-act', (v) => { act = v as Activation; restart(); });
    segGroup('data-cf-cls', (v) => { addCls = +v as 0 | 1; });
    ['cf-n', 'cf-noise'].forEach((n) => $(`[name="${n}"]`).addEventListener('change', () => { regen(); restart(); }));
    $('[name="cf-width"]').addEventListener('change', restart);
    root.querySelectorAll('[data-cf-feat]').forEach((c) => c.addEventListener('change', restart));
    $('[data-cf-decay]').addEventListener('change', restart);
    canvas.addEventListener('click', (e) => {
      const b = canvas.getBoundingClientRect();
      const x = -L + (2 * L * (e.clientX - b.left)) / b.width, y = L - (2 * L * (e.clientY - b.top)) / b.height;
      train.push({ x, y, c: addCls });
      if (it >= MAX || !running) { it = Math.min(it, MAX - 800); start(); }
      draw();
    });
    window.addEventListener('themechange', draw);
    new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && !running && net && it < MAX) start();
    }).observe(root);

    regen(); rebuild(); draw(); start();
  }

  document.querySelectorAll<HTMLElement>('[data-clf]').forEach((root) => {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); init(root); }
    }, { rootMargin: '100px' });
    io.observe(root);
  });
</script>

<style>
  .clf__top { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); }
  .clf__main { display: grid; gap: var(--s-5); margin-top: var(--s-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 52rem) { .clf__main { grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); align-items: start; } }
  .clf__view { min-width: 0; }
  .clf__canvas { display: block; width: 100%; max-width: 26rem; height: auto; aspect-ratio: 1; margin-inline: auto; outline: 0.5px solid var(--ink-3); cursor: crosshair; background: var(--paper); }
  .clf__add { margin-top: var(--s-2); text-align: center; display: flex; gap: 0.6em; justify-content: center; align-items: baseline; flex-wrap: wrap; }
  .clf__side { display: grid; gap: var(--s-3); min-width: 0; align-content: start; }
  .clf__grid { display: grid; gap: var(--s-3) var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }
  .clf__feats { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; margin-top: 0.2rem; }
  .clf__feats label, .clf__check { display: inline-flex; gap: 0.35em; align-items: baseline; }
  .clf__btns { font-size: var(--step--1); }
  .clf__loss { min-height: 11rem; min-width: 0; }
</style>
