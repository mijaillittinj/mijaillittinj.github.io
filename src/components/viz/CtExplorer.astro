---
/**
 * Computed tomography lab: a phantom is scanned by a rotating parallel beam (the sinogram
 * fills in as the scanner turns), then reconstructed by back-projection, filtered
 * back-projection or SIRT. Numerics in src/lib/ct.ts.
 */
import ParameterSlider from './ParameterSlider.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const T = es
  ? {
      object: 'Objeto', head: 'cabeza (Shepp–Logan)', pipe: 'tubería con grieta',
      method: 'Reconstrucción', bp: 'retroproyección', fbp: 'retroproyección filtrada', sirt: 'iterativa (SIRT)',
      filter: 'Filtro', ramp: 'rampa', sl: 'Shepp–Logan',
      nAng: 'Número de proyecciones', range: 'Rango angular (°)', noise: 'Ruido del detector (%)',
      nonneg: 'Imponer valores no negativos (SIRT)', scan: 'escanear de nuevo', run: 'iterar SIRT', stop: 'detener',
      pObj: '(a) Objeto y haz', pSino: '(b) Sinograma', pRec: '(c) Reconstrucción', pProf: 'Perfil por el centro de la imagen',
      sinoX: 'posición en el detector →', sinoY: 'ángulo ↓',
      truth: 'objeto', rec: 'reconstrucción', xl: 'posición (píxeles)', yl: 'valor',
      pIt: 'Error de SIRT según la iteración', it: 'iteración',
      scanning: 'escaneando', angle: 'ángulo', views: 'proyecciones', psnr: 'PSNR', rmse: 'error RMS', best: 'mejor PSNR en la iteración',
    }
  : {
      object: 'Object', head: 'head (Shepp–Logan)', pipe: 'pipe with a crack',
      method: 'Reconstruction', bp: 'back-projection', fbp: 'filtered back-projection', sirt: 'iterative (SIRT)',
      filter: 'Filter', ramp: 'ramp', sl: 'Shepp–Logan',
      nAng: 'Number of projections', range: 'Angular range (°)', noise: 'Detector noise (%)',
      nonneg: 'Enforce non-negative values (SIRT)', scan: 'scan again', run: 'run SIRT', stop: 'stop',
      pObj: '(a) Object and beam', pSino: '(b) Sinogram', pRec: '(c) Reconstruction', pProf: 'Profile through the centre of the image',
      sinoX: 'detector position →', sinoY: 'angle ↓',
      truth: 'object', rec: 'reconstruction', xl: 'position (pixels)', yl: 'value',
      pIt: 'SIRT error by iteration', it: 'iteration',
      scanning: 'scanning', angle: 'angle', views: 'projections', psnr: 'PSNR', rmse: 'RMS error', best: 'best PSNR at iteration',
    };
---
<div class="lab ct" data-ct data-text={JSON.stringify(T)}>
  <div class="ct__panels">
    <div>
      <p class="panel-title">{T.pObj}</p>
      <div class="ct__frame"><canvas data-ct-obj aria-hidden="true"></canvas><canvas class="ct__beam" data-ct-beam aria-hidden="true"></canvas></div>
    </div>
    <div>
      <p class="panel-title">{T.pSino}</p>
      <div class="ct__frame ct__frame--sino"><canvas data-ct-sino aria-hidden="true"></canvas></div>
      <p class="ct__axes"><span>{T.sinoX}</span><span>{T.sinoY}</span></p>
    </div>
    <div>
      <p class="panel-title">{T.pRec}</p>
      <div class="ct__frame"><canvas data-ct-rec aria-hidden="true"></canvas></div>
    </div>
  </div>

  <div class="ct__controls">
    <div class="control">
      <span class="control__head">{T.object}</span>
      <div class="seg" role="group" aria-label={T.object}>
        <button type="button" data-ct-kind="head" aria-pressed="true">{T.head}</button>
        <button type="button" data-ct-kind="pipe" aria-pressed="false">{T.pipe}</button>
      </div>
    </div>
    <div class="control">
      <span class="control__head">{T.method}</span>
      <div class="seg" role="group" aria-label={T.method}>
        <button type="button" data-ct-method="bp" aria-pressed="false">{T.bp}</button>
        <button type="button" data-ct-method="fbp" aria-pressed="true">{T.fbp}</button>
        <button type="button" data-ct-method="sirt" aria-pressed="false">{T.sirt}</button>
      </div>
    </div>
    <div class="control" data-ct-filterbox>
      <span class="control__head">{T.filter}</span>
      <div class="seg" role="group" aria-label={T.filter}>
        <button type="button" data-ct-filter="ramp" aria-pressed="true">{T.ramp}</button>
        <button type="button" data-ct-filter="shepp-logan" aria-pressed="false">{T.sl}</button>
      </div>
    </div>
    <ParameterSlider name="ctang" label={T.nAng} min={4} max={180} step={1} value={30} format="int" />
    <ParameterSlider name="ctrange" label={T.range} min={60} max={180} step={5} value={180} format="int" />
    <ParameterSlider name="ctnoise" label={T.noise} min={0} max={10} step={0.5} value={1} format="fixed2" />
    <label class="meta ct__check"><input type="checkbox" data-ct-nonneg checked /> {T.nonneg}</label>
    <p class="ct__btns"><button type="button" class="btn" data-ct-scan>{T.scan}</button> <button type="button" class="btn" data-ct-run hidden>{T.run}</button></p>
  </div>
  <p class="lab__readout ct__read" data-ct-read aria-live="polite">&nbsp;</p>

  <div class="ct__plots">
    <div>
      <p class="panel-title">{T.pProf}</p>
      <div class="ct__plot" data-ct-prof></div>
    </div>
    <div data-ct-itbox hidden>
      <p class="panel-title">{T.pIt}</p>
      <div class="ct__plot" data-ct-it></div>
    </div>
  </div>
</div>

<script>
  import { phantom, angles, radon, filterSinogram, backproject, makeSirt, quality, type PhantomKind, type FilterKind } from '../../lib/ct';
  import { rng } from '../../lib/linalg';
  import { drawField, LinePlot, cssVar, type RGB } from '../../lib/plot';
  import { keyed } from '../../lib/legendkey';

  const N = 96;
  const grey = (t: number): RGB => { const v = Math.round(255 * Math.max(0, Math.min(1, t))); return [v, v, v]; };

  function init(root: HTMLElement) {
    const T = JSON.parse(root.dataset.text!);
    const dec = document.documentElement.lang === 'es' ? ',' : '.';
    const nf = (v: number, d: number) => v.toFixed(d).replace('.', dec);
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const val = (name: string) => +$<HTMLInputElement>(`[name="${name}"]`).value;
    const cObj = $<HTMLCanvasElement>('[data-ct-obj]'), cBeam = $<HTMLCanvasElement>('[data-ct-beam]');
    const cSino = $<HTMLCanvasElement>('[data-ct-sino]'), cRec = $<HTMLCanvasElement>('[data-ct-rec]');
    const read = $<HTMLElement>('[data-ct-read]');
    const runBtn = $<HTMLButtonElement>('[data-ct-run]');
    const nonneg = $<HTMLInputElement>('[data-ct-nonneg]');
    const itBox = $<HTMLElement>('[data-ct-itbox]');
    const pProf = new LinePlot($('[data-ct-prof]'), { width: 560, height: 220, xlabel: T.xl, ylabel: T.yl, legend: false, title: T.pProf });
    const pProfR = keyed(pProf, $('[data-ct-prof]'));
    const pIt = new LinePlot($('[data-ct-it]'), { width: 420, height: 220, xlabel: T.it, ylabel: 'PSNR (dB)', legend: false, title: T.pIt });

    let kind: PhantomKind = 'head', method: 'bp' | 'fbp' | 'sirt' = 'fbp', filter: FilterKind = 'ramp';
    let truth = phantom(N, kind);
    let th: Float64Array = angles(30), sino: Float64Array = new Float64Array(0), filt: Float64Array = new Float64Array(0);
    let acc: Float64Array = new Float64Array(N * N), done = 0, raf = 0, scanning = false;
    let sirt: ReturnType<typeof makeSirt> | null = null, sirtRunning = false, psnrHist: number[] = [];
    const win = () => (kind === 'head' ? 0.5 : 1); // display window [0, win]

    const drawImg = (c: HTMLCanvasElement, f: ArrayLike<number>) => drawField(c, f, { nx: N, ny: N, cmap: grey, vmin: 0, vmax: win() });

    const drawBeam = (theta: number | null) => {
      const w = cBeam.clientWidth || 240;
      cBeam.width = w * devicePixelRatio; cBeam.height = w * devicePixelRatio;
      const ctx = cBeam.getContext('2d')!;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      ctx.clearRect(0, 0, w, w);
      if (theta === null) return;
      const cx = w / 2, R = w / 2;
      // rays: direction (−sin θ, cos θ) in image coordinates (y up); canvas y points down
      const c = Math.cos(theta), s = Math.sin(theta);
      ctx.strokeStyle = cssVar('--c-data') || '#b4531a';
      ctx.globalAlpha = 0.55; ctx.lineWidth = 1;
      for (let k = -6; k <= 6; k++) {
        const off = (k / 6) * R * 0.95;
        const px = cx + off * c, py = cx - off * s;
        ctx.beginPath();
        ctx.moveTo(px + R * s, py + R * c);
        ctx.lineTo(px - R * s, py - R * c);
        ctx.stroke();
      }
      // detector bar on the far side
      ctx.globalAlpha = 1; ctx.lineWidth = 3;
      const dx = cx - R * 0.98 * s, dy = cx - R * 0.98 * c;
      ctx.beginPath(); ctx.moveTo(dx - R * c, dy + R * s); ctx.lineTo(dx + R * c, dy - R * s); ctx.stroke();
    };

    const drawSino = () => {
      const shown = new Float64Array(sino.length);
      shown.set(sino.subarray(0, done * N));
      let mx = 0;
      for (const v of sino) mx = Math.max(mx, v);
      drawField(cSino, shown, { nx: N, ny: th.length, cmap: grey, vmin: 0, vmax: mx || 1, originLower: false });
    };

    const currentRec = (): Float64Array => {
      if (method === 'sirt') return sirt ? sirt.x : new Float64Array(N * N);
      const dth = ((val('ctrange') / th.length) * Math.PI) / 180;
      const out = new Float64Array(N * N);
      if (method === 'bp') {
        // unfiltered back-projection, rescaled so that its mean matches the object's (for display)
        let sum = 0, mass = 0;
        for (const v of acc) sum += v;
        for (let d = 0; d < N; d++) mass += sino[d];
        const sc = sum > 0 ? mass / sum : 1;
        for (let p = 0; p < out.length; p++) out[p] = acc[p] * sc;
      } else for (let p = 0; p < out.length; p++) out[p] = acc[p] * dth;
      return out;
    };

    const report = (rec: Float64Array) => {
      drawImg(cRec, rec);
      const q = quality(rec, truth, N);
      const mid = Math.floor(N / 2), xs = Array.from({ length: N }, (_, i) => i);
      pProfR([
        { kind: 'line', x: xs, y: Array.from(truth.subarray(mid * N, (mid + 1) * N)), cls: 's-truth', label: T.truth },
        { kind: 'line', x: xs, y: Array.from(rec.subarray(mid * N, (mid + 1) * N)), cls: 's-learned', label: T.rec },
      ], { ylim: [-0.3, 1.3] });
      let msg = `${th.length} ${T.views} · ${T.psnr} ${nf(q.psnr, 1)} dB · ${T.rmse} ${nf(q.rmse, 3)}`;
      if (method === 'sirt' && sirt) {
        const best = psnrHist.indexOf(Math.max(...psnrHist));
        msg += ` · ${T.it} ${sirt.iter}` + (psnrHist.length > 5 ? ` · ${T.best} ${best + 1} (${nf(psnrHist[best], 1)} dB)` : '');
        pIt.render([{ kind: 'line', x: psnrHist.map((_, i) => i + 1), y: psnrHist, cls: 's-learned' }]);
      }
      read.textContent = msg;
    };

    const stopAll = () => { cancelAnimationFrame(raf); scanning = false; sirtRunning = false; runBtn.textContent = T.run; };

    const sirtLoop = () => {
      if (!sirtRunning || !sirt || root.offsetParent === null) { stopAll(); return; }
      const t0 = performance.now();
      do { sirt.step(); psnrHist.push(quality(sirt.x, truth, N).psnr); } while (performance.now() - t0 < 6 && sirt.iter < 300);
      report(sirt.x);
      if (sirt.iter >= 300) { stopAll(); return; }
      raf = requestAnimationFrame(sirtLoop);
    };
    const startSirt = () => {
      stopAll();
      sirt = makeSirt(sino, N, th, nonneg.checked); psnrHist = [];
      sirtRunning = true; runBtn.textContent = T.stop;
      raf = requestAnimationFrame(sirtLoop);
    };

    const scanLoop = () => {
      if (!scanning) return;
      // reveal about 1.2 s worth of scanning regardless of the number of angles
      const per = Math.max(1, Math.ceil(th.length / 70));
      for (let k = 0; k < per && done < th.length; k++, done++) {
        if (method !== 'sirt') {
          const proj = filt.subarray(done * N, (done + 1) * N);
          const one = backproject(proj, N, [th[done]]);
          for (let p = 0; p < acc.length; p++) acc[p] += one[p];
        }
      }
      drawSino();
      drawBeam(done < th.length ? th[Math.min(done, th.length - 1)] : null);
      if (method !== 'sirt') report(currentRec());
      else read.textContent = `${T.scanning} · ${T.angle} ${((th[Math.min(done, th.length - 1)] * 180) / Math.PI).toFixed(0)}°`;
      if (done >= th.length) {
        scanning = false; drawBeam(null);
        if (method === 'sirt') startSirt();
        return;
      }
      raf = requestAnimationFrame(scanLoop);
    };

    const scan = () => {
      stopAll();
      truth = phantom(N, kind);
      drawImg(cObj, truth);
      th = angles(val('ctang'), val('ctrange'));
      const clean = radon(truth, N, th);
      let mx = 0;
      for (const v of clean) mx = Math.max(mx, v);
      const R = rng(5), nl = val('ctnoise') / 100;
      sino = Float64Array.from(clean, (v) => v + nl * mx * R.normal());
      filt = method === 'bp' ? Float64Array.from(sino) : filterSinogram(sino, N, th.length, filter);
      acc = new Float64Array(N * N); done = 0; sirt = null; psnrHist = [];
      scanning = true;
      raf = requestAnimationFrame(scanLoop);
    };

    const syncUi = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-ct-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ctKind === kind)));
      root.querySelectorAll<HTMLButtonElement>('[data-ct-method]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ctMethod === method)));
      root.querySelectorAll<HTMLButtonElement>('[data-ct-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ctFilter === filter)));
      $<HTMLElement>('[data-ct-filterbox]').hidden = method !== 'fbp';
      runBtn.hidden = method !== 'sirt';
      itBox.hidden = method !== 'sirt';
      nonneg.closest('label')!.hidden = method !== 'sirt';
    };

    root.querySelectorAll<HTMLButtonElement>('[data-ct-kind]').forEach((b) => b.addEventListener('click', () => { kind = b.dataset.ctKind as PhantomKind; syncUi(); scan(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-ct-method]').forEach((b) => b.addEventListener('click', () => { method = b.dataset.ctMethod as typeof method; syncUi(); scan(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-ct-filter]').forEach((b) => b.addEventListener('click', () => { filter = b.dataset.ctFilter as FilterKind; syncUi(); scan(); }));
    let timer = 0;
    ['ctang', 'ctrange', 'ctnoise'].forEach((n) => $<HTMLInputElement>(`[name="${n}"]`).addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(scan, 200); }));
    nonneg.addEventListener('change', () => { if (method === 'sirt' && !scanning) startSirt(); });
    $<HTMLButtonElement>('[data-ct-scan]').addEventListener('click', scan);
    runBtn.addEventListener('click', () => (sirtRunning ? stopAll() : startSirt()));

    syncUi();
    scan();
  }

  document.querySelectorAll<HTMLElement>('[data-ct]').forEach((root) => {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); init(root); } }, { rootMargin: '200px' });
    io.observe(root);
  });
</script>

<style>
  .ct [hidden] { display: none !important; }
  .ct__panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); max-width: 44rem; margin-inline: auto; }
  .ct__frame { position: relative; aspect-ratio: 1; background: #000; }
  .ct__frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ct__frame--sino { background: #000; }
  .ct__beam { pointer-events: none; }
  .ct__axes { display: flex; justify-content: space-between; font-size: var(--step--2); color: var(--ink-3); font-style: italic; margin-top: 0.2rem; }
  .ct__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s-3) var(--s-5); margin-top: var(--s-4); align-items: start; }
  .ct__check { display: flex; gap: 0.4em; align-items: baseline; }
  .ct__btns { font-size: var(--step--1); }
  .ct__read { text-align: center; margin-top: var(--s-3); min-height: 1.5em; }
  .ct__plots { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); margin-top: var(--s-3); }
  .ct__plots > * { min-width: 0; }
  .ct__plot { min-height: 12rem; }
  @media (max-width: 34rem) { .ct__panels { gap: var(--s-2); } .ct__panels :global(.panel-title) { font-size: var(--step--2); } .ct__axes { display: none; } }
</style>
