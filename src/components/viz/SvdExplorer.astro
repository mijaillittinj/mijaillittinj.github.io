---
/**
 * Why inversion amplifies noise: singular values of a blur operator, the Picard plot,
 * truncated SVD and Tikhonov filtering, and the L-curve with the current choice marked.
 */
import ParameterSlider from './ParameterSlider.astro';
---
<div class="lab" data-svd>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="blur" label="Blur width (fraction of the domain)" min={0.015} max={0.06} step={0.005} value={0.035} format="fixed3" />
      <ParameterSlider name="noise" label="Noise level log₁₀(σ / max g)" min={-8} max={-1} step={0.25} value={-3} />
      <div class="control">
        <span class="control__head">Regularisation</span>
        <div class="seg" role="group" aria-label="Regularisation method">
          <button type="button" data-method="tsvd" aria-pressed="true">Truncated SVD</button>
          <button type="button" data-method="tik" aria-pressed="false">Tikhonov</button>
        </div>
      </div>
      <ParameterSlider name="k" label="TSVD: number of components k" min={1} max={64} step={1} value={18} format="int" />
      <ParameterSlider name="lam" label="Tikhonov: log₁₀ λ" min={-10} max={0} step={0.1} value={-3} />
      <p class="lab__readout" data-svd-read aria-live="polite"></p>
    </div>
    <div class="lab__plots">
      <div>
        <p class="panel-title">Singular values and Picard plot</p>
        <div class="svd__plot" data-svd-pic></div>
      </div>
      <div>
        <p class="panel-title">L-curve (Tikhonov)</p>
        <div class="svd__plot" data-svd-l></div>
      </div>
      <div class="wide">
        <p class="panel-title">Signal, blurred data and reconstruction</p>
        <div class="svd__plot" data-svd-rec></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { keyed } from '../../lib/legendkey';
  import { svd, uTg, tsvd, tikhonovSVD, lcurve, blurOperator, testSignal, type SVD } from '../../lib/svd';
  import { matvec, rng } from '../../lib/linalg';
  import { LinePlot } from '../../lib/plot';

  document.querySelectorAll<HTMLElement>('[data-svd]').forEach((root) => {
    const n = 64;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const val = (name: string) => +$<HTMLInputElement>(`[name="${name}"]`).value;
    const pPic = new LinePlot($('[data-svd-pic]'), { width: 420, height: 280, xlabel: 'index i', logy: true, title: 'Picard plot' , legend: false});
    const pPicR = keyed(pPic, $('[data-svd-pic]'));
    const pL = new LinePlot($('[data-svd-l]'), { width: 420, height: 280, xlabel: 'log₁₀ ‖Ax − g‖', ylabel: 'log₁₀ ‖x‖', title: 'L-curve' , legend: false});
    const pLR = keyed(pL, $('[data-svd-l]'));
    const pRec = new LinePlot($('[data-svd-rec]'), { width: 860, height: 300, xlabel: 'position x', ylabel: 'value', title: 'Reconstruction' , legend: false});
    const pRecR = keyed(pRec, $('[data-svd-rec]'));
    const read = $<HTMLElement>('[data-svd-read]');
    const f = testSignal(n);
    const xs = Float64Array.from({ length: n }, (_, i) => (i + 0.5) / n);
    const idx = Array.from({ length: n }, (_, i) => i + 1);
    const unit = (() => { const R = rng(21); return Float64Array.from({ length: n }, () => R.normal()); })();
    let method: 'tsvd' | 'tik' = 'tsvd';
    let blur = -1, A = blurOperator(n, 0.035), d: SVD = svd(A);

    const norm = (v: ArrayLike<number>) => Math.sqrt(Array.from(v).reduce((s, x) => s + x * x, 0));

    const update = () => {
      if (val('blur') !== blur) { blur = val('blur'); A = blurOperator(n, blur); d = svd(A); }
      const g0 = matvec(A, f);
      const gmax = Math.max(...g0);
      const sig = 10 ** val('noise') * gmax;
      const g = Float64Array.from(g0, (v, i) => v + sig * unit[i]);
      const beta = uTg(d, g);
      const k = Math.round(val('k')), lam = 10 ** val('lam');
      const x = method === 'tsvd' ? tsvd(d, beta, k) : tikhonovSVD(d, beta, lam);
      const ax = matvec(A, x);
      const res = norm(Array.from(ax, (v, i) => v - g[i])), sol = norm(x);

      // Picard plot
      const floor = 1e-18;
      const absB = Array.from(beta, (b) => Math.max(Math.abs(b), floor));
      const ratio = absB.map((b, i) => Math.max(b / Math.max(d.s[i], floor), floor));
      const cut = method === 'tsvd' ? k + 0.5 : Math.max(0.5, d.s.findIndex((s) => s < lam) + 0.5 || n + 0.5);
      pPicR([
        { kind: 'line', x: idx, y: Array.from(d.s, (s) => Math.max(s, floor)), cls: 's-physics', label: 'σᵢ' },
        { kind: 'points', x: idx, y: absB, cls: 's-data', label: '|uᵢᵀg|' },
        { kind: 'line', x: idx, y: ratio, cls: 's-warn', label: '|uᵢᵀg| / σᵢ' },
        { kind: 'line', x: [cut, cut], y: [1e-17, 1e5], cls: 's-muted', dash: true },
      ], { xlim: [1, n], ylim: [1e-17, 1e5] });

      // L-curve
      const lams = Array.from({ length: 60 }, (_, i) => 10 ** (-12 + (i * 12) / 59));
      const gn2 = Array.from(g).reduce((s, v) => s + v * v, 0);
      const L = lcurve(d, beta, gn2, lams);
      const lx = L.res.map((r) => Math.log10(Math.max(r, 1e-20))), ly = L.sol.map((s) => Math.log10(Math.max(s, 1e-20)));
      pLR([
        { kind: 'line', x: lx, y: ly, cls: 's-physics', label: 'Tikhonov, all λ' },
        { kind: 'points', x: [Math.log10(Math.max(res, 1e-20))], y: [Math.log10(Math.max(sol, 1e-20))], cls: 's-learned', label: 'current choice' },
      ], { ylim: [Math.min(...ly) - 0.3, Math.min(Math.max(...ly), 12) + 0.3] });

      // reconstruction
      const clip = (v: number) => Math.max(-1, Math.min(2.2, v));
      pRecR([
        { kind: 'line', x: xs, y: f, cls: 's-truth', label: 'true signal f' },
        { kind: 'points', x: xs, y: g, cls: 's-data', label: 'blurred, noisy data g' },
        { kind: 'line', x: xs, y: Array.from(x, clip), cls: 's-learned', label: method === 'tsvd' ? `TSVD, k = ${k}` : `Tikhonov, λ = 1e${val('lam').toFixed(1)}` },
      ], { xlim: [0, 1], ylim: [-0.6, 1.8] });

      const err = norm(Array.from(x, (v, i) => v - f[i])) / norm(f);
      read.innerHTML = `Condition number <strong>${(d.s[0] / d.s[n - 1]).toExponential(1)}</strong>. ` +
        `Relative error of the reconstruction <strong>${err < 100 ? (err * 100).toFixed(1) + ' %' : err.toExponential(1)}</strong>. ` +
        `Residual ‖Ax − g‖ = ${res.toExponential(1)}, noise ‖ε‖ ≈ ${(sig * Math.sqrt(n)).toExponential(1)}.`;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-method]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.method as 'tsvd' | 'tik';
      root.querySelectorAll('[data-method]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      update();
    }));
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

<style>
  .wide { grid-column: 1 / -1; }
  .svd__plot { min-height: 13rem; }
</style>
