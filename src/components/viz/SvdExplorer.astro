---
/**
 * Why inversion amplifies noise: singular values of a blur operator, the Picard plot,
 * truncated SVD and Tikhonov filtering, and the L-curve with the current choice marked.
 */
import ParameterSlider from './ParameterSlider.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const T = lang === 'es'
  ? {
      comma: true,
      blur: 'Ancho del desenfoque (fracción del dominio)', noise: 'Nivel de ruido log₁₀(σ / máx g)', reg: 'Regularización', regAria: 'Método de regularización',
      tsvd: 'SVD truncada', tik: 'Tikhonov', k: 'SVD truncada: número de componentes k', lam: 'Tikhonov: log₁₀ λ',
      pPic: 'Valores singulares y gráfico de Picard', pL: 'Curva L (Tikhonov)', pRec: 'Señal, datos desenfocados y reconstrucción',
      xPic: 'índice i', tPic: 'Gráfico de Picard', tL: 'Curva L', xRec: 'posición x', yRec: 'valor', tRec: 'Reconstrucción',
      allLam: 'Tikhonov, todos los λ', current: 'elección actual', truth: 'señal verdadera f', data: 'datos desenfocados y con ruido g',
      cond: 'Número de condición', relErr: 'Error relativo de la reconstrucción', residual: 'Residuo', noiseW: 'ruido',
    }
  : {
      blur: 'Blur width (fraction of the domain)', noise: 'Noise level log₁₀(σ / max g)', reg: 'Regularisation', regAria: 'Regularisation method',
      tsvd: 'Truncated SVD', tik: 'Tikhonov', k: 'TSVD: number of components k', lam: 'Tikhonov: log₁₀ λ',
      pPic: 'Singular values and Picard plot', pL: 'L-curve (Tikhonov)', pRec: 'Signal, blurred data and reconstruction',
      xPic: 'index i', tPic: 'Picard plot', tL: 'L-curve', xRec: 'position x', yRec: 'value', tRec: 'Reconstruction',
      allLam: 'Tikhonov, all λ', current: 'current choice', truth: 'true signal f', data: 'blurred, noisy data g',
      cond: 'Condition number', relErr: 'Relative error of the reconstruction', residual: 'Residual', noiseW: 'noise',
    };
---
<div class="lab" data-svd data-t={JSON.stringify(T)}>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="blur" label={T.blur} min={0.015} max={0.06} step={0.005} value={0.035} format="fixed3" />
      <ParameterSlider name="noise" label={T.noise} min={-8} max={-1} step={0.25} value={-3} />
      <div class="control">
        <span class="control__head">{T.reg}</span>
        <div class="seg" role="group" aria-label={T.regAria}>
          <button type="button" data-method="tsvd" aria-pressed="true">{T.tsvd}</button>
          <button type="button" data-method="tik" aria-pressed="false">{T.tik}</button>
        </div>
      </div>
      <ParameterSlider name="k" label={T.k} min={1} max={64} step={1} value={18} format="int" />
      <ParameterSlider name="lam" label={T.lam} min={-10} max={0} step={0.1} value={-3} />
      <p class="lab__readout" data-svd-read aria-live="polite"></p>
    </div>
    <div class="lab__plots">
      <div>
        <p class="panel-title">{T.pPic}</p>
        <div class="svd__plot" data-svd-pic></div>
      </div>
      <div>
        <p class="panel-title">{T.pL}</p>
        <div class="svd__plot" data-svd-l></div>
      </div>
      <div class="wide">
        <p class="panel-title">{T.pRec}</p>
        <div class="svd__plot" data-svd-rec></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { keyed } from '../../lib/legendkey';
  import { svd, uTg, tsvd, tikhonovSVD, lcurve, blurOperator, testSignal, type SVD } from '../../lib/svd';
  import { matvec, rng } from '../../lib/linalg';
  import { LinePlot } from '../../lib/plot';

  document.querySelectorAll<HTMLElement>('[data-svd]').forEach((root) => {
    const T = JSON.parse(root.dataset.t!);
    // Spanish readouts use a decimal comma
    const dec = (t: string) => (T.comma ? t.replace(/(\d)\.(\d)/g, '$1,$2') : t);
    const n = 64;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const val = (name: string) => +$<HTMLInputElement>(`[name="${name}"]`).value;
    const pPic = new LinePlot($('[data-svd-pic]'), { width: 420, height: 280, xlabel: T.xPic, logy: true, title: T.tPic, legend: false});
    const pPicR = keyed(pPic, $('[data-svd-pic]'));
    const pL = new LinePlot($('[data-svd-l]'), { width: 420, height: 280, xlabel: 'log₁₀ ‖Ax − g‖', ylabel: 'log₁₀ ‖x‖', title: T.tL, legend: false});
    const pLR = keyed(pL, $('[data-svd-l]'));
    const pRec = new LinePlot($('[data-svd-rec]'), { width: 860, height: 300, xlabel: T.xRec, ylabel: T.yRec, title: T.tRec, legend: false});
    const pRecR = keyed(pRec, $('[data-svd-rec]'));
    const read = $<HTMLElement>('[data-svd-read]');
    const f = testSignal(n);
    const xs = Float64Array.from({ length: n }, (_, i) => (i + 0.5) / n);
    const idx = Array.from({ length: n }, (_, i) => i + 1);
    const unit = (() => { const R = rng(21); return Float64Array.from({ length: n }, () => R.normal()); })();
    let method: 'tsvd' | 'tik' = 'tsvd';
    let blur = -1, A = blurOperator(n, 0.035), d: SVD = svd(A);

    const norm = (v: ArrayLike<number>) => Math.sqrt(Array.from(v).reduce((s, x) => s + x * x, 0));

    const update = () => {
      if (val('blur') !== blur) { blur = val('blur'); A = blurOperator(n, blur); d = svd(A); }
      const g0 = matvec(A, f);
      const gmax = Math.max(...g0);
      const sig = 10 ** val('noise') * gmax;
      const g = Float64Array.from(g0, (v, i) => v + sig * unit[i]);
      const beta = uTg(d, g);
      const k = Math.round(val('k')), lam = 10 ** val('lam');
      const x = method === 'tsvd' ? tsvd(d, beta, k) : tikhonovSVD(d, beta, lam);
      const ax = matvec(A, x);
      const res = norm(Array.from(ax, (v, i) => v - g[i])), sol = norm(x);

      // Picard plot
      const floor = 1e-18;
      const absB = Array.from(beta, (b) => Math.max(Math.abs(b), floor));
      const ratio = absB.map((b, i) => Math.max(b / Math.max(d.s[i], floor), floor));
      const cut = method === 'tsvd' ? k + 0.5 : Math.max(0.5, d.s.findIndex((s) => s < lam) + 0.5 || n + 0.5);
      pPicR([
        { kind: 'line', x: idx, y: Array.from(d.s, (s) => Math.max(s, floor)), cls: 's-physics', label: 'σᵢ' },
        { kind: 'points', x: idx, y: absB, cls: 's-data', label: '|uᵢᵀg|' },
        { kind: 'line', x: idx, y: ratio, cls: 's-warn', label: '|uᵢᵀg| / σᵢ' },
        { kind: 'line', x: [cut, cut], y: [1e-17, 1e5], cls: 's-muted', dash: true },
      ], { xlim: [1, n], ylim: [1e-17, 1e5] });

      // L-curve
      const lams = Array.from({ length: 60 }, (_, i) => 10 ** (-12 + (i * 12) / 59));
      const gn2 = Array.from(g).reduce((s, v) => s + v * v, 0);
      const L = lcurve(d, beta, gn2, lams);
      const lx = L.res.map((r) => Math.log10(Math.max(r, 1e-20))), ly = L.sol.map((s) => Math.log10(Math.max(s, 1e-20)));
      pLR([
        { kind: 'line', x: lx, y: ly, cls: 's-physics', label: T.allLam },
        { kind: 'points', x: [Math.log10(Math.max(res, 1e-20))], y: [Math.log10(Math.max(sol, 1e-20))], cls: 's-learned', label: T.current },
      ], { ylim: [Math.min(...ly) - 0.3, Math.min(Math.max(...ly), 12) + 0.3] });

      // reconstruction
      const clip = (v: number) => Math.max(-1, Math.min(2.2, v));
      pRecR([
        { kind: 'line', x: xs, y: f, cls: 's-truth', label: T.truth },
        { kind: 'points', x: xs, y: g, cls: 's-data', label: T.data },
        { kind: 'line', x: xs, y: Array.from(x, clip), cls: 's-learned', label: method === 'tsvd' ? `TSVD, k = ${k}` : `Tikhonov, λ = 1e${val('lam').toFixed(1)}` },
      ], { xlim: [0, 1], ylim: [-0.6, 1.8] });

      const err = norm(Array.from(x, (v, i) => v - f[i])) / norm(f);
      read.innerHTML = dec(`${T.cond} <strong>${(d.s[0] / d.s[n - 1]).toExponential(1)}</strong>. ` +
        `${T.relErr} <strong>${err < 100 ? (err * 100).toFixed(1) + ' %' : err.toExponential(1)}</strong>. ` +
        `${T.residual} ‖Ax − g‖ = ${res.toExponential(1)}, ${T.noiseW} ‖ε‖ ≈ ${(sig * Math.sqrt(n)).toExponential(1)}.`);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-method]').forEach((b) => b.addEventListener('click', () => {
      method = b.dataset.method as 'tsvd' | 'tik';
      root.querySelectorAll('[data-method]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      update();
    }));
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>

<style>
  .wide { grid-column: 1 / -1; }
  .svd__plot { min-height: 13rem; }
</style>
