---
/**
 * Tracking a drone with a Kalman filter: truth, noisy GPS fixes, the estimate and its
 * 2σ covariance ellipse, animated; measurement and process noise sliders.
 */
import ParameterSlider from './ParameterSlider.astro';
---
<div class="lab" data-kalman>
  <div class="lab__grid">
    <div class="lab__controls">
      <ParameterSlider name="r" label="GPS noise σ (m)" min={0.5} max={8} step={0.5} value={3} unit=" m" />
      <ParameterSlider name="q" label="Process noise in the filter, log₁₀ q" min={-5} max={1} step={0.1} value={-1.5} hint="How much the filter expects the drone to accelerate." />
      <label class="meta"><input type="checkbox" data-kf-meas checked /> Show GPS fixes</label>
      <label class="meta"><input type="checkbox" data-kf-ell checked /> Show the 2σ uncertainty ellipse</label>
      <p class="meta"><button type="button" class="btn btn--primary" data-kf-play>Play</button> <button type="button" class="btn" data-kf-restart>Restart</button></p>
      <p class="lab__readout" data-kf-read aria-live="polite"></p>
    </div>
    <div class="lab__plots">
      <div class="wide kf__mapwrap">
        <p class="panel-title">Field of view, 100 m × 100 m</p>
        <canvas class="kf__map" data-kf-map width="600" height="600" role="img" aria-label="Drone trajectory, GPS fixes and Kalman estimate"></canvas>
        <p class="meta kf__key"><span class="key key--truth"></span>true path <span class="key key--data"></span>GPS fixes <span class="key key--learned"></span>Kalman estimate</p>
      </div>
      <div class="wide">
        <p class="panel-title">Position error over time</p>
        <div class="kf__plot" data-kf-err></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { keyed } from '../../lib/legendkey';
  import { scenario, init, predict, update, ellipse, type KF } from '../../lib/kalman';
  import { LinePlot, cssVar } from '../../lib/plot';

  document.querySelectorAll<HTMLElement>('[data-kalman]').forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const val = (name: string) => +$<HTMLInputElement>(`[name="${name}"]`).value;
    const canvas = $<HTMLCanvasElement>('[data-kf-map]');
    const ctx = canvas.getContext('2d')!;
    const pErr = new LinePlot($('[data-kf-err]'), { width: 860, height: 220, xlabel: 'time (s)', ylabel: 'error (m)', title: 'Error' , legend: false});
    const pErrR = keyed(pErr, $('[data-kf-err]'));
    const read = $<HTMLElement>('[data-kf-read]');
    const btn = $<HTMLButtonElement>('[data-kf-play]');
    const measBox = $<HTMLInputElement>('[data-kf-meas]'), ellBox = $<HTMLInputElement>('[data-kf-ell]');
    const N = 300, dt = 1;
    let sc: ReturnType<typeof scenario>, kf: KF, k = 0, est: [number, number][] = [], gain = 0, running = false, frame = 0;
    let eM: number[] = [], eK: number[] = [];

    const restart = () => {
      const r = val('r');
      sc = scenario(N, dt, r, 5);
      kf = init(sc.meas[0], r);
      k = 0; est = [[kf.s[0], kf.s[1]]]; eM = [Math.hypot(sc.meas[0][0] - sc.truth[0][0], sc.meas[0][1] - sc.truth[0][1])]; eK = [eM[0]];
      draw();
    };
    const advance = () => {
      if (k >= N - 1) return false;
      k++;
      const r = val('r'), q = 10 ** val('q');
      const u = update(predict(kf, dt, q), sc.meas[k], r);
      kf = u; gain = u.K[0];
      est.push([kf.s[0], kf.s[1]]);
      eM.push(Math.hypot(sc.meas[k][0] - sc.truth[k][0], sc.meas[k][1] - sc.truth[k][1]));
      eK.push(Math.hypot(kf.s[0] - sc.truth[k][0], kf.s[1] - sc.truth[k][1]));
      return true;
    };

    const draw = () => {
      const W = canvas.width, H = canvas.height, S = W / 100;
      const X = (x: number) => x * S, Y = (y: number) => H - y * S;
      ctx.fillStyle = cssVar('--paper'); ctx.fillRect(0, 0, W, H);
      // light grid every 10 m
      ctx.strokeStyle = cssVar('--rule'); ctx.lineWidth = 1;
      for (let g = 10; g < 100; g += 10) { ctx.beginPath(); ctx.moveTo(X(g), 0); ctx.lineTo(X(g), H); ctx.moveTo(0, Y(g)); ctx.lineTo(W, Y(g)); ctx.stroke(); }
      ctx.strokeStyle = cssVar('--ink-3'); ctx.strokeRect(0.5, 0.5, W - 1, H - 1);
      const path = (pts: [number, number][], color: string, w: number, dash: number[] = []) => {
        if (pts.length < 2) return;
        ctx.strokeStyle = color; ctx.lineWidth = w; ctx.setLineDash(dash);
        ctx.beginPath(); pts.forEach((p, i) => (i ? ctx.lineTo(X(p[0]), Y(p[1])) : ctx.moveTo(X(p[0]), Y(p[1])))); ctx.stroke();
        ctx.setLineDash([]);
      };
      path(sc.truth.slice(0, k + 1), cssVar('--c-truth'), 2.2, [7, 5]);
      if (measBox.checked) {
        ctx.fillStyle = cssVar('--c-data');
        for (let j = Math.max(0, k - 80); j <= k; j++) {
          ctx.globalAlpha = 0.25 + 0.75 * (1 - (k - j) / 80);
          ctx.beginPath(); ctx.arc(X(sc.meas[j][0]), Y(sc.meas[j][1]), 3, 0, 2 * Math.PI); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      path(est, cssVar('--c-learned'), 2.4);
      const e = ellipse(kf.P, 2);
      if (ellBox.checked) {
        ctx.save(); ctx.translate(X(kf.s[0]), Y(kf.s[1])); ctx.rotate(-e.angle);
        ctx.strokeStyle = cssVar('--c-learned'); ctx.lineWidth = 1.5;
        ctx.fillStyle = cssVar('--c-band');
        ctx.beginPath(); ctx.ellipse(0, 0, Math.max(e.rx * S, 1), Math.max(e.ry * S, 1), 0, 0, 2 * Math.PI); ctx.fill(); ctx.stroke();
        ctx.restore();
      }
      // drone marker
      ctx.fillStyle = cssVar('--ink');
      ctx.beginPath(); ctx.arc(X(sc.truth[k][0]), Y(sc.truth[k][1]), 4, 0, 2 * Math.PI); ctx.fill();

      const ts = eM.map((_, i) => i * dt);
      pErrR([
        { kind: 'line', x: ts, y: eM, cls: 's-data', label: 'GPS fix' },
        { kind: 'line', x: ts, y: eK, cls: 's-learned', label: 'Kalman estimate' },
      ], { xlim: [0, (N - 1) * dt], ylim: [0, Math.max(4 * val('r'), 5)] });

      const rmsd = (a: number[]) => Math.sqrt(a.slice(10).reduce((s, v) => s + v * v, 0) / Math.max(1, a.length - 10));
      read.innerHTML = k < 12 ? 'Press Play. The filter starts from the first GPS fix with an unknown velocity.' :
        `RMS error after the first 10 s: GPS <strong>${rmsd(eM).toFixed(2)} m</strong>, Kalman <strong>${rmsd(eK).toFixed(2)} m</strong>. ` +
        `Current gain on the position ≈ <strong>${(gain * 100).toFixed(0)} %</strong> of each new fix; 2σ ellipse ${(2 * Math.sqrt(kf.P[0])).toFixed(1)} m.`;
    };

    const loop = () => {
      if (!running) return;
      if (++frame % 2 === 0) { if (!advance()) { running = false; btn.textContent = 'Play'; } draw(); }
      if (running) requestAnimationFrame(loop);
    };
    btn.addEventListener('click', () => {
      if (running) { running = false; btn.textContent = 'Play'; return; }
      if (k >= N - 1) restart();
      running = true; btn.textContent = 'Pause'; requestAnimationFrame(loop);
    });
    $('[data-kf-restart]').addEventListener('click', () => { running = false; btn.textContent = 'Play'; restart(); });
    // changing a noise setting replays the run so far with the new settings (same random draws)
    const replay = () => { const upto = k; restart(); while (k < upto && advance()); draw(); };
    ['r', 'q'].forEach((nm) => $(`[name="${nm}"]`).addEventListener('input', replay));
    [measBox, ellBox].forEach((b) => b.addEventListener('change', draw));
    window.addEventListener('themechange', draw);
    restart();
  });
</script>

<style>
  .wide { grid-column: 1 / -1; }
  .kf__map { width: 100%; max-width: 30rem; height: auto; aspect-ratio: 1; display: block; margin-inline: auto; touch-action: manipulation; }
  .kf__key { text-align: center; margin-top: var(--s-2); }
  .kf__key .key { margin-left: 0.8em; }
  .kf__plot { min-height: 11rem; }
</style>
