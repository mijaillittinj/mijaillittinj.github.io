---
/**
 * Axisymmetric field revolved in 3D and rendered as a line-of-sight integral.
 * At elevation 0 the image is exactly the Abel projection a side-on camera records;
 * tilting the view shows the annular structure that the projection hides.
 * No WebGL: a small CPU ray integration on a canvas (about 30 ms per frame).
 * Static fallback: the caption and the 2D field figure elsewhere on the page.
 */
import { url } from '../../i18n/utils';
interface Props { base: string; field: string; caption?: string; id?: string; lang?: 'en' | 'es' }
const { base, field, caption, id = 'td', lang = 'en' } = Astro.props;
const S = lang === 'es'
  ? { aria: 'Integral a lo largo de la línea de visión del campo de revolución, para la elevación de observación elegida', el: 'Elevación de observación', elNote: '0° corresponde a una cámara lateral: la imagen es la proyección de Abel del campo.', cut: 'Quitar la mitad delantera', cutNote: 'mostrar solo la mitad trasera (y &gt; 0)', note: 'Vista de lado, cada píxel suma el campo a lo largo de una cuerda. Los bordes brillantes son el máximo fuera del eje visto de forma tangencial, no un máximo del campo en esa posición.' }
  : { aria: 'Line-of-sight integral of the revolved field at the selected viewing elevation', el: 'Viewing elevation', elNote: '0° is a side-on camera: the image is the Abel projection of the field.', cut: 'Cut away the front half', cutNote: 'show only the rear half (y &gt; 0)', note: 'Side-on, every pixel sums the field along a chord. The bright edges are the off-axis maximum seen tangentially, not a maximum of the field at that position.' };
---
<figure class="td" data-td data-base={url(base)} data-field={field}>
  <div class="td__grid">
    <div class="td__view"><canvas class="canvas-field" data-c width="220" height="260" role="img" aria-label={S.aria}></canvas></div>
    <div class="td__ctrl">
      <div class="control">
        <div class="control__head"><label for={`${id}-el`}>{S.el}</label><output data-elout>0°</output></div>
        <input id={`${id}-el`} type="range" min="0" max="80" step="1" value="0" data-el />
        <small class="muted">{S.elNote}</small>
      </div>
      <div class="control">
        <div class="control__head"><label for={`${id}-cut`}>{S.cut}</label></div>
        <label class="meta"><input type="checkbox" data-cut /> <Fragment set:html={S.cutNote} /></label>
      </div>
      <p class="lab__readout" data-note>{S.note}</p>
    </div>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<script>
  import { loadField, firstCompleteRow, projectable } from '../../lib/fields';
  import type { RGB } from '../../lib/plot';

  const inkmap = (t: number): RGB => {
    const dark = document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const a: RGB = dark ? [18, 20, 23] : [251, 250, 247];
    const b: RGB = dark ? [235, 233, 228] : [21, 23, 28];
    t = Math.max(0, Math.min(1, t)) ** 0.8;
    return a.map((v, i) => Math.round(v + (b[i] - v) * t)) as RGB;
  };

  document.querySelectorAll<HTMLElement>('[data-td]').forEach((root) => {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); init(root); }
    }, { rootMargin: '300px' });
    io.observe(root);
  });

  async function init(root: HTMLElement) {
    const { meta, data } = await loadField(root.dataset.base!, root.dataset.field!);
    const { nz, nr } = meta;
    const j0 = firstCompleteRow(data, nz, nr);
    const NZ = nz - j0;
    const f = projectable(data, nz, nr, j0);
    const R = meta.r_mm[1];
    const zlo = meta.z_mm[0] + ((meta.z_mm[1] - meta.z_mm[0]) * j0) / (nz - 1);
    const H = meta.z_mm[1] - zlo;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-c]')!;
    const W = 220, Hpx = 260;
    canvas.width = W; canvas.height = Hpx;
    const ctx = canvas.getContext('2d')!;
    const el = root.querySelector<HTMLInputElement>('[data-el]')!;
    const out = root.querySelector<HTMLElement>('[data-elout]')!;
    const cut = root.querySelector<HTMLInputElement>('[data-cut]')!;

    // The retrieved field ends where the diagnostics end, and that edge moves inward one grid
    // cell every few rows. Cut at a smoothed edge radius instead of the staircase (otherwise
    // each step shows up as a horizontal band in the line-of-sight image), and fill the cells
    // just beyond the staircase with the last valid value of the row so the cut is continuous.
    const edge = new Float64Array(NZ);
    for (let j = 0; j < NZ; j++) {
      let last = 0;
      for (let i = 0; i < nr; i++) if (Number.isFinite(data[(j + j0) * nr + i])) last = i;
      edge[j] = last + 0.5;
      for (let i = last + 1; i < Math.min(nr, last + 4); i++) f[j * nr + i] = f[j * nr + last];
    }
    const win = 12, edgeS = new Float64Array(NZ);
    for (let j = 0; j < NZ; j++) {
      let s2 = 0, n = 0;
      for (let k = Math.max(0, j - win); k <= Math.min(NZ - 1, j + win); k++) { s2 += edge[k]; n++; }
      edgeS[j] = Math.min(s2 / n, edge[j] + 2) * (R / (nr - 1));
    }
    const edgeAt = (z: number) => {
      const y = Math.max(0, Math.min(NZ - 1, (z / H) * (NZ - 1))), j = Math.floor(y), j1 = Math.min(j + 1, NZ - 1);
      return edgeS[j] + (edgeS[j1] - edgeS[j]) * (y - j);
    };

    // bilinear sample of f(r, z) with z measured from the bottom of the cropped field
    const sample = (r: number, z: number) => {
      if (r >= R || z < 0 || z > H || r > edgeAt(z)) return 0;
      const x = (r / R) * (nr - 1), y = (z / H) * (NZ - 1);
      const i = Math.floor(x), j = Math.floor(y);
      const dx = x - i, dy = y - j;
      const i1 = Math.min(i + 1, nr - 1), j1 = Math.min(j + 1, NZ - 1);
      return (f[j * nr + i] * (1 - dx) + f[j * nr + i1] * dx) * (1 - dy) + (f[j1 * nr + i] * (1 - dx) + f[j1 * nr + i1] * dx) * dy;
    };

    let pending = false;
    const draw = () => {
      pending = false;
      const phi = (+el.value * Math.PI) / 180;
      out.textContent = `${el.value}°`;
      const c = Math.cos(phi), s = Math.sin(phi);
      // image extent: width 2R, height covers the tilted cylinder
      const halfW = R * 1.08;
      const vmin = -R * s - 0.02 * H, vmax = H * c + R * s + 0.02 * H;
      const img = new Float32Array(W * Hpx);
      const steps = 200; // fewer steps leave faint aliasing arcs
      const tmax = R * 1.02;
      let mx = 0;
      for (let py = 0; py < Hpx; py++) {
        const v = vmax - ((vmax - vmin) * py) / (Hpx - 1);
        for (let px = 0; px < W; px++) {
          const u = -halfW + (2 * halfW * px) / (W - 1);
          if (Math.abs(u) >= R) continue;
          let acc = 0;
          const t0 = cut.checked ? 0 : -tmax;
          const dt = (tmax - t0) / steps;
          for (let k = 0; k < steps; k++) {
            const t = t0 + (k + 0.5) * dt;
            // point = u e_x + v (0, s, c) + t (0, c, -s)
            const y = v * s + t * c;
            const z = v * c - t * s;
            acc += sample(Math.hypot(u, y), z);
          }
          acc *= dt;
          img[py * W + px] = acc;
          if (acc > mx) mx = acc;
        }
      }
      const id = ctx.createImageData(W, Hpx);
      for (let q = 0; q < W * Hpx; q++) {
        const [r, g, b] = inkmap(img[q] / (mx || 1));
        id.data[q * 4] = r; id.data[q * 4 + 1] = g; id.data[q * 4 + 2] = b; id.data[q * 4 + 3] = 255;
      }
      ctx.putImageData(id, 0, 0);
    };
    const req = () => { if (!pending) { pending = true; requestAnimationFrame(draw); } };
    el.addEventListener('input', req);
    cut.addEventListener('change', req);
    window.addEventListener('themechange', req);
    req();
  }
</script>

<style>
  .td { margin-block: var(--s-6); }
  .td__grid { display: grid; gap: var(--s-5); }
  @media (min-width: 46rem) { .td__grid { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); align-items: start; } }
  .td__view canvas { width: 100%; height: auto; aspect-ratio: 220 / 260; }
  .td__ctrl { display: grid; gap: var(--s-4); }
</style>
