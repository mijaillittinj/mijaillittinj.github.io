---
import Base from '../../layouts/Base.astro';
import { software, methods } from '../../data/software';
import { byId } from '../../data/publications';
import { localized } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const L = (k: string) => localized(k, lang);
const T = es
  ? {
      title: 'Software', eyebrow: 'Software', h1: 'Software y métodos',
      desc: 'Software de investigación y métodos de Mijail Littin: pysat-abel (transformada de Abel basada en splines con corrección del atrapamiento de señal), inversión informada por la física de diagnósticos ópticos, reconstrucción neuronal de la madurez del hollín y separación de la radiación del hollín y de los gases.',
      lede: 'Primero el software de investigación publicado y luego descripciones breves de los métodos detrás de las publicaciones. Solo pysat-abel se distribuye; el código de los métodos publicados está disponible a solicitud.',
      released: 'Software disponible', methods: 'Métodos', doc: 'Documentación y ejemplo', methodPaper: 'Artículo del método', paper: 'Artículo', also: 'También en este sitio',
      alsoText: 'Las figuras interactivas de la página de inicio y de los <a href="LEARN">módulos de aprendizaje</a> usan implementaciones pequeñas, escritas para este sitio, de la inversión de Abel, la transformada de Abel basada en splines, optimizadores, redes neuronales y redes informadas por la física. Todo se calcula en el navegador de quien lee.',
    }
  : {
      title: 'Software', eyebrow: 'Software', h1: 'Software and methods',
      desc: 'Research software and methods by Mijail Littin: pysat-abel (spline-based Abel transform with signal-trapping correction), physics-informed inversion of optical diagnostics, neural soot-maturity reconstruction and soot–gas radiation separation.',
      lede: 'Released research software, followed by short descriptions of the methods behind the publications. Only pysat-abel is distributed; code for the published methods is available upon request.',
      released: 'Released', methods: 'Methods', doc: 'Documentation and example', methodPaper: 'Method paper', paper: 'Paper', also: 'Also on this site',
      alsoText: 'The interactive figures on the home page and in the <a href="LEARN">learning modules</a> run small implementations, written for this site, of Abel inversion, the spline-based Abel transform, optimisers, neural networks and physics-informed networks. Everything is computed in the reader’s browser.',
    };
---
<Base title={T.title} description={T.desc}>
  <header class="page-head frame">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
    <p class="lede">{T.lede}</p>
  </header>
  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.released}</h2>
      <div>
        {software.map((s) => {
          const p = s.paper ? byId(s.paper) : undefined;
          return (
            <article class="sw">
              <h3><a href={L(`/software/${s.slug}/`)}><code>{s.name}</code></a></h3>
              <p class="meta">{s.language} · {es && s.es ? s.es.license : s.license} · <code>pip install {s.name}</code></p>
              <p class="d">{es && s.es ? s.es.summary : s.summary}</p>
              {p && <p class="meta">{T.methodPaper}: {p.authors[0]} et al., <em>{p.journal}</em> {p.volume} ({p.year}).</p>}
              <ul class="links">
                <li><a href={L(`/software/${s.slug}/`)}>{T.doc}</a></li>
                {(es && s.es?.links ? s.es.links : s.links).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.methods}</h2>
      <div>
        {methods.map((m) => {
          const p = m.paper ? byId(m.paper) : undefined;
          return (
            <article class="sw method">
              <h3>{m.page ? <a href={L(m.page)}>{es && m.es ? m.es.name : m.name}</a> : (es && m.es ? m.es.name : m.name)}</h3>
              <p class="d">{es && m.es ? m.es.summary : m.summary}</p>
              <p class="meta"><em>{es && m.es ? m.es.status : m.status}</em>{p && <> {T.paper}: {p.authors[0]} et al., <em>{p.journal}</em>{p.volume && <> {p.volume}</>} ({p.year}){p.doi && <>, <a href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a></>}.</>}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.also}</h2>
      <div class="prose">
        <p set:html={T.alsoText.replace('LEARN', L('/learn/'))} />
      </div>
    </div>
  </section>
</Base>
<style>
  .sw h3 { font-size: var(--step-2); }
  .sw h3 a { text-decoration: none; }
  .d { margin-block: var(--s-3); max-width: 44rem; }
  .method + .method { margin-top: var(--s-5); }
  .sw .links li + li::before { content: none; }
  .sw .links li:not(:last-child)::after { content: '·'; color: var(--ink-3); padding: 0 0.5em; }
  .method h3 { font-size: var(--step-1); }
</style>
