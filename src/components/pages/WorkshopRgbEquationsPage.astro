---
/**
 * Equations, error budget and references of the RGB pyrometry workshop. Spec: manim/WEB_SPEC.md §3.6.
 * Notation of the presentation (encargo §5, manim/SCIENTIFIC_NOTES.md). The error budget mirrors
 * SCIENTIFIC_NOTES §16 and prints every figure from data/checks.json (src/data/workshop-rgb-checks.json).
 */
import Base from '../../layouts/Base.astro';
import WorkshopNav from '../workshop-rgb/WorkshopNav.astro';
import Equation from '../viz/Equation.astro';
import PubItem from '../ui/PubItem.astro';
import { localized } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { byId } from '../../data/publications';
import { WS, ck, isSketch, tx, sketchLabel } from '../../data/workshop-rgb';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const k = (key: string) => ck(key, lang);
const sk = (key: string) => (isSketch(key) ? ` (${sketchLabel(lang)})` : '');
const d = (s: string) => (es ? s.replace(/(\d)\.(\d)/g, '$1{,}$2') : s);   // decimal comma inside TeX

const eq = {
  planck: String.raw`I_{b\lambda}(\lambda, T) = \frac{C_1}{\lambda^5\left[\exp\!\left(C_2/\lambda T\right) - 1\right]}, \qquad C_1 = 2hc^2, \quad C_2 = \frac{hc}{k}`,
  emis: String.raw`j_\lambda(r, z) = \kappa_{\mathrm{abs},\lambda}\, I_{b\lambda}(T), \qquad \kappa_{\mathrm{abs},\lambda} = \frac{6\pi E(m_\lambda)\, f_s}{\lambda}`,
  em: d(String.raw`E(m_\lambda) = 0.284 + 0.272\,\ln^2\lambda + 0.057\,\frac{\ln\lambda}{\lambda}, \quad \lambda \text{ en } \mu\mathrm{m}`).replace(' en ', es ? ' en ' : ' in '),
  signal: String.raw`S_j - D_j = K_j\, t_{\mathrm{exp}} \int \psi_j(\lambda)\, L_\lambda\, d\lambda, \qquad \psi_j(\lambda) = \frac{\lambda}{\lambda_{\mathrm{ref}}}\, \eta_j(\lambda)\, \tau(\lambda)`,
  oven: String.raw`K_j = \frac{S_j - D_j}{t_{\mathrm{exp}}\, \varepsilon \int \psi_j(\lambda)\, I_{b\lambda}(\lambda, T_h)\, d\lambda}`,
  proj: String.raw`P_j(y, z) = \int j_j\, dx = 2 \int_{|y|}^{R} \frac{j_j(r, z)\, r}{\sqrt{r^2 - y^2}}\, dr`,
  abel: String.raw`j_j(r, z) = -\frac{1}{\pi} \int_{r}^{R} \frac{\partial P_j/\partial y}{\sqrt{y^2 - r^2}}\, dy`,
  disc: String.raw`\mathbf{P} = \mathbf{L}\, \mathbf{f}, \qquad \mathbf{f}_\lambda = \arg\min_{\mathbf{f}} \lVert \mathbf{L}\mathbf{f} - \mathbf{P} \rVert^2 + \lambda \lVert \Gamma \mathbf{f} \rVert^2, \qquad \lambda = \lambda_{\mathrm{rel}}\, \frac{\operatorname{tr}(\mathbf{L}^{\mathsf T}\mathbf{L})}{\operatorname{tr}(\Gamma^{\mathsf T}\Gamma)}`,
  band: String.raw`j_j(r, z) = f_s\, G_j(T), \qquad G_j(T) = \int \psi_j(\lambda)\, \frac{6\pi E(m_\lambda)}{\lambda}\, I_{b\lambda}(\lambda, T)\, d\lambda`,
  net: String.raw`\mathcal{L} = \frac{1}{N} \sum_{n} \frac{\sum_j w_j \left[\dfrac{j_j - f_s\, G_j(T)}{\hat{j}_j}\right]^2}{\sum_j w_j} \;+\; \frac{\lambda_r}{N_m} \sum_{n \in m} \sum_{(a, b)} \left[\dfrac{j_a/j_b - G_a(T)/G_b(T)}{\hat{\rho}_{ab}}\right]^2`,
  net2: String.raw`(o_1, o_2) = \mathrm{NN}(\tilde r^{\,2}, \tilde z), \qquad T = T_{\min} + \left(T_{\max} - T_{\min}\right) \sigma(o_1), \qquad f_s = f_{s,\mathrm{ref}}\, \sigma(o_2)`,
  ratio: String.raw`\frac{j_R}{j_G} = \frac{G_R(T)}{G_G(T)} \;\Rightarrow\; T, \qquad f_s = \frac{j_R G_R(T) + j_G G_G(T)}{G_R(T)^2 + G_G(T)^2}`,
};

const T = es
  ? {
      title: 'Ecuaciones y referencias',
      lede: 'La cadena de medición del workshop en una página, con la misma notación de la presentación y de la herramienta. Va de la emisión del hollín a la señal de un píxel, de la imagen a la emisión local con la transformada de Abel, y de la emisión local a T y f_s. Al final están el presupuesto de error y las referencias.',
      s: ['Emisión de un cuerpo negro', 'Emisión del hollín', 'Señal de un canal de la cámara', 'Calibración con el horno', 'Línea de visión e inversión de Abel', 'Temperatura y fracción de hollín', 'Orden de las operaciones', 'Presupuesto de error', 'Referencias'],
      planck: 'Ley de Planck en longitud de onda, como intensidad espectral en W m⁻² sr⁻¹ m⁻¹. C₁ = 2hc² y C₂ = hc/k.',
      emis: 'El hollín en el régimen de Rayleigh absorbe y emite en proporción a su fracción de volumen f_s. Con la ley de Kirchhoff la emisión local j_λ es el coeficiente de absorción por la intensidad de cuerpo negro a la temperatura del hollín.',
      em: `E(m_λ) es la función de absorción del índice de refracción m_λ = n − ik. El workshop usa una ley espectral, la de Yon et al. [6]; hay otros modelos. Con E = 0,4 a 650 nm, el valor de Pinto et al. [2], f_s cambia ${k('fs_Em_law_vs_F26')} respecto de la ley.`,
      signal: 'S_j es la señal cruda del canal j = R, G, B en DN, D_j el oscuro con el mismo t_exp y ganancia, y L_λ la radiancia que llega al píxel. η_j es la eficiencia cuántica del canal con su filtro de color, τ la transmisión del lente y de los filtros, y λ_ref = 550 nm. El factor λ/λ_ref aparece porque el sensor cuenta fotones. K_j junta el número f, el aumento, el área del píxel, la ganancia y el viñeteo, y se mide.',
      oven: 'El horno es una cavidad isoterma a la temperatura T_h del termopar, con emisividad ε. Para cada canal, la pendiente de (S_j − D_j) contra t_exp a cada temperatura, dividida por ε ∫ ψ_j I_bλ(T_h) dλ, da K_j(T_h). La calibración usa K_j de la T_h más caliente con las ψ_j nominales. Usarla en la llama, sobre 1800 K, supone que la forma de ψ_j vale también ahí, y el horno entre 1073 y 1323 K no lo prueba.',
      ovenNote: 'K_R/K_G medido cambia con T_h, 0,70, 0,80, 0,87 y 0,89 a 800, 900, 1000 y 1050 °C. El horno es mucho más frío que la llama, y en un cuerpo frío una parte grande de la señal viene de sobre 700 nm, 38 % en R y 36 % en G a 1073 K, 17 % y 14 % a 1323 K, y 6 % y 4 % a 1800 K, según la curva de Sony. Esa parte de la curva de Sony se conoce mal. K_j es la señal medida dividida por la luz que predice la curva, así que el error de la curva pasa a K_j, y pesa más en un cuerpo frío. La matriz de color de pylon estaba apagada en esas fotos. Por eso se usa la T_h más caliente, la más parecida a la llama.',
      tail: 'La elección importa. Una llama a 1800 K con K_R/K_G de 1050 °C se lee unos 37 K más baja con el de 1000 °C. K_R/K_G sigue subiendo con T_h, y el horno no llega a la temperatura de la llama, así que la T real podría ser algo mayor, y entonces f_s sería menor. K_B se calcula igual, y el azul queda fuera de T y de f_s.',
      proj: 'La cámara ve la integral de la emisión a lo largo de la línea de visión (line of sight) x. En una llama axisimétrica y ópticamente delgada, la proyección P_j(y, z) y la emisión local j_j(r, z) forman un par de Abel.',
      disc: 'En la práctica se discretiza en anillos, P = L f, con L la matriz de cuerdas. El pelado de cebolla (onion peeling) resuelve el sistema triangular y amplifica el ruido hacia el eje. Tikhonov agrega una penalización de la curvatura del perfil, con Γ la segunda diferencia y λ_rel elegido en la esquina de la curva L, el mismo parámetro que muestra la herramienta. SAT ajusta splines a las dos mitades de la llama y ANNAbel representa el campo con una red neuronal.',
      band: 'Después de dividir por K_j y por t_exp, y de invertir, j_j es la emisión local del canal integrada con ψ_j. Es f_s por una función G_j de la temperatura sola.',
      netTitle: 'Temperatura y fracción de hollín con una red, RGB-ANNAbel',
      net: 'RGB-ANNAbel [14] obtiene T y f_s en dos pasos. En el artículo, el primer paso es ANNAbel [5], una forma de hacer la inversión de Abel con una red neuronal que recibe la posición (r, z) y entrega j_R, j_G y j_B. El segundo paso es otra red, que recibe la posición y entrega T y f_s. La herramienta trae solo ese segundo paso y lo entrena con la emisión del paso 3, del método de inversión que hayan elegido. Las ecuaciones (11) y (12) son las de la herramienta, iguales a las de la aplicación del grupo. La red recibe r̃² y z̃, con r̃ = r/r_max y z̃ = (z − z_min)/(z_max − z_min), que van de 0 a 1, y entrega dos números o₁ y o₂. Una sigmoide σ, una curva que va de 0 a 1, los lleva a T entre los extremos de la tabla y a f_s entre 0 y f_s,ref. El primer término de la pérdida pide que f_s G_j(T) reproduzca j_j en los N píxeles. Los pesos w_j valen 1 en los canales calibrados y 0 en los demás, así que con la cámara del laboratorio el azul queda fuera. El segundo término pide que las razones entre canales coincidan con las de la tabla en los N_m píxeles donde cada canal supera el 2 % de su máximo, con peso λ_r = 10⁻². Así la red reemplaza la lectura de la tabla y el cálculo de f_s píxel a píxel.',
      netNote: 'El artículo escribe la pérdida sin divisiones, la suma de ‖J̃_i − f̃_s H̃_i‖² sobre R, G y B más 10⁻² por la suma de los cuadrados de J̃_a/J̃_b − H̃_a/H̃_b para G/R, B/R y B/G, con el canal más intenso en el denominador. Acota T entre 800 y 2800 K y f_s entre 0 y 25 ppm, usa los tres canales, una red de tres capas de 20 neuronas y 50 000 iteraciones. La aplicación del grupo, y con ella la herramienta, divide cada canal por su máximo ĵ_j y cada razón por su máximo ρ̂_ab, usa para las razones solo los píxeles sobre el 2 %, acota T con la tabla, forma los pares por el orden de los canales y usa cuatro capas de 64 neuronas sobre una de cada dos alturas. Por defecto entrena 3000 iteraciones, como la aplicación. En la llama de ejemplo eso no basta. A 3000 iteraciones la red queda lejos del ajuste directo, y el resultado depende del punto de partida. Con unas 30 000 la herramienta y la aplicación quedan dentro de sus umbrales. La herramienta lo ofrece en Opciones del paso 4, junto a la tabla, que sigue siendo el camino predeterminado. Para revisar la red, la compara con el ajuste directo por píxel de la misma emisión, igual que la aplicación.',
      ratio: 'La razón entre el rojo y el verde no depende de f_s y da T por una tabla de G_R/G_G. Con T, f_s sale por mínimos cuadrados del rojo y el verde con el mismo peso, como en la presentación. Con T de R/G el rojo y el verde dan el mismo f_s. El azul queda fuera porque su K_B del horno no vale en la llama. La herramienta lo agrega como opción avanzada rotulada (rojo, verde y azul), que solo sirve con pasa-cortos de 700 nm o con la esfera. R/G baja con T porque G crece más rápido que R. B/G no es monótona con la cámara del laboratorio y queda como comprobación.',
      steps: [
        'Restar el oscuro o el fondo con el mismo t_exp y la misma ganancia.',
        'Dividir por t_exp y por K_j del píxel, que incluye el campo plano.',
        'Rotar, centrar el eje y pasar de píxeles a milímetros con la regla.',
        'Invertir con Abel cada canal por separado.',
        'Calcular T con la razón j_R/j_G.',
        'Calcular f_s con j_R y j_G, mínimos cuadrados de j_j = f_s G_j(T).',
      ],
      stepsNote: 'K_R/K_G entra en T. La escala absoluta de K_j, la emisividad del horno si la cavidad es gris, t_exp, los milímetros por píxel y el nivel de E(m) no tocan T y entran en f_s en proporción directa o inversa.',
      budgetIntro: 'Efecto de cada fuente sobre T y f_s en una llama de 1800 K, con la cámara y la ley de E(m) del workshop. Las cifras son las mismas de la presentación. Las marcadas como valor ilustrativo salen de un supuesto y no de una medición del laboratorio.',
      bandNote: 'La banda del paso 5 de la herramienta no es esta tabla. Repite el cálculo 30 veces por defecto con cambios al azar en la imagen, según la diferencia entre las dos mitades de la llama puesta como ruido independiente en cada radio, en la temperatura del horno (±5 K por defecto), en el error estadístico de cada K_j y en la regla (±1 % por defecto, solo en f_s), y va del percentil 16 al 84 en cada punto. Queda sin banda donde menos de la mitad de las repeticiones da un valor. Esa diferencia no es solo ruido, porque casi toda es asimetría suave de la llama o del eje. Por eso la banda sale más ancha que el ruido de la cámara. En la llama de ejemplo también sale más ancha que la diferencia entre T calculada con cada mitad. Con esfera o sin calibración entra solo lo que esa calibración da, y la herramienta lo dice. De esta tabla entra solo el termopar. No entran la temperatura del horno usada, unos 37 K entre 1050 y 1000 °C, ni las demás filas. Se calcula siempre con el promedio de las dos mitades y con un método directo. SAT con las dos mitades en el ajuste da la misma T que SAT con el promedio, así que SAT tiene su propia banda. Con ANNAbel usa Tikhonov y con la red de T y f_s usa el ajuste directo, así que no es la incertidumbre de esas redes. En la herramienta, este resumen se abre con «Cómo se calcula la banda», en la sección Perfiles del paso 5.',
      bh: ['Fuente', 'Supuesto', 'Efecto en T', 'Efecto en f_s'],
      viaT: 'a través de T',
      none: 'ninguno',
      chain: `Prueba completa sobre la llama sintética, con ${k('n_frames_rec')} cuadros promediados y ${k('chain_method')}. El error en media cuadrática dentro de la máscara fue ${k('chain_T_rms')} en T y ${k('chain_fs_rms')} en f_s, con tolerancias de ${k('chain_T_tol')} y ${k('chain_fs_tol')} fijadas de antemano. Con 1 % de error en T, f_s cambia ${k('fs_err_1pct_T')}.`,
      grid: 'La herramienta lee T en una tabla cada 1 K y la refina con una parábola sobre los tres puntos más cercanos, así que la tabla no agrega error.',
      refsOwn: 'Trabajos del profesor y del grupo',
      refsOther: 'Otras referencias',
    }
  : {
      title: 'Equations and references',
      lede: 'The measurement chain of the workshop on one page, with the same notation as the presentation and the tool. It goes from soot emission to the signal of a pixel, from the image to the local emission with the Abel transform, and from the local emission to T and f_s. The error budget and the references close the page.',
      s: ['Blackbody emission', 'Soot emission', 'Signal of a camera channel', 'Oven calibration', 'Line of sight and Abel inversion', 'Temperature and soot volume fraction', 'Order of operations', 'Error budget', 'References'],
      planck: 'Planck’s law in wavelength, as spectral intensity in W m⁻² sr⁻¹ m⁻¹. C₁ = 2hc² and C₂ = hc/k.',
      emis: 'Soot in the Rayleigh regime absorbs and emits in proportion to its volume fraction f_s. By Kirchhoff’s law the local emission j_λ is the absorption coefficient times the blackbody intensity at the soot temperature.',
      em: `E(m_λ) is the absorption function of the refractive index m_λ = n − ik. The workshop uses one spectral law, that of Yon et al. [6]; there are other models. With E = 0.4 at 650 nm, the value of Pinto et al. [2], f_s changes by ${k('fs_Em_law_vs_F26')} with respect to the law.`,
      signal: 'S_j is the raw signal of channel j = R, G, B in DN, D_j the dark frame at the same t_exp and gain, and L_λ the radiance reaching the pixel. η_j is the quantum efficiency of the channel with its colour filter, τ the transmission of the lens and filters, and λ_ref = 550 nm. The factor λ/λ_ref appears because the sensor counts photons. K_j gathers the f-number, the magnification, the pixel area, the gain and the vignetting, and it is measured.',
      oven: 'The oven is an isothermal cavity at the thermocouple temperature T_h, with emissivity ε. For each channel, the slope of (S_j − D_j) against t_exp at each temperature, divided by ε ∫ ψ_j I_bλ(T_h) dλ, gives K_j(T_h). The calibration uses K_j of the hottest T_h with the nominal ψ_j. Using it in the flame, above 1800 K, assumes that the shape of ψ_j holds there, which the oven between 1073 and 1323 K does not test.',
      ovenNote: 'The measured K_R/K_G changes with T_h, 0.70, 0.80, 0.87 and 0.89 at 800, 900, 1000 and 1050 °C. The oven is much colder than the flame, and in a cold body a large part of the signal comes from above 700 nm, 38 % in R and 36 % in G at 1073 K, 17 % and 14 % at 1323 K, and 6 % and 4 % at 1800 K, according to the Sony curve. That part of the Sony curve is poorly known. K_j is the measured signal divided by the light the curve predicts, so the error of the curve goes into K_j, and it weighs more in a cold body. The pylon colour matrix was off in those photographs. That is why the hottest T_h, the closest to the flame, is used.',
      tail: 'The choice matters. A flame at 1800 K with K_R/K_G from 1050 °C reads about 37 K lower with the one from 1000 °C. K_R/K_G keeps rising with T_h, and the oven does not reach the flame temperature, so the real T could be somewhat higher, and then f_s would be lower. K_B is computed the same way, and blue stays out of T and f_s.',
      proj: 'The camera sees the integral of the emission along the line of sight x. In an axisymmetric, optically thin flame, the projection P_j(y, z) and the local emission j_j(r, z) form an Abel pair.',
      disc: 'In practice the integral is discretised into rings, P = L f, with L the chord matrix. Onion peeling solves the triangular system and amplifies noise towards the axis. Tikhonov adds a penalty on the curvature of the profile, with Γ the second difference and λ_rel chosen at the corner of the L-curve, the same parameter the tool shows. SAT fits splines to the two halves of the flame and ANNAbel represents the field with a neural network.',
      band: 'After dividing by K_j and t_exp, and inverting, j_j is the local emission of the channel integrated with ψ_j. It is f_s times a function G_j of temperature alone.',
      netTitle: 'Temperature and soot volume fraction with a network, RGB-ANNAbel',
      net: 'RGB-ANNAbel [14] obtains T and f_s in two steps. In the paper, the first step is ANNAbel [5], a way to do the Abel inversion with a neural network that takes the position (r, z) and returns j_R, j_G and j_B. The second step is another network, which takes the position and returns T and f_s. The tool includes only that second step and trains it on the emission of step 3, from whichever inversion method you chose. Equations (11) and (12) are those of the tool, the same as in the group’s app. The network takes r̃² and z̃, with r̃ = r/r_max and z̃ = (z − z_min)/(z_max − z_min), which go from 0 to 1, and returns two numbers o₁ and o₂. A sigmoid σ, a curve that goes from 0 to 1, maps them to T between the ends of the table and to f_s between 0 and f_s,ref. The first term of the loss asks that f_s G_j(T) reproduce j_j on the N pixels. The weights w_j are 1 for the calibrated channels and 0 for the others, so with the lab camera blue is left out. The second term asks that the ratios between channels match those of the table on the N_m pixels where every channel is above 2 % of its maximum, with weight λ_r = 10⁻². In this way the network replaces reading the table and computing f_s pixel by pixel.',
      netNote: 'The paper writes the loss without divisions, the sum of ‖J̃_i − f̃_s H̃_i‖² over R, G and B plus 10⁻² times the sum of the squares of J̃_a/J̃_b − H̃_a/H̃_b for G/R, B/R and B/G, with the brighter channel in the denominator. It bounds T between 800 and 2800 K and f_s between 0 and 25 ppm, and uses the three channels, a network of three layers of 20 neurons and 50 000 iterations. The group’s app, and with it the tool, divides each channel by its maximum ĵ_j and each ratio by its maximum ρ̂_ab, uses only the pixels above 2 % for the ratios, bounds T with the table, forms the pairs by channel order and uses four layers of 64 neurons on one height in two. By default it trains 3000 iterations, as the app does. On the example flame that is not enough. At 3000 iterations the network stays far from the direct fit, and the result depends on the starting point. With about 30 000 the tool and the app are both within their thresholds. The tool offers it in step 4 Options, next to the table, which is still the default path. To check the network, it compares it with the direct per-pixel fit of the same emission, as the app does.',
      ratio: 'The ratio of red to green does not depend on f_s and gives T through a table of G_R/G_G. With T known, f_s comes from a least-squares fit of red and green with equal weight, as in the presentation. With T from R/G, red and green give the same f_s. Blue is left out because its oven K_B does not hold in the flame. The tool offers it as a labelled advanced option (red, green and blue), useful only with a 700 nm short-pass filter or with the sphere. R/G decreases with T because G grows faster than R. B/G is not monotonic with the lab camera and serves as a check.',
      steps: [
        'Subtract the dark frame or the background at the same t_exp and gain.',
        'Divide by t_exp and by the pixel’s K_j, which includes the flat field.',
        'Rotate, centre the axis and convert pixels to millimetres with the ruler.',
        'Abel-invert each channel separately.',
        'Compute T from the ratio j_R/j_G.',
        'Compute f_s from j_R and j_G, least squares of j_j = f_s G_j(T).',
      ],
      stepsNote: 'K_R/K_G enters T. The absolute scale of K_j, the oven emissivity if the cavity is grey, t_exp, the millimetres per pixel and the level of E(m) do not touch T and enter f_s in direct or inverse proportion.',
      budgetIntro: 'Effect of each source on T and f_s in a flame at 1800 K, with the camera and the E(m) law of the workshop. The figures are the same as in the presentation. Values marked as illustrative rest on an assumption, not on a lab measurement.',
      bandNote: 'The band of step 5 of the tool is not this table. It repeats the calculation 30 times by default with random changes in the image, by the difference between the two halves of the flame applied as independent noise at each radius, in the oven temperature (±5 K by default), in the statistical error of each K_j and in the ruler (±1 % by default, in f_s only), and it goes from the 16th to the 84th percentile at each point. There is no band where fewer than half of the repetitions give a value. That difference is not only noise, because almost all of it is smooth asymmetry of the flame or the axis. So the band comes out wider than the camera noise. In the example flame it also comes out wider than the difference between T computed with each half. With the sphere or without a calibration only what that calibration gives enters, and the tool says so. Of this table only the thermocouple enters. The oven temperature used, about 37 K between 1050 and 1000 °C, does not enter, nor do the other rows. It is always computed with the mean of the two halves and with a direct method. SAT with both halves in the fit gives the same T as SAT with the mean, so SAT has its own band. With ANNAbel it uses Tikhonov and with the network for T and f_s it uses the direct fit, so it is not the uncertainty of those networks. In the tool, this summary opens with «How the band is computed», in the Profiles section of step 5.',
      bh: ['Source', 'Assumption', 'Effect on T', 'Effect on f_s'],
      viaT: 'through T',
      none: 'none',
      chain: `Complete test on the synthetic flame, with ${k('n_frames_rec')} averaged frames and ${k('chain_method')}. The root-mean-square error inside the mask was ${k('chain_T_rms')} in T and ${k('chain_fs_rms')} in f_s, with tolerances of ${k('chain_T_tol')} and ${k('chain_fs_tol')} set in advance. A 1 % error in T changes f_s by ${k('fs_err_1pct_T')}.`,
      grid: 'The tool reads T on a table every 1 K and refines it with a parabola through the three nearest points, so the table adds no error.',
      refsOwn: 'Work by the instructor and the group',
      refsOther: 'Other references',
    };

const V = T.viaT;
const budget: string[][] = es
  ? [
      ['Termopar del horno, si las curvas de la cámara valen', '±5 K', k('oven_dT_flame_model'), `${k('oven_K_sens_5K')} en K_j, más su efecto a través de T`],
      ['Temperatura del horno usada, K_R/K_G de 1000 °C en vez de 1050 °C', 'K_R/K_G 0,87 en vez de 0,89', 'unos −37 K a 1800 K', V],
      ['Razón K_R/K_G', '±5 %', k('dT_KRKG_5pct'), V],
      ['Forma espectral de E(m), razón E_G/E_R', '±10 %', k('dT_EGER_10pct'), k('fs_from_EGER')],
      ['E(m) constante en vez de la ley', '', k('dT_Em_const'), V],
      ['Nivel de E(m)', '±20 %', T.none, k('fs_Em20_both')],
      ['Factor λ/λ_ref omitido', '', `${k('dT_no_lambda')} con horno, ${k('dT_no_lambda_nocal')} sin horno`, V],
      ['Curva de la cámara leída por energía', '', k('dT_basis_after_oven'), V],
      ['Borde del filtro infrarrojo de la cámara' + sk('dT_cut'), '±20 nm', k('dT_cut'), V],
      ['Autoabsorción, llama CoFlame en el eje', '', k('cof_dT_selfabs'), `${k('cof_dfs_att_only')} por la atenuación sola, ${k('cof_dfs_selfabs')} en total`],
      ['Promedio de cuadros de una llama que parpadea' + sk('flicker_dT'), 'T ± 100 K', k('flicker_dT'), V],
      ['Razón de las proyecciones, sin Abel', '', k('dT_los_ratio'), V],
      ['Abel por canal y después la razón', '', k('dT_abel_per_channel'), V],
      ['Centro del eje corrido medio píxel', '', '', `${k('abel_center_halfpx')} en el eje`],
      ['Aproximación de Wien', '', `${k('wien_err_ratio_RG')} en R/G`, V],
      ['Agregados de hollín, RDG-FA en vez de Rayleigh', '', T.none, '10 a 20 % (Sorensen et al. 2018)'],
      ['Hollín joven en la base de la llama, otra E(m)', '', 'sin cifra, la tabla no lo considera', 'sin cifra'],
    ]
  : [
      ['Oven thermocouple, if the camera curves hold', '±5 K', k('oven_dT_flame_model'), `${k('oven_K_sens_5K')} in K_j, plus its effect through T`],
      ['Oven temperature used, K_R/K_G from 1000 °C in place of 1050 °C', 'K_R/K_G 0.87 in place of 0.89', 'about −37 K at 1800 K', V],
      ['Ratio K_R/K_G', '±5 %', k('dT_KRKG_5pct'), V],
      ['Spectral shape of E(m), ratio E_G/E_R', '±10 %', k('dT_EGER_10pct'), k('fs_from_EGER')],
      ['Constant E(m) in place of the law', '', k('dT_Em_const'), V],
      ['Level of E(m)', '±20 %', T.none, k('fs_Em20_both')],
      ['Factor λ/λ_ref left out', '', `${k('dT_no_lambda')} with the oven, ${k('dT_no_lambda_nocal')} without`, V],
      ['Camera curve read as energy response', '', k('dT_basis_after_oven'), V],
      ['Edge of the camera’s infrared filter' + sk('dT_cut'), '±20 nm', k('dT_cut'), V],
      ['Self-absorption, CoFlame flame on the axis', '', k('cof_dT_selfabs'), `${k('cof_dfs_att_only')} from attenuation alone, ${k('cof_dfs_selfabs')} in total`],
      ['Averaging frames of a flickering flame' + sk('flicker_dT'), 'T ± 100 K', k('flicker_dT'), V],
      ['Ratio of the projections, no Abel', '', k('dT_los_ratio'), V],
      ['Abel per channel, then the ratio', '', k('dT_abel_per_channel'), V],
      ['Axis centre shifted by half a pixel', '', '', `${k('abel_center_halfpx')} on the axis`],
      ['Wien approximation', '', `${k('wien_err_ratio_RG')} in R/G`, V],
      ['Soot aggregates, RDG-FA in place of Rayleigh', '', T.none, '10 to 20 % (Sorensen et al. 2018)'],
      ['Young soot near the burner, another E(m)', '', 'no figure, the table does not include it', 'no figure'],
    ];

const own = ['littin2024sat', 'pinto2026eucalyptus', 'littin2026carbon', 'yap2026dual'].map((id) => byId(id)).filter((p) => p !== undefined);
const other: string[] = [
  'F. Escudero, V. Chernov, J. J. Cruz, E. Magaña, B. Herrmann, A. Fuentes, Robust automatic retrieval of soot volume fraction, temperature and radiation for axisymmetric flames. <em>Proceedings of the Combustion Institute</em> <strong>40</strong>, 105493 (2024). ANNAbel. <a href="https://doi.org/10.1016/j.proci.2024.105493">doi:10.1016/j.proci.2024.105493</a>.',
  'J. Yon, R. Lemaire, E. Therssen, P. Desgroux, A. Coppalle, K. F. Ren, Examination of wavelength dependent soot optical properties of diesel and diesel/rapeseed methyl ester mixture by extinction spectra analysis and LII measurements. <em>Applied Physics B</em> <strong>104</strong>, 253–271 (2011). <a href="https://doi.org/10.1007/s00340-011-4416-4">doi:10.1007/s00340-011-4416-4</a>.',
  'J. Yon, J. J. Cruz, F. Escudero, J. Morán, F. Liu, A. Fuentes, Revealing soot maturity based on multi-wavelength absorption/emission measurements in laminar axisymmetric coflow ethylene diffusion flames. <em>Combustion and Flame</em> <strong>227</strong>, 147–161 (2021). <a href="https://doi.org/10.1016/j.combustflame.2020.12.049">doi:10.1016/j.combustflame.2020.12.049</a>.',
  'F. Liu, J. Yon, A. Fuentes, P. Lobo, G. J. Smallwood, J. C. Corbin, Review of recent literature on the light absorption properties of black carbon: refractive index, mass absorption cross section, and absorption function. <em>Aerosol Science and Technology</em> <strong>54</strong>, 33–51 (2020). <a href="https://doi.org/10.1080/02786826.2019.1676878">doi:10.1080/02786826.2019.1676878</a>.',
  'F. Liu, K. A. Thomson, G. J. Smallwood, Soot temperature and volume fraction retrieval from spectrally resolved flame emission measurement in laminar axisymmetric coflow diffusion flames: effect of self-absorption. <em>Combustion and Flame</em> <strong>160</strong>, 1693–1705 (2013).',
  'K. J. Daun, K. A. Thomson, F. Liu, G. J. Smallwood, Deconvolution of axisymmetric flame properties using Tikhonov regularization. <em>Applied Optics</em> <strong>45</strong>, 4638–4646 (2006). <a href="https://doi.org/10.1364/AO.45.004638">doi:10.1364/AO.45.004638</a>.',
  'C. J. Dasch, One-dimensional tomography: a comparison of Abel, onion-peeling, and filtered backprojection methods. <em>Applied Optics</em> <strong>31</strong>, 1146–1152 (1992).',
  'M. F. Modest, <em>Radiative Heat Transfer</em>, 3rd ed. Academic Press (2013).',
  'C. M. Sorensen, J. Yon, F. Liu, J. Maughan, W. R. Heinson, M. J. Berg, Light scattering and absorption by fractal aggregates including soot. <em>Journal of Quantitative Spectroscopy and Radiative Transfer</em> <strong>217</strong>, 459–473 (2018). <a href="https://doi.org/10.1016/j.jqsrt.2018.05.016">doi:10.1016/j.jqsrt.2018.05.016</a>.',
  'E. Magaña, V. Chernov, J. J. Cruz, B. Herrmann, G. Carvajal, A. Fuentes, F. Escudero, Retrieving soot volume fraction and temperature from broadband flame emission measurements via artificial-neural-network-based Abel inversion. <em>Case Studies in Thermal Engineering</em> <strong>76</strong>, 107396 (2025). RGB-ANNAbel. <a href="https://doi.org/10.1016/j.csite.2025.107396">doi:10.1016/j.csite.2025.107396</a>.',
  'Basler AG, a2A1920-160ucPRO documentation. <a href="https://docs.baslerweb.com/a2a1920-160ucpro">docs.baslerweb.com/a2a1920-160ucpro</a>.',
];
---
<Base title={T.title + (es ? ' · Pirometría RGB' : ' · RGB pyrometry')} description={T.lede} math>
  <header class="page-head frame">
    <p class="eyebrow"><a href={localized(WS, lang)}>{es ? 'Pirometría RGB' : 'RGB pyrometry'}</a> · Metrology in Fire Science · {es ? 'workshop en la' : 'workshop at'} Universidad Adolfo Ibáñez</p>
    <h1>{T.title}</h1>
    <p class="abstract" set:html={tx(T.lede)} />
    <WorkshopNav lang={lang} current="equations" />
  </header>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[0]}</h2>
    <div class="prose"><p set:html={tx(T.planck)} /><Equation tex={eq.planck} label="(1)" /></div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[1]}</h2>
    <div class="prose">
      <p set:html={tx(T.emis)} /><Equation tex={eq.emis} label="(2)" />
      <p set:html={tx(T.em)} /><Equation tex={eq.em} label="(3)" />
    </div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[2]}</h2>
    <div class="prose"><Equation tex={eq.signal} label="(4)" /><p set:html={tx(T.signal)} /></div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[3]}</h2>
    <div class="prose"><Equation tex={eq.oven} label="(5)" /><p set:html={tx(T.oven)} /><p set:html={tx(T.ovenNote)} /><p set:html={tx(T.tail)} /></div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[4]}</h2>
    <div class="prose">
      <p set:html={tx(T.proj)} />
      <Equation tex={eq.proj} label="(6)" />
      <Equation tex={eq.abel} label="(7)" />
      <p set:html={tx(T.disc)} />
      <Equation tex={eq.disc} label="(8)" />
    </div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[5]}</h2>
    <div class="prose">
      <p set:html={tx(T.band)} /><Equation tex={eq.band} label="(9)" />
      <p set:html={tx(T.ratio)} /><Equation tex={eq.ratio} label="(10)" />
    </div>
  </div></section>

  <section class="section frame" id="rgb-annabel"><div class="row">
    <h2 class="label row__label">{T.netTitle}</h2>
    <div class="prose"><p set:html={tx(T.net)} /><Equation tex={eq.net2} label="(11)" /><Equation tex={eq.net} label="(12)" /><p set:html={tx(T.netNote)} /></div>
  </div></section>

  <section class="section frame"><div class="row">
    <h2 class="label row__label">{T.s[6]}</h2>
    <div class="prose"><ol>{T.steps.map((s) => <li set:html={tx(s)} />)}</ol><p set:html={tx(T.stepsNote)} /></div>
  </div></section>

  <section class="section frame" id="budget"><div class="row">
    <h2 class="label row__label">{T.s[7]}</h2>
    <div>
      <p class="prose" set:html={tx(T.budgetIntro)} />
      <p class="prose" id="band-note" set:html={tx(T.bandNote)} />
      <div class="tw">
        <table class="budget">
          <thead><tr>{T.bh.map((h) => <th scope="col" set:html={tx(h)} />)}</tr></thead>
          <tbody>{budget.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row" set:html={tx(c)} /> : <td set:html={tx(c)} />)}</tr>)}</tbody>
        </table>
      </div>
      <div class="prose after"><p set:html={tx(T.chain)} /><p set:html={tx(T.grid)} /></div>
    </div>
  </div></section>

  <section class="section frame refs"><div class="row">
    <h2 class="label row__label">{T.s[8]}</h2>
    <div>
      <h3>{T.refsOwn}</h3>
      {own.map((p) => <PubItem pub={p} compact lang={lang} />)}
      <h3>{T.refsOther}</h3>
      {other.map((r) => <p class="ref" set:html={r} />)}
    </div>
  </div></section>
</Base>

<style>
  .tw { overflow-x: auto; margin-top: var(--s-3); }
  .budget th, .budget td { padding: 0.35em 0.7em 0.35em 0; text-align: left; vertical-align: top; }
  .budget thead th { border-bottom: 1px solid var(--ink); font-weight: 600; }
  .budget tbody th { font-weight: 400; }
  .budget tbody tr + tr > * { border-top: 1px solid var(--rule); }
  .after { margin-top: var(--s-4); }
  .refs h3 { margin-top: var(--s-4); font-size: var(--step-0); }
  .ref { position: relative; padding-left: 2.6em; margin-top: var(--s-3); counter-increment: bib; text-align: left; }
  .ref::before { content: '[' counter(bib) ']'; position: absolute; left: 0; top: 0; }
</style>
