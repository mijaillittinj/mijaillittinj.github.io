---
/**
 * Landing page of the animated talk given at the Congreso de Mecánica Computacional 2026.
 * The decks themselves are static Manim Slides exports copied into
 * public/talks/cmc-2026/deck-es/ and deck-en/ (see scripts/import-talk.sh).
 */
import Base from '../../layouts/Base.astro';
import { byId } from '../../data/publications';
import { url, localized } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const paper = byId('yap2026dual');
const T = es
  ? {
      title: '¿Dónde se forma y dónde se destruye el hollín?',
      eyebrow: 'Charla · Congreso de Mecánica Computacional 2026',
      sub: 'Del campo de hollín medido al término fuente de los modelos',
      abstract: 'Las simulaciones de combustión predicen el hollín con una ecuación de transporte cuyo cierre es el término fuente, la tasa a la que el hollín se forma o se destruye. La charla muestra cómo mediciones de emisión y extinción en dos longitudes de onda, invertidas con una red neuronal, entregan la fracción volumétrica, la temperatura y la madurez del hollín en una llama normal y en una llama inversa. Leída al revés, la ecuación de transporte convierte esos campos en el término fuente local, que es la cantidad que predicen los modelos. La última parte presenta la calibración de un modelo de hollín de dos ecuaciones frente a ese objetivo, un trabajo todavía en curso.',
      openEs: 'Abrir la presentación en español', openEn: 'Open the presentation in English',
      howH: 'Cómo verla',
      how: 'Es una presentación animada. Las flechas o la barra espaciadora avanzan, la tecla F activa la pantalla completa y la tecla S abre la vista de orador con las notas. El reproductor necesita conexión a internet y funciona mejor en un computador.',
      basedH: 'Artículo',
      based: 'La charla se basa en el artículo publicado en Proceedings of the Combustion Institute. Los resultados de la calibración que aparecen al final son preliminares.',
      back: 'Publicaciones',
    }
  : {
      title: 'Where is soot formed and where is it destroyed?',
      eyebrow: 'Talk · Congreso de Mecánica Computacional 2026',
      sub: 'From the measured soot field to the source term of the models',
      abstract: 'Combustion simulations predict soot with a transport equation whose closure is the source term, the rate at which soot is formed or destroyed. The talk shows how emission and extinction measurements at two wavelengths, inverted with a neural network, give the soot volume fraction, temperature and maturity in a normal and an inverse flame. Read backwards, the transport equation turns these fields into the local source term, which is the quantity the models predict. The last part presents the calibration of a two-equation soot model against that target, work that is still in progress.',
      openEs: 'Abrir la presentación en español', openEn: 'Open the presentation in English',
      howH: 'How to view it',
      how: 'This is an animated presentation. The arrow keys or the space bar move forward, F turns on full screen and S opens the speaker view with the notes. The player needs an internet connection and works best on a computer.',
      basedH: 'Paper',
      based: 'The talk is based on the paper published in Proceedings of the Combustion Institute. The calibration results shown at the end are preliminary.',
      back: 'Publications',
    };
const authors = ['V. Yap', 'J. Gallardo', 'M. Littin', 'F. Escudero', 'J. Yon', 'A. Fuentes', 'R. Demarco'];
---
<Base title={T.title} description={T.abstract}>
  <header class="page-head frame">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.title}</h1>
    <p class="tk-sub"><em>{T.sub}</em></p>
    <p class="meta tk-auth">{authors.map((a, i) => <>{i > 0 && ', '}{a === 'M. Littin' ? <span class="me">{a}</span> : a}</>)}</p>
    <p class="abstract">{T.abstract}</p>
    <p class="tk-open">
      <a class="btn" href={url(es ? '/talks/cmc-2026/deck-es/' : '/talks/cmc-2026/deck-en/')}>{es ? T.openEs : T.openEn}</a>
      <a class="btn" href={url(es ? '/talks/cmc-2026/deck-en/' : '/talks/cmc-2026/deck-es/')}>{es ? T.openEn : T.openEs}</a>
    </p>
  </header>

  <section class="section frame">
    <div class="row">
      <h2 class="row__label nonum">{T.howH}</h2>
      <p class="prose">{T.how}</p>
    </div>
  </section>

  {paper && (
    <section class="section frame">
      <div class="row">
        <h2 class="row__label nonum">{T.basedH}</h2>
        <div class="prose">
          <p>{T.based}</p>
          <p>{paper.authors.join(', ')}. <em>{paper.title}.</em> {paper.journal} {paper.volume}, {paper.article} ({paper.year}). <a href={`https://doi.org/${paper.doi}`}>doi:{paper.doi}</a></p>
          <p><a class="more" href={localized('/publications/', lang)}>{T.back}</a></p>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .tk-sub { margin-top: var(--s-3); font-size: var(--step-0); }
  .tk-auth { margin-top: var(--s-2); }
  .tk-auth .me { font-variant: small-caps; font-family: var(--font-caps); text-transform: lowercase; font-size: 1.05em; color: var(--ink); }
  .tk-open { margin-top: var(--s-5); display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4em 1.4em; font-size: var(--step-0); }
</style>
