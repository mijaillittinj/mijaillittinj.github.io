---
/**
 * Example data of the RGB pyrometry workshop. Spec: manim/WEB_SPEC.md §3.5.
 * Files, sizes and SHA-256 come from src/data/workshop-rgb-samples.json, written by
 * manim/tools/make_web_samples.py together with the zips in public/teaching/workshop-rgb-pyrometry/files/.
 */
import Base from '../../layouts/Base.astro';
import WorkshopNav from '../workshop-rgb/WorkshopNav.astro';
import { url, localized } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { WS, FILES, LOG_TEMPLATE, has, ck, ckCond, sample, sampleTotal, mb, tx, tailTable } from '../../data/workshop-rgb';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const k = (key: string) => ck(key, lang);
const oven = sample('horno_ejemplo.zip');
const sept = sample('llama_septiembre_2026.zip');
const syn = sample('llama_sintetica_coflame.zip');
const tool = has.tool ? localized(`${WS}tool/`, lang) : undefined;

const T = es
  ? {
      title: 'Datos de ejemplo',
      lede: `Tres juegos de imágenes para usar la herramienta sin haber ido al laboratorio. Un horno real, una llama real de septiembre de 2026 y una llama sintética con sus valores verdaderos de T y f_s. Cada juego es un archivo .zip con un LEEME.txt que explica qué trae. En total pesan ${mb(sampleTotal, lang)}.`,
      table: 'Archivos',
      head: ['Juego', 'Cámara', 'Imágenes', 'Tamaño'],
      names: { oven: 'Horno real', sept: 'Llama real de septiembre de 2026', syn: 'Llama sintética de coflujo' },
      synCam: 'simulada',
      sha: 'Para comprobar que la descarga llegó completa, comparen el SHA-256 que aparece bajo cada juego con el que da shasum -a 256 en macOS o certutil -hashfile … SHA256 en Windows.',
      useH: 'Con qué se calibra cada juego',
      useHead: ['Juego', 'Se calibra con', 'Llega hasta'],
      use: [['Horno real', 'su propio horno', 'la etapa 2. Con las curvas nominales la prueba de la razón falla, y con la cola infrarroja calibrada pasa'], ['Llama real de septiembre de 2026', 'la esfera integradora del mismo juego, o la calibración de ANNAbel convertida', 'los mapas de T y f_s, con f_s provisional'], ['Llama sintética de coflujo', 'el horno sintético del mismo juego', 'los mapas de T y f_s, que se comparan con los valores verdaderos']],
      template: 'Plantilla vacía del registro de adquisición',
      ovenH: 'Horno real',
      ovenP: [
        'Fotos del horno de cuerpo negro del grupo tomadas con la cámara a2A1920-160ucPRO, la misma del laboratorio. Cuatro temperaturas de termopar, 800, 900, 1000 y 1050 °C, con cinco tiempos de exposición cada una, en carpetas <T>C/ con archivos <t_exp>exp.tiff. Son recortes alrededor de la abertura hechos por el equipo del workshop, con el mismo origen en el sensor para las cuatro series, y recorte.json guarda ese origen. Los valores de los píxeles no cambian. No hay oscuros, así que el nivel oscuro se estima en las esquinas del recorte. La herramienta marca algunos píxeles calientes del sensor, bajo 0,1 % de los píxeles de trabajo, y los reemplaza por la mediana de sus vecinos. Es normal en un sensor sano y no mueve la meseta. La prueba de la razón da unos pocos kelvin distinto de la presentación, porque la herramienta mide su propia meseta y quita esos píxeles.',
        `Con las curvas nominales de la cámara este horno no cumple el modelo. K_R/K_G cambia ${k('oven_KRKG_drift')} entre 800 y 1050 °C y la prueba de la razón falla por cientos de kelvin. La matriz de color de pylon estaba apagada en estas fotos, y la causa principal es la respuesta de la cámara sobre 700 nm. La tabla de abajo da qué parte de la señal viene de ahí, que es mucho mayor en el horno que en una llama.`,
        `Por eso la herramienta calibra esa cola con el mismo horno. La idea es simple. Busca cuánto pesa de verdad la curva del rojo sobre 700 nm, un factor s_R que la multiplica, hasta que las cuatro temperaturas dan el mismo K_R/K_G. Con estas fotos s_R da ${k('oven_tail_scale_R')} ${ckCond('oven_tail_scale_R', 'es')}. Después deja fuera una temperatura cada vez, ajusta con las otras y mide K_R/K_G en la que quedó fuera. La diferencia llega a ${k('oven_tailcal_loo_KRKG')} como máximo, bajo el criterio de 1 %, así que la calibración pasa. Sin corregir, la T de una llama saldría ${k('oven_dT_flame_top')} respecto de la real. Con la cola calibrada queda un sesgo residual esperado ${k('oven_tailcal_dT_flame')}, ${ckCond('oven_tailcal_dT_flame', 'es')}, que no se resta. El azul no pasa la prueba y queda fuera de T y de f_s. En el laboratorio no hay filtro de paso corto y no hace falta.`,
      ],
      ovenWalk: 'Recorrido. Cargar el juego en la calibración con horno y llegar hasta el estado de la calibración. En 1a.7 la herramienta muestra la prueba de la razón con las curvas nominales, que no pasa, y debajo la calibración de la cola infrarroja con la misma prueba antes y después, dejando fuera una temperatura cada vez. La herramienta lee la cola igual que la presentación (tools/calibration.py, media en un disco común a las cuatro temperaturas y saturación por canal). Con las 51 imágenes del horno da las cifras de la presentación, s_R = 0,117 ± 0,022, K_R/K_G = 1,0458, deriva corregida −0,26 % y 0,39 % como máximo con una temperatura fuera (800 °C fuera, −0,02 %), así que pasa. Este juego trae 20 de esas 51 imágenes y da s_R = 0,120 ± 0,022 y 0,69 % como máximo (800 °C fuera, −0,39 %), también pasa. La diferencia es de imágenes, no de cálculo. Sirve para practicar la carga, la meseta, el ajuste y la calibración de la cola. El juego no trae llama.',
      septH: 'Llama real de septiembre de 2026',
      septP: [
        'Cuatro cuadros y un fondo de una llama de la campaña de septiembre de 2026, con la esfera integradora de la misma cámara (imagen, oscuro y espectro de la lámpara). La cámara es una acA2040-55uc, distinta de la del laboratorio, así que esta llama no se calibra con el horno de ejemplo. La herramienta lo detecta por el tamaño del sensor.',
        'Las imágenes de la llama se guardaron de nuevo con el visor de fotos de Windows antes de llegar al workshop y quedaron giradas 90° respecto del sensor. La herramienta avisa que otro programa guardó los archivos, y aquí eso es esperado. Los nombres 0s a 30s son el instante de la toma y no el tiempo de exposición.',
        'Dos datos no quedaron registrados. El tiempo de exposición de la llama no se anotó, y la app del grupo usa 1000 µs como valor provisional. La escala de 0,0312 mm por píxel no está confirmada. T no depende de ninguno de los dos, y f_s cambia en proporción inversa a ambos, así que f_s queda rotulada como provisional. En la imagen de la esfera el canal verde está cerca del techo en parte del disco. Los píxeles que se ven saturados también en el oscuro son píxeles calientes del sensor.',
        'Qué esperar. Con el camino recomendado y el instante 0s.tiff, la herramienta 2026.2 dio T mediana de 1664 K, con percentiles 5 y 95 de 1552 y 1995 K, y f_s mediana de 3,5 ppm con percentil 95 de 12,9 ppm, provisional. Los mapas salen moteados, con píxeles vecinos que difieren unos 200 K. Es un solo instante, con una asimetría de 0,30 y una diferencia entre mitades de 21 % del pico, sobre el 10 % que la herramienta da como límite. Cerca del eje, a menos de 0,5 mm, y en la base, donde aparece la quimioluminiscencia, los valores no son confiables. La curva L de este juego no tiene esquina clara y la herramienta lo avisa. Subir λ<sub>rel</sub> a 10⁻² baja la diferencia entre vecinos a unos 150 K y deja la mediana en 1661 K. La herramienta también avisa de píxeles sueltos de f_s muy sobre el resto cerca del eje. Lean la mediana y los percentiles, no el máximo.',
      ],
      septWalk: 'Recorrido. Calibrar con la esfera, con la unidad W m⁻² sr⁻¹ µm⁻¹ y el filtro neutro de densidad óptica 0,4 que dice el LEEME. En la etapa 3 escribir t_exp = 1000 µs y la escala de 0,0312 mm por píxel. En Geometría y escala poner «90° a la derecha» en los dos selectores, «Posición del sensor» y «Girar para dejar la llama vertical». El primero solo ubica la imagen sobre el sensor para la calibración y no cambia la vista previa. El segundo pone la llama de pie, con el quemador abajo. La base es la parte ancha y tenue, y la punta, angosta, queda arriba. En «Los nombres traen tiempos de adquisición» dejar «instantes distintos, se usa uno» con 0s.tiff. Los cuatro cuadros son instantes distintos y la llama se movió entre ellos, el eje cambia unos 92 píxeles, así que con «repeticiones» la herramienta descarta tres de los cuatro. La curva de esta cámara viene con el corte infrarrojo efectivo de 630 nm y 12 nm de ancho, el que usa la app del grupo con ella, porque la curva no trae el filtro infrarrojo de la montura. No hay que cambiarlo. Revisar la vista previa y marcar «Confirmo que en la vista previa el quemador queda abajo». Después el camino recomendado lleva hasta los mapas de T y f_s. El juego trae también convertir_calibracion_annabel.py, que pasa una calibración de la app ANNAbel al .json de la etapa 1c.',
      synH: 'Llama sintética de coflujo con sus valores verdaderos',
      synP: [
        'Las imágenes salen de una simulación CoFlame de una llama laminar de coflujo con hollín, proyectada con atenuación por la línea de visión, con un desenfoque leve y con ruido de cámara, y guardada en 12 bits. Trae un horno sintético hecho con las mismas curvas de cámara, con sus oscuros, y los valores verdaderos de T(r, z) y f_s(r, z) en verdad_T_fs.csv.',
        `La llama viene en cuadros sueltos y como el promedio de ${k('n_frames_rec')} cuadros. Con cuatro cuadros el error fue ${k('chain_T_rms_N4')} en T y ${k('chain_fs_rms_N4')} en f_s, en media cuadrática, con píxeles sueltos de f_s muy sobre el resto cerca del eje. Con pocos cuadros f_s es la cifra frágil. Con el promedio, ${k('chain_method')} y la máscara de ${k('mask_thr_pct')} de la señal, el error fue ${k('chain_T_rms')} en T y ${k('chain_fs_rms')} en f_s, dentro de las tolerancias de ${k('chain_T_tol')} y ${k('chain_fs_tol')} fijadas de antemano.`,
        'Cómo se calculan esas cifras, para que ustedes las repitan. Se leen verdad_T_fs.csv y el CSV con punto decimal de la herramienta. La verdad se interpola en forma lineal en z y r sobre la malla de la herramienta, repitiendo en r = 0 el valor de la primera columna. El error de T es la raíz del promedio de (T − T verdadera)² en los píxeles con el bit 1 de mask_bits. El de f_s es la raíz del promedio de (f_s / f_s verdadera − 1)², en porcentaje, en esos mismos píxeles donde la f_s verdadera pasa el 5 % de su máximo. Las dos mallas no coinciden, así que hay que interpolar, y sin la altura correcta de la última fila los mapas quedan corridos en z. El CSV de la herramienta empieza con líneas de comentario que comienzan con #. Hay que saltarlas, por ejemplo con pandas.read_csv(archivo, comment=\'#\'). El juego trae comparar_con_verdad.py, que hace este cálculo solo con numpy, python comparar_con_verdad.py resultados_punto_<fecha>.csv.',
        'El horno sintético usa tiempos de exposición más largos que los 208 µs de la llama, y la herramienta avisa que el t_exp de la llama queda fuera del horno. La cámara sintética es lineal por construcción, así que en este juego el aviso no cambia el resultado. Con una cámara real la guía pide que el horno cubra el t_exp de la llama.',
      ],
      synWalk: 'Recorrido. El botón del juego en la herramienta deja la etapa 3 lista con los valores del LEEME, t_exp de 208 µs y escala de 0,05 mm por píxel confirmados y 5,05 mm en «Altura de esa fila», que es la altura sobre el quemador de la última fila de trabajo con el superpíxel de 2 × 2. Si cargan el .zip desde el disco, escriban esos valores a mano. La herramienta toma sola el promedio de la llama y el promedio del fondo. El aviso de que el t_exp de la llama queda fuera del horno es esperado en este juego, porque la cámara sintética es lineal. Revisen la vista previa, marquen «Confirmo que en la vista previa el quemador queda abajo» y usen el camino recomendado, que calcula el ajuste del horno y hace los seis pasos hasta T y f_s. Si la etapa 4 dice que en algunas alturas el residuo pasa tres veces el ruido, en este juego se puede seguir.',
      walk: 'Abrir la herramienta',
      download: 'Descargar',
    }
  : {
      title: 'Example data',
      lede: `Three image sets for using the tool without having been to the lab. A real oven, a real flame from September 2026 and a synthetic flame with its ground truth T and f_s. Each set is a .zip file with a LEEME.txt (the README, in Spanish and English) that explains what it holds. Together they weigh ${mb(sampleTotal, lang)}.`,
      table: 'Files',
      head: ['Set', 'Camera', 'Images', 'Size'],
      names: { oven: 'Real oven', sept: 'Real flame, September 2026', syn: 'Synthetic coflow flame' },
      synCam: 'simulated',
      sha: 'To check that a download arrived complete, compare the SHA-256 shown under each set with the one given by shasum -a 256 on macOS or certutil -hashfile … SHA256 on Windows.',
      useH: 'What each set is calibrated with',
      useHead: ['Set', 'Calibrated with', 'Goes as far as'],
      use: [['Real oven', 'its own oven', 'stage 2. With the nominal curves the ratio test fails, and with the infrared tail calibrated it passes'], ['Real flame, September 2026', 'the integrating sphere of the same set, or the converted ANNAbel calibration', 'the maps of T and f_s, with a provisional f_s'], ['Synthetic coflow flame', 'the synthetic oven of the same set', 'the maps of T and f_s, compared with the ground truth']],
      template: 'Empty acquisition log template',
      ovenH: 'Real oven',
      ovenP: [
        'Photographs of the group’s blackbody oven taken with the a2A1920-160ucPRO camera, the same as in the lab. Four thermocouple temperatures, 800, 900, 1000 and 1050 °C, with five exposure times each, in folders <T>C/ holding files <t_exp>exp.tiff. They are crops around the aperture made by the workshop team, with the same sensor origin for the four series, and recorte.json stores that origin. Pixel values are unchanged. There are no dark frames, so the dark level is estimated in the corners of the crop. The tool marks a few hot sensor pixels, under 0.1 % of the working pixels, and replaces them by the median of their neighbours. That is normal for a healthy sensor and does not move the plateau. The ratio test differs from the presentation by a few kelvin, because the tool measures its own plateau and removes those pixels.',
        `With the nominal camera curves this oven does not follow the model. K_R/K_G changes by ${k('oven_KRKG_drift')} between 800 and 1050 °C and the ratio test misses by hundreds of kelvin. The pylon colour matrix was off in these photographs, and the main cause is the camera response above 700 nm. The table below gives the share of the signal that comes from there, which is much larger at the oven than in a flame.`,
        `That is why the tool calibrates that tail with the same oven. The idea is simple. It looks for how much the red curve above 700 nm really weighs, a factor s_R that multiplies it, until the four temperatures give the same K_R/K_G. With these photographs s_R comes out ${k('oven_tail_scale_R')} ${ckCond('oven_tail_scale_R', 'en')}. Then it leaves one temperature out at a time, fits on the others and measures K_R/K_G at the one left out. The difference reaches ${k('oven_tailcal_loo_KRKG')} at most, under the 1 % criterion, so the calibration passes. Without the correction, the T of a flame would come out ${k('oven_dT_flame_top')} off the true value. With the tail calibrated an expected residual bias of ${k('oven_tailcal_dT_flame')} remains, ${ckCond('oven_tailcal_dT_flame', 'en')}, and it is not subtracted. Blue does not pass the test and stays out of T and f_s. The lab has no short-pass filter and does not need one.`,
      ],
      ovenWalk: 'Walk-through. Load the set into the oven calibration and go as far as the calibration status. In 1a.7 the tool shows the ratio test with the nominal curves, which fails, and below it the calibration of the infrared tail with the same test before and after, leaving one temperature out at a time. The tool reads the tail as the presentation does (tools/calibration.py, mean over a disc common to the four temperatures and saturation per channel). With the 51 oven images it gives the figures of the presentation, s_R = 0.117 ± 0.022, K_R/K_G = 1.0458, corrected drift −0.26 % and at most 0.39 % with one temperature left out (800 °C out, −0.02 %), so it passes. This set holds 20 of those 51 images and gives s_R = 0.120 ± 0.022 and at most 0.69 % (800 °C out, −0.39 %), it passes too. The difference is in the images, not in the computation. It is good for practising loading, the plateau, the fit and the tail calibration. The set has no flame.',
      septH: 'Real flame, September 2026',
      septP: [
        'Four frames and a background of a flame from the September 2026 campaign, with the integrating sphere of the same camera (image, dark frame and lamp spectrum). The camera is an acA2040-55uc, a different one from the lab camera, so this flame is not calibrated with the example oven. The tool detects this from the sensor size.',
        'The flame images were saved again by the Windows photo viewer before they reached the workshop and ended up rotated by 90° with respect to the sensor. The tool warns that another program saved the files, and here that is expected. The names 0s to 30s are the time of the shot, not the exposure time.',
        'Two values were not recorded. The flame exposure time was not written down, and the group’s app uses 1000 µs as a provisional value. The scale of 0.0312 mm per pixel is not confirmed. T depends on neither, and f_s changes in inverse proportion to both, so f_s is labelled provisional. In the sphere image the green channel is close to the ceiling in part of the disc. Pixels that also look saturated in the dark frame are hot pixels of the sensor.',
        'What to expect. With the recommended path and the instant 0s.tiff, the tool 2026.2 gave a median T of 1664 K, with 5th and 95th percentiles of 1552 and 1995 K, and a median f_s of 3.5 ppm with a 95th percentile of 12.9 ppm, provisional. The maps come out mottled, with neighbouring pixels about 200 K apart. It is a single instant, with an asymmetry of 0.30 and a difference between halves of 21 % of the peak, above the 10 % the tool gives as its limit. Near the axis, under 0.5 mm, and at the base, where chemiluminescence shows, the values are not reliable. The L-curve of this set has no clear corner and the tool says so. Raising λ<sub>rel</sub> to 10⁻² lowers the difference between neighbours to about 150 K and leaves the median at 1661 K. The tool also warns of single f_s pixels far above the rest near the axis. Read the median and the percentiles, not the maximum.',
      ],
      septWalk: 'Walk-through. Calibrate with the sphere, with the unit W m⁻² sr⁻¹ µm⁻¹ and the neutral density filter of optical density 0.4 given in the LEEME. In stage 3 type t_exp = 1000 µs and the scale of 0.0312 mm per pixel. Under Geometry and scale set “90° clockwise” in both selectors, “Sensor orientation” and “Rotate so the flame stands upright”. The first one only places the image on the sensor for the calibration and does not change the preview. The second one stands the flame up with the burner at the bottom. The base is the wide, dim part and the narrow tip is at the top. Under “The names carry acquisition times” keep “different instants, one is used” with 0s.tiff. The four frames are different instants and the flame moved between them, the axis shifts by about 92 pixels, so with “repeats” the tool discards three of the four. The curve of this camera comes with the effective infrared cut at 630 nm, 12 nm wide, the one the group’s app uses with it, because the curve does not include the infrared filter of the mount. There is no need to change it. Check the preview and tick “I confirm that the burner is at the bottom of the preview”. The recommended path then goes on to the maps of T and f_s. The set also carries convertir_calibracion_annabel.py, which turns a calibration of the ANNAbel app into the .json of stage 1c.',
      synH: 'Synthetic coflow flame with its ground truth',
      synP: [
        'The images come from a CoFlame simulation of a sooting laminar coflow flame, projected with attenuation along the line of sight, with a slight blur and with camera noise, and stored in 12 bits. The set holds a synthetic oven made with the same camera curves, with its dark frames, and the ground truth T(r, z) and f_s(r, z) in verdad_T_fs.csv.',
        `The flame comes as single frames and as the average of ${k('n_frames_rec')} frames. With four frames the root-mean-square error was ${k('chain_T_rms_N4')} in T and ${k('chain_fs_rms_N4')} in f_s, with single f_s pixels far above the rest near the axis. With few frames f_s is the fragile figure. With the average, ${k('chain_method')} and a mask at ${k('mask_thr_pct')} of the signal, the error was ${k('chain_T_rms')} in T and ${k('chain_fs_rms')} in f_s, within the tolerances of ${k('chain_T_tol')} and ${k('chain_fs_tol')} set in advance.`,
        'How those figures are computed, so you can repeat them. Read verdad_T_fs.csv and the tool CSV. Interpolate the ground truth linearly in z and r onto the tool grid, repeating at r = 0 the value of the first column. The error in T is the root mean square of T − true T over the pixels with bit 1 of mask_bits. The error in f_s is the root mean square of f_s / true f_s − 1, in percent, over those same pixels where the true f_s exceeds 5 % of its maximum. The two grids do not coincide, so interpolation is needed, and without the right height of the last row the maps are shifted in z. The tool CSV starts with comment lines that begin with #. Skip them, for example with pandas.read_csv(file, comment=\'#\'). The set carries comparar_con_verdad.py, which does this calculation with numpy only, python comparar_con_verdad.py results_<date>.csv.',
        'The synthetic oven uses longer exposure times than the 208 µs of the flame, and the tool warns that the flame t_exp falls outside the oven. The synthetic camera is linear by construction, so in this set the warning does not change the result. With a real camera the lab guide asks for the oven to cover the flame t_exp.',
      ],
      synWalk: 'Walk-through. The set button in the tool fills stage 3 with the values of the LEEME, t_exp of 208 µs and a scale of 0.05 mm per pixel, both confirmed, and 5.05 mm in “Height of that row”, the height above the burner of the last working row with the 2 × 2 superpixel. If you load the .zip from disk, type those values by hand. The tool picks the averaged flame and the averaged background on its own. The warning that the flame t_exp falls outside the oven is expected in this set, because the synthetic camera is linear. Check the preview, tick “I confirm that the burner is at the bottom of the preview” and use the recommended path, which computes the oven fit and goes through the six steps to T and f_s. If stage 4 says that the residual exceeds three times the noise at some heights, in this set you can go on.',
      walk: 'Open the tool',
      download: 'Download',
    };

const rows = [
  [T.names.oven, oven],
  [T.names.sept, sept],
  [T.names.syn, syn],
] as const;
const tail = tailTable(lang);
const sets = [
  { id: 'horno', h: T.ovenH, ps: T.ovenP, walk: T.ovenWalk, s: oven, table: tail },
  { id: 'septiembre', h: T.septH, ps: T.septP, walk: T.septWalk, s: sept },
  { id: 'sintetica', h: T.synH, ps: T.synP, walk: T.synWalk, s: syn },
];
const nf = (n: number) => String(n);
---
<Base title={T.title + (es ? ' · Pirometría RGB' : ' · RGB pyrometry')} description={T.lede}>
  <header class="page-head frame">
    <p class="eyebrow"><a href={localized(WS, lang)}>{es ? 'Pirometría RGB' : 'RGB pyrometry'}</a> · Metrology in Fire Science · {es ? 'workshop en la' : 'workshop at'} Universidad Adolfo Ibáñez</p>
    <h1>{T.title}</h1>
    <p class="abstract" set:html={tx(T.lede)} />
    <WorkshopNav lang={lang} current="data" />
  </header>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.table}</h2>
      <div class="tw">
        <table>
          <thead><tr>{T.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {rows.map(([name, s]) => (
              <tr>
                <td><a href={url(`${FILES}${s.file}`)} download>{name}</a></td>
                <td>{s.camera === 'sintética' ? T.synCam : s.camera}</td>
                <td>{nf(s.images)} TIFF</td>
                <td class="num">{mb(s.bytes, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta"><a href={url(`${FILES}${LOG_TEMPLATE}`)} download>{LOG_TEMPLATE}</a> · {T.template}</p>
      <h3>{T.useH}</h3>
      <div class="tw">
        <table>
          <thead><tr>{T.useHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{T.use.map((r) => <tr>{r.map((c) => <td set:html={tx(c)} />)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  {sets.map((x) => (
    <section class="section frame" id={x.id}>
      <div class="row">
        <h2 class="label row__label">{x.h}</h2>
        <div class="prose">
          {x.ps.map((p) => <p set:html={tx(p)} />)}
          {'table' in x && x.table && (
            <div class="tw"><table class="small">
              <thead><tr>{x.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{x.table.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td class="num">{c}</td>)}</tr>)}</tbody>
            </table></div>
          )}
          <p><em set:html={tx(x.walk)} /></p>
          <p class="links-line">
            <a class="btn" href={url(`${FILES}${x.s.file}`)} download>{T.download} {x.s.file} ({mb(x.s.bytes, lang)})</a>
            {tool && <> <a class="more" href={tool}>{T.walk}</a></>}
          </p>
          <p class="meta sha">SHA-256 <code>{x.s.sha256}</code></p>
        </div>
      </div>
    </section>
  ))}

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label nonum">SHA-256</h2>
      <p class="prose meta">{T.sha}</p>
    </div>
  </section>
</Base>

<style>
  .tw { overflow-x: auto; }
  .tw table td, .tw table th { padding: 0.35em 0.8em 0.35em 0; text-align: left; vertical-align: top; }
  .tw table th { border-bottom: 1px solid var(--ink); font-weight: 600; }
  .tw table tbody tr + tr td { border-top: 1px solid var(--rule); }
  .tw .num { white-space: nowrap; }
  .sha code { font-family: var(--font-mono); font-size: 0.85em; overflow-wrap: anywhere; }
  .links-line { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: baseline; }
</style>
