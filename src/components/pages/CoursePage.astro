---
/**
 * Course page: ILN223 Diseño y Optimización de Sistemas Térmicos (UTFSM, 2026-2).
 * Content from the course slides and lab brief (see CONTENT_INVENTORY.md). Learning
 * outcomes are written from the course content; the official syllabus should be
 * checked before quoting them as such (CONTENT_QUESTIONS.md).
 */
import Base from '../../layouts/Base.astro';
import { url, localized } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';

const base5 = '/teaching/thermal-systems-design/clase05-ml/';
const T = es
  ? {
      title: 'Diseño y Optimización de Sistemas Térmicos', eyebrow: 'Docencia · ILN223 · UTFSM · 2026-2',
      lede: 'Un curso sobre cómo convertir un sistema térmico real en un modelo que se pueda resolver, verificar y optimizar, y sobre cuándo conviene construir el modelo a partir de datos.',
      about: 'Sobre el curso',
      aboutText: [
        'El curso recorre el ciclo completo del diseño computacional. Se formula un modelo físico, se simplifica con criterio y se resuelve numéricamente. Luego se comprueba que la solución es confiable y se usa para tomar decisiones de diseño mediante optimización. La última unidad introduce el aprendizaje automático como herramienta de modelado basado en datos y lo conecta con los modelos físicos del resto del semestre.',
        'Las clases combinan teoría con demostraciones en Python que los estudiantes pueden modificar. El primer laboratorio parte de un problema concreto de ingeniería, el calentamiento de un transformador eléctrico.',
      ],
      outcomes: 'Al terminar, el estudiante puede',
      outcomesList: [
        'formular el modelo matemático de un sistema térmico y justificar sus simplificaciones (0D o distribuido, estacionario o transitorio) con números adimensionales',
        'resolver el modelo numéricamente, verificar la solución y analizar su sensibilidad a los parámetros',
        'plantear un problema de diseño como optimización, con objetivos y restricciones, y elegir un método de solución adecuado',
        'entender cómo funcionan los métodos de gradiente que se usan también para entrenar redes neuronales',
        'construir y evaluar un modelo basado en datos, y reconocer cuándo conviene imponer la física',
      ],
      units: 'Unidades', unitList: [
        ['1', 'Modelado de sistemas térmicos', 'Propósito de un modelo, leyes físicas, análisis dimensional y teorema Π de Buckingham, modelos concentrados y distribuidos (número de Biot), similitud y ajuste de curvas.', []],
        ['2', 'Modelación numérica y simulación', 'Discretización, estabilidad de esquemas explícitos, verificación de la solución y análisis de sensibilidad.', []],
        ['3', 'Optimización de sistemas térmicos', 'Anatomía de un problema de optimización, convexidad, restricciones y multiplicadores de Lagrange, descenso de gradiente, momentum, métodos estocásticos, Newton y BFGS.', [['Módulo sobre descenso de gradiente', '/learn/optimization/gradient-descent/']]],
        ['4', 'Aprendizaje automático para modelado basado en datos', 'Regresión, redes neuronales y redes informadas por la física, que combinan datos con las ecuaciones del sistema.', [['Módulo sobre aprendizaje informado por la física', '/learn/machine-learning/physics-informed-learning/']]],
      ],
      lectures: 'Clases animadas',
      l5: 'Machine Learning clásico',
      l5Text: 'Dos clases de 40 minutos de la unidad 4. Regresión lineal y ecuaciones normales vistas como optimización y como proyección, regularización Ridge, LASSO y Elastic Net con la geometría que explica los ceros exactos, sobreajuste, validación cruzada, frontera de Pareto entre error y complejidad, regresión logística y PCA. Los ejemplos usan datos sintéticos de un intercambiador, un rodamiento y termocuplas.',
      parts5: ['Regresión y regularización', 'Generalización, clasificación y PCA'],
      salaShort: 'fondo claro',
      how: 'Presentación animada en español. Las flechas o la barra espaciadora avanzan, F activa la pantalla completa, S abre la vista de orador con las notas y O muestra todos los estados.',
      labs: 'Laboratorios computacionales',
      lab1: 'Laboratorio 1. Por qué se sobrecalienta un transformador',
      lab1Text: 'Modelos térmicos de un transformador de distribución, primero concentrado (0D) y luego unidimensional, para explicar cómo puede sobrecalentarse hasta fallar. Los estudiantes comparan una estimación empírica del punto caliente con un modelo espacial resuelto explícitamente, aplicando los modelos concentrados y los submodelos acoplados de la unidad 1.',
      tools: 'Herramientas', toolsText: 'Python (NumPy, SciPy, Matplotlib) en notebooks. La bibliografía principal es Design and Optimization of Thermal Systems, de Y. Jaluria, y Data-Driven Science and Engineering, de S. Brunton y J. N. Kutz.',
      material: 'Material', materialText: 'Las clases animadas publicadas están en esta página. Las demás diapositivas, los apuntes y los notebooks se entregan a los estudiantes inscritos por los canales del curso. Las demostraciones abiertas están en la página de ejemplos interactivos y en la sección Aprender. Las evaluaciones y sus pautas no se publican.',
      back: 'Docencia',
    }
  : {
      title: 'Design and Optimization of Thermal Systems', eyebrow: 'Teaching · ILN223 · UTFSM · 2026-2',
      lede: 'A course on turning a real thermal system into a model that can be solved, verified and optimised, and on when it pays to learn the model from data instead.',
      about: 'About the course',
      aboutText: [
        'The course follows the full cycle of computational design. Students formulate a physical model, simplify it with judgement and solve it numerically. They then check that the solution can be trusted and use it to make design decisions through optimisation. The last unit introduces machine learning as a tool for data-driven modelling and connects it with the physical models of the rest of the semester.',
        'Classes combine theory with Python demonstrations that students can modify. The first laboratory starts from a concrete engineering problem, the heating of an electrical transformer. The course is taught in Spanish.',
      ],
      outcomes: 'By the end, students can',
      outcomesList: [
        'formulate the mathematical model of a thermal system and justify its simplifications (lumped or distributed, steady or transient) with dimensionless numbers',
        'solve the model numerically, verify the solution and analyse its sensitivity to parameters',
        'pose a design problem as an optimisation problem with objectives and constraints, and choose a suitable method to solve it',
        'explain how the gradient methods used to train neural networks work',
        'build and assess a data-driven model, and recognise when physics should be imposed on it',
      ],
      units: 'Units', unitList: [
        ['1', 'Modelling thermal systems', 'Purpose of a model, physical laws, dimensional analysis and the Buckingham Π theorem, lumped and distributed models (Biot number), similarity and curve fitting.', []],
        ['2', 'Numerical modelling and simulation', 'Discretisation, stability of explicit schemes, verification of the solution and sensitivity analysis.', []],
        ['3', 'Optimisation of thermal systems', 'Anatomy of an optimisation problem, convexity, constraints and Lagrange multipliers, gradient descent, momentum, stochastic methods, Newton and BFGS.', [['Module on gradient descent', '/learn/optimization/gradient-descent/']]],
        ['4', 'Machine learning for data-driven modelling', 'Regression, neural networks and physics-informed networks, which combine data with the equations of the system.', [['Module on physics-informed learning', '/learn/machine-learning/physics-informed-learning/']]],
      ],
      lectures: 'Animated lectures',
      l5: 'Classical machine learning (in Spanish)',
      l5Text: 'Two 40-minute lectures from unit 4. Linear regression and the normal equations seen as optimisation and as a projection, Ridge, LASSO and Elastic Net regularisation with the geometry that explains exact zeros, overfitting, cross-validation, the Pareto front between error and complexity, logistic regression and PCA. The examples use synthetic data from a heat exchanger, a bearing and thermocouples.',
      parts5: ['Regression and regularisation', 'Generalisation, classification and PCA'],
      salaShort: 'light background',
      how: 'Animated presentation in Spanish. The arrow keys or the space bar move forward, F turns on full screen, S opens the speaker view with the notes and O shows every state.',
      labs: 'Computational laboratories',
      lab1: 'Lab 1. Why does a transformer overheat?',
      lab1Text: 'Thermal models of a distribution transformer, first lumped (0D) and then one-dimensional, to explain how it can overheat until it fails. Students compare an empirical hot-spot estimate with an explicitly resolved spatial model, applying the lumped models and coupled sub-models of unit 1.',
      tools: 'Tools', toolsText: 'Python (NumPy, SciPy, Matplotlib) in notebooks. The main references are Design and Optimization of Thermal Systems by Y. Jaluria, and Data-Driven Science and Engineering by S. Brunton and J. N. Kutz.',
      material: 'Material', materialText: 'The published animated lectures are on this page. The other slides, notes and notebooks are distributed to enrolled students through the course channels. Open demonstrations are on the interactive examples page and in the Learn section. Assessments and their solutions are not published.',
      back: 'Teaching',
    };
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'Course',
  name: 'Diseño y Optimización de Sistemas Térmicos (ILN223)', courseCode: 'ILN223', inLanguage: 'es',
  description: T.lede,
  provider: { '@type': 'CollegeOrUniversity', name: 'Universidad Técnica Federico Santa María' },
  instructor: { '@type': 'Person', name: 'Mijail Littin' },
}];
---
<Base title={es ? T.title : `${T.title} (ILN223)`} description={T.lede} jsonld={jsonld}>
  <header class="page-head frame">
    <p class="eyebrow"><a href={localized('/teaching/', lang)}>{T.back}</a> · ILN223 · UTFSM · 2026-2</p>
    <h1>{T.title}</h1>
    {!es && <p class="meta orig" lang="es">Diseño y Optimización de Sistemas Térmicos</p>}
    <p class="lede">{T.lede}</p>
  </header>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.about}</h2>
      <div class="prose">{T.aboutText.map((p) => <p>{p}</p>)}
        <h3>{T.outcomes}</h3>
        <ul>{T.outcomesList.map((o) => <li>{o}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.units}</h2>
      <ol class="units">
        {T.unitList.map(([n, t, d, links]) => (
          <li>
            <span class="n">{n}</span>
            <div>
              <h3>{t}</h3>
              <p>{d}</p>
              {(links as string[][]).length > 0 && <ul class="links">{(links as string[][]).map(([l, h]) => <li><a href={url(h)}>{l}</a></li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.lectures}</h2>
      <div>
        <p class="meta">Clase 05 · {es ? 'dos sesiones' : 'two sessions'}</p>
        <h3 class="lec-h">{T.l5}</h3>
        <p class="desc">{T.l5Text}</p>
        <ol class="parts">
          {T.parts5.map((name, i) => (
            <li>
              <a href={url(`${base5}${i + 1}/`)}>{name}</a>
              <span class="meta"> · <a href={url(`${base5}${i + 1}/sala/`)}>{T.salaShort}</a> · <a href={url(`${base5}${i + 1}/clase05_ml_${i + 1}.pdf`)}>PDF</a></span>
            </li>
          ))}
        </ol>
        <p class="meta how">{T.how}</p>
      </div>
    </div>
  </section>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.labs}</h2>
      <div class="prose">
        <h3 class="lab-h">{T.lab1}</h3>
        <p>{T.lab1Text}</p>
      </div>
    </div>
  </section>

  <section class="section frame">
    <div class="row">
      <h2 class="label row__label">{T.tools}</h2>
      <div class="prose">
        <p>{T.toolsText}</p>
        <h3>{T.material}</h3>
        <p>{T.materialText}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .orig { font-style: italic; margin-top: var(--s-2); }
  .units { list-style: none; padding: 0; }
  .units > li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--s-4); padding-block: var(--s-4); border-top: 1px solid var(--rule); }
  .units > li:first-child { border-top: 0; padding-top: 0; }
  .n { font-family: var(--font-sans); font-size: var(--step-1); color: var(--ink-3); }
  .units h3 { font-size: var(--step-1); }
  .units p { margin-top: var(--s-1); color: var(--ink-2); max-width: 44rem; }
  .units .links { margin-top: var(--s-2); }
  .lab-h { margin-top: 0 !important; }
  .lec-h { font-size: var(--step-2); margin-top: var(--s-1); }
  .desc { margin-top: var(--s-2); color: var(--ink-2); max-width: 44rem; }
  .parts { margin: var(--s-3) 0 0; padding-left: 1.2em; }
  .parts li { margin-top: var(--s-1); }
  .how { margin-top: var(--s-4); max-width: 44rem; }
</style>
